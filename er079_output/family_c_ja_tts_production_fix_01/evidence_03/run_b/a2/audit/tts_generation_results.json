    "story_009": {
      "status": "OK",
      "path": "C:\\Users\\tensh\\eigo-radio\\er079_output\\family_c_ja_tts_production_fix_01\\evidence_03\\run_b/a2/audio/story_009.wav",
      "sha256": "9819e441f309f7ec1ca942a5b9499f8bc15fab72f715a198b872c3c5f2b21fb7",
      "canonical_text": "Lena touched the silver box. She could stop the memory. She could send it away again. The screen offered a new date. Her hand shook above it. If she delayed the pain again, would that be healing? Or would she only be leaving a frightened part of herself alone in a dark room?",
      "disfluency_checked": true,
      "reused": true,
      "asr_text": "Lena touched the silver box. She could stop the memory. She could send it away again. The screen offered a new date. Her hand shook above it. If she delayed the pain again, would that be healing? Or would she only be leaving a frightened part of herself alone in a dark room?"
    },
    "story_010": {
      "status": "OK",
      "path": "C:\\Users\\tensh\\eigo-radio\\er079_output\\family_c_ja_tts_production_fix_01\\evidence_03\\run_b/a2/audio/story_010.wav",
      "sha256": "3ccd39d7d19708b3238b148f2bfede9fba0b1b562e803b4d9803d457127cf827",
      "canonical_text": "Lena did not press the button. She stayed on the floor and listened to the rain. She listened to her brother's last words. She listened to the woman she had been before the memory disappeared. That woman had not been healed. But she had known the way back. Lena closed her eyes. The pain was still there. So was the love. For the first time, she let both remain.",
      "disfluency_checked": true,
      "reused": true,
      "asr_text": "Lina did not press the button. She stayed on the floor and listened to the rain. She listened to her brother's last words. She listened to the woman she had been before the memory disappeared. That woman had not been healed, but she had known the way back. Lina closed her eyes. The pain was still there. So was the love. For the first time, she let both remain."
    },

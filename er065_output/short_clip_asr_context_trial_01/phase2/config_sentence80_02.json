   "clips": {
    "n_c1": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/a2_narration/full_story_part1_c1_original.wav",
     "text": "Melos called across the hall,",
     "voice": "Aoede",
     "model": "gemini-3.8-flash-lite-tts",
     "role": "narrator"
    },
    "n_c3": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/a2_narration/full_story_part1_c3_original.wav",
     "text": "Silence came, and guards grabbed the young shepherd. The ruler ordered his death.",
     "voice": "Aoede",
     "model": "gemini-3.8-flash-lite-tts",
     "role": "narrator"
    },
    "n_c7": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/a2_narration/full_story_part1_c7_original.wav",
     "text": "The ruler smiled and said,",
     "voice": "Aoede",
     "model": "gemini-3.8-flash-lite-tts",
     "role": "narrator"
    },
    "n_c9": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/a2_narration/full_story_part1_c9_original.wav",
     "text": "Melos turned to his friend, who offered his hands for the chains. Melos had no time to speak.",
     "voice": "Aoede",
     "model": "gemini-3.8-flash-lite-tts",
     "role": "narrator"
    },
    "n_c11": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/a2_narration/full_story_part1_c11_original.wav",
     "text": "At the wedding, his sister's laugh rose above everyone's voices. Melos listened closely to remember its exact sound. He left for the city before daylight on day three.",
     "voice": "Aoede",
     "model": "gemini-3.8-flash-lite-tts",
     "role": "narrator"
    },
    "n_p3c1": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/a2_narration/full_story_part3_c1_original.wav",
     "text": "He remembered the hands held out for the chains. His friend trusted him without asking for another promise. Water came slowly through a crack in the rock. Melos drank, got onto his knees, and stood up. He managed one step, then took another. At the city gates, the bell rang for his friend's death. He raced to the square, where the sword was already raised above his friend.",
     "voice": "Aoede",
     "model": "gemini-3.8-flash-lite-tts",
     "role": "narrator"
    },
    "m_c2": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/a2_narration/full_story_part1_c2_original.wav",
     "text": "You kill men from fear. You never give them a chance to speak.",
     "voice": "Algieba",
     "model": "gemini-2.5-pro-preview-tts",
     "role": "melos"
    },
    "m_c4": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/a2_narration/full_story_part1_c4_original.wav",
     "text": "Give me three days to see my sister's wedding,",
     "voice": "Algieba",
     "model": "gemini-2.5-pro-preview-tts",
     "role": "melos"
    },
    "m_c6": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/a2_narration/full_story_part1_c6_original.wav",
     "text": "Then I will return to you.",
     "voice": "Algieba",
     "model": "gemini-2.5-pro-preview-tts",
     "role": "melos"
    },
    "m_p3c2": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/a2_narration/full_story_part3_c2_original.wav",
     "text": "Stop now! I'm back!",
     "voice": "Algieba",
     "model": "gemini-2.5-pro-preview-tts",
     "role": "melos"
    },
    "m_p3c4": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/a2_narration/full_story_part3_c4_original.wav",
     "text": "I almost left you to die,",
     "voice": "Algieba",
     "model": "gemini-2.5-pro-preview-tts",
     "role": "melos"
    },
    "k_c8": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/a2_narration/full_story_part1_c8_original.wav",
     "text": "Your friend must stay here. Return late, and he will die in your place.",
     "voice": "Charon",
     "model": "gemini-2.5-pro-preview-tts",
     "role": "king"
    },
    "f_c10": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/a2_narration/full_story_part1_c10_original.wav",
     "text": "Go now, because I know you will come back.",
     "voice": "Erinome",
     "model": "gemini-2.5-pro-preview-tts",
     "role": "friend"
    }
   }
  },

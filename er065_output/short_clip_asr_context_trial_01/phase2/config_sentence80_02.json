   "clips": {
    "n_c1": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/b1b_narration/full_story_part1_c1.wav",
     "text": "Melos's voice rang through the hall.",
     "voice": "Aoede",
     "model": "gemini-3.8-flash-lite-tts",
     "role": "narrator"
    },
    "n_c3": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/b1b_narration/full_story_part1_c3.wav",
     "text": "Silence followed. Then the guards seized the young shepherd, and the ruler sentenced him to death.",
     "voice": "Aoede",
     "model": "gemini-3.8-flash-lite-tts",
     "role": "narrator"
    },
    "n_c7": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/b1b_narration/full_story_part1_c7.wav",
     "text": "The ruler smiled.",
     "voice": "Aoede",
     "model": "gemini-3.8-flash-lite-tts",
     "role": "narrator"
    },
    "n_c9": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/b1b_narration/full_story_part1_c9.wav",
     "text": "Melos turned to his friend, but before he could speak, his friend held out his hands for the chains.",
     "voice": "Aoede",
     "model": "gemini-3.8-flash-lite-tts",
     "role": "narrator"
    },
    "n_c11": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/b1b_narration/full_story_part1_c11.wav",
     "text": "At the wedding, his sister's laughter rose above the other voices. Melos listened closely. He wanted to remember exactly how it sounded. Before dawn on the third day, he left for the city.",
     "voice": "Aoede",
     "model": "gemini-3.8-flash-lite-tts",
     "role": "narrator"
    },
    "n_p3c1": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/b1b_narration/full_story_part3_c1.wav",
     "text": "Then he remembered the hands held out for the chains. His friend had trusted him without asking for another promise. Water dripped from a crack in the rock. Melos drank, pushed himself onto his knees, and stood. One step. Another. At the city gates, the execution bell rang. He ran toward the square. Above his friend, the sword was already raised.",
     "voice": "Aoede",
     "model": "gemini-3.8-flash-lite-tts",
     "role": "narrator"
    },
    "m_c2": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/b1b_narration/full_story_part1_c2.wav",
     "text": "You kill men because you fear them. You won't even let them speak.",
     "voice": "Algieba",
     "model": "gemini-2.5-pro-preview-tts",
     "role": "melos"
    },
    "m_c4": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/b1b_narration/full_story_part1_c4.wav",
     "text": "Give me three days,",
     "voice": "Algieba",
     "model": "gemini-2.5-pro-preview-tts",
     "role": "melos"
    },
    "m_c6": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/b1b_narration/full_story_part1_c6.wav",
     "text": "My sister is getting married. Let me see her wedding. I will return.",
     "voice": "Algieba",
     "model": "gemini-2.5-pro-preview-tts",
     "role": "melos"
    },
    "m_p3c2": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/b1b_narration/full_story_part3_c2.wav",
     "text": "Stop! I am here!",
     "voice": "Algieba",
     "model": "gemini-2.5-pro-preview-tts",
     "role": "melos"
    },
    "m_p3c4": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/b1b_narration/full_story_part3_c4.wav",
     "text": "I nearly abandoned you,",
     "voice": "Algieba",
     "model": "gemini-2.5-pro-preview-tts",
     "role": "melos"
    },
    "k_c8": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/b1b_narration/full_story_part1_c8.wav",
     "text": "Your friend will stay here. If you are late, he dies instead.",
     "voice": "Charon",
     "model": "gemini-2.5-pro-preview-tts",
     "role": "king"
    },
    "f_c10": {
     "path": "er065_output/short_clip_asr_context_trial_01/audio_src/b1b_narration/full_story_part1_c10.wav",
     "text": "Go. I know you'll come back.",
     "voice": "Erinome",
     "model": "gemini-2.5-pro-preview-tts",
     "role": "friend"
    }
   }
  }
 },

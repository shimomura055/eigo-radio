    "last_attempts_log": [
      {
        "attempt": 1,
        "status": "OK",
        "asr_text": "At a cafe or restaurant, the bill may end with a question, how much would you like to tip? A screen often shows a few suggested percentages and asks you to pick one. The word recommended sounds helpful, but it can also become the first number in your mind. Before you decide what the service was worth, the screen may have already set a starting point. A 2014 study looked closely at this idea, using more than 13 million credit card transactions in New York City taxis. Around a $15 fare, the recommended tip menu changed suddenly. The researchers used this change in a regression discontinuity design.",
        "instruction_type": "english_style_prefix_wide_margin",
        "audio_classification": "ASR_VALIDATION_UNCERTAIN",
        "length_ok": true,
        "verified": false,

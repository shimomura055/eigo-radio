    "last_attempts_log": [
      {
        "attempt": 1,
        "status": "OK",
        "asr_text": "Passengers who happened to see a menu with higher default tip rates left more money. The menu shown right before payment shaped the final choice. But there was also a warning. When the recommended tip was set too high, some customers did not simply choose a smaller custom amount. They chose zero instead. That makes the tip screen a risky tool. A higher default may increase a tip from some customers. For others, it may turn the whole decision into a refusal. The taxi study shows how suggested numbers can shape a single choice. Similar screens are now common in restaurants and other services, where a different question has emerged: How much social pressure do these screens add?",
        "instruction_type": "english_style_prefix_wide_margin",
        "audio_classification": "NORMALIZED_MATCH",
        "length_ok": true,
        "verified": true,
        "trim_info": {

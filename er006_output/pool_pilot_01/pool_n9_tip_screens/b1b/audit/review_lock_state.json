    "updated_at": "2026-09-01T11:07:22",
    "reason": "status=OKで確定しました。",
    "final_status": "OK",
    "wav_path": "er006_output/pool_pilot_01/pool_n9_tip_screens/b1b/narration/full_story_part1.wav",
    "cumulative_tts_attempts": 1,
    "cumulative_asr_calls": 1,
    "budget_guard_triggered": false,
    "last_attempts_log": [
      {
        "attempt": 1,
        "status": "OK",
        "asr_text": "At checkout, an awkward moment may arrive before payment is finished. The screen offers a few tip rates, with one number shown first. That number can change the question in your mind, from what did I plan to give, to which option should I choose. A peer-reviewed study published in 2014 examined more than 13 million credit card taxi transactions in New York City. Around a $15 fare, the tip menu changed suddenly. At fares just below and just above that price, passengers saw different default tip menus. Passengers who saw the higher suggested rates left more money. In this taxi setting, the screen itself changed the final tip. The first number became a starting point for the decision.",
        "instruction_type": "english_style_prefix_wide_margin",
        "audio_classification": "NORMALIZED_MATCH",
        "length_ok": true,
        "verified": true,
        "trim_info": {
          "raw_duration_seconds": 47.611,
          "raw_leading_silence_seconds": 0.28,
          "raw_trailing_silence_seconds": 0.32,
          "trimmed_duration_seconds": 47.611,
          "leading_margin_retained_seconds": 0.28,
          "trailing_margin_retained_seconds": 0.32
        },
        "disfluency_checked": false,
        "disfluency_evidence": null
      }
    ]
  },
  "full_story_part2": {
    "state": "RESOLVED",
    "canonical_text_sha256": "028030f711c76853cb9fe580b25e0e5d75809b554c88195980770b86a36729f8",
    "language": "en",
    "theme_id": "pool_n9_tip_screens",

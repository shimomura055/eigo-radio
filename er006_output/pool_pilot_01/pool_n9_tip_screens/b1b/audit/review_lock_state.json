    "updated_at": "2026-09-01T11:08:07",
    "reason": "status=OKで確定しました。",
    "final_status": "OK",
    "wav_path": "er006_output/pool_pilot_01/pool_n9_tip_screens/b1b/narration/full_story_part2.wav",
    "cumulative_tts_attempts": 1,
    "cumulative_asr_calls": 1,
    "budget_guard_triggered": false,
    "last_attempts_log": [
      {
        "attempt": 1,
        "status": "OK",
        "asr_text": "But there was a limit. When the suggested rate was too high, some customers did not choose a smaller custom amount. They left no credit card tip at all. A 2022 policy brief describes high suggested tips as a business choice. It says they can increase store revenue while having little measurable effect on customer satisfaction or return visits. That offers one reason a screen may show a number higher than a customer's first plan. Today, digital payment screens can sometimes suggest tips as high as 35%. The small box at the end of a meal is no longer just recording a decision. It is helping shape the decision before it is made.",
        "instruction_type": "english_style_prefix_wide_margin",
        "audio_classification": "NORMALIZED_MATCH",
        "length_ok": true,
        "verified": true,
        "trim_info": {
          "raw_duration_seconds": 47.091,
          "raw_leading_silence_seconds": 0.26,
          "raw_trailing_silence_seconds": 0.36,
          "trimmed_duration_seconds": 47.081,
          "leading_margin_retained_seconds": 0.26,
          "trailing_margin_retained_seconds": 0.35
        },
        "disfluency_checked": false,
        "disfluency_evidence": null
      }
    ]
  },

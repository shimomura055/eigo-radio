    "reason": "status=OKで確定しました。",
    "final_status": "OK",
    "wav_path": "er006_output/pool_pilot_01/pool_n18_notifications_specfix_v2/b1b/narration/point_two.wav",
    "cumulative_tts_attempts": 1,
    "cumulative_asr_calls": 1,
    "budget_guard_triggered": false,
    "last_attempts_log": [
      {
        "attempt": 1,
        "status": "OK",
        "asr_text": "The second experiment did not compare a ringing phone with a silent phone. It compared a powered-off phone on the desk with that phone in another room. Attention scores were about 100 versus 109, and processing speed scores were about 98 versus 109. For work or study, moving the device may address something that muting does not.",

  "full_story_part1": {
    "state": "RESOLVED",
    "canonical_text_sha256": "50d953c37fa55cee43082b49ce7f31714cce7681b1c7af810e19c1a02058a90a",
    "language": "en",
    "theme_id": "pool_n18_notifications_specfix_v2",

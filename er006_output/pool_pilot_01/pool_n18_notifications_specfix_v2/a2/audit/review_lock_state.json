      {
        "attempt": 1,
        "status": "OK",
        "duration_seconds": 40.521,
        "asr_text": "A phone does not need to light up in your hand to change a task. A sound may be enough. In another study, even a silent phone on a desk was linked to lower attention. A 2022 study tested 73 college students. They worked through a letter task. In some trials, they heard a notification sound. In others, they heard a neutral sound. They did not look at or touch a phone. The result was clear: responses were slower during trials with notification sounds. Brain recordings also showed a larger signal after those sounds. This happened even though the students kept working and did not check a screen.",
        "asr_text_length": 598,
        "max_len": 658,
        "substring_ok": null,
        "length_ok": true,
        "phonetic_verdict": null,
        "audio_classification": "EXACT_MATCH",
        "connected_speech_info": null,
        "reading_resolver_info": null,
        "verified": true,
        "disfluency_checked": false,
        "disfluency_evidence": null
      }
    ]
  },
  "full_story_part2": {
    "state": "RESOLVED",
    "canonical_text_sha256": "97db0d15816c4fb14116c2690b6066ee5ef479d35588bb0d1ce453b79bc64c2d",
    "language": "en",
    "theme_id": "pool_n18_notifications_specfix_v2",
    "level": "a2",
    "segment_id": "full_story_part2",
    "updated_at": "2026-09-03T08:47:07",
    "reason": "status=OKで確定しました。",
    "final_status": "OK",
    "wav_path": "er006_output/pool_pilot_01/pool_n18_notifications_specfix_v2/a2/narration/full_story_part2.wav",
    "cumulative_tts_attempts": 2,
    "cumulative_asr_calls": 2,
    "budget_guard_triggered": false,
    "last_attempts_log": [
      {
        "attempt": 1,
        "status": "OK",
        "duration_seconds": 49.141,
        "asr_text": "A second study published in 2023 tested 42 university students. Their phones were powered off and no notifications arrived. The researchers compared a phone on the desk with a phone in another room. Performance was lower when the phone stayed on the desk. The attention score averaged 99.71 on the desk compared with 108.95 when the phone was away. Processing speed was 98.48 on the desk and 108.57 in another room. Together, these studies show two different moments. A notification can affect a person during a task. A phone can also be linked to lower performance without making a sound.",
        "asr_text_length": 589,
        "max_len": 651,
        "substring_ok": null,
        "length_ok": true,
        "phonetic_verdict": null,
        "audio_classification": "NORMALIZED_MATCH",

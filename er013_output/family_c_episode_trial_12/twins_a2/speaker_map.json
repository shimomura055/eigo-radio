      "quote_text": "“Today is your audition,”",
      "attribution_basis": "固定段落indices(TWIN_QUOTE_PARAGRAPH_INDICES/TWIN_DISPLAY_PARAGRAPH_INDICES、Trial-10と同一、変更なし)"
    },
    {
      "segment_id": "story_004",
      "voice": "twin",
      "source_paragraph_indices": [
        3
      ],
      "quote_text": "“You asked me to wake you.”",
      "attribution_basis": "固定段落indices(TWIN_QUOTE_PARAGRAPH_INDICES/TWIN_DISPLAY_PARAGRAPH_INDICES、Trial-10と同一、変更なし)"
    },
    {
      "segment_id": "story_006",
      "voice": "twin",
      "source_paragraph_indices": [
        5
      ],
      "quote_text": "“You did not remember asking.”",
      "attribution_basis": "固定段落indices(TWIN_QUOTE_PARAGRAPH_INDICES/TWIN_DISPLAY_PARAGRAPH_INDICES、Trial-10と同一、変更なし)"
    },
    {
      "segment_id": "story_008",
      "voice": "twin",
      "source_paragraph_indices": [
        11
      ],
      "quote_text": "“I am protecting it.”",
      "attribution_basis": "固定段落indices(TWIN_QUOTE_PARAGRAPH_INDICES/TWIN_DISPLAY_PARAGRAPH_INDICES、Trial-10と同一、変更なし)"
    },
    {
      "segment_id": "story_010",
      "voice": "twin",
      "source_paragraph_indices": [
        13
      ],
      "quote_text": "“From the life you keep pretending to want.”",
      "attribution_basis": "固定段落indices(TWIN_QUOTE_PARAGRAPH_INDICES/TWIN_DISPLAY_PARAGRAPH_INDICES、Trial-10と同一、変更なし)"
    },
    {
      "segment_id": "story_012",
      "voice": "twin",
      "source_paragraph_indices": [
        16
      ],
      "quote_text": "**LET ME TAKE OVER FOR FOUR MINUTES.**",
      "attribution_basis": "固定段落indices(TWIN_QUOTE_PARAGRAPH_INDICES/TWIN_DISPLAY_PARAGRAPH_INDICES、Trial-10と同一、変更なし)"
    },
    {
      "segment_id": "story_014",
      "voice": "twin",
      "source_paragraph_indices": [
        19
      ],
      "quote_text": "“It comes from your memories,”",
      "attribution_basis": "固定段落indices(TWIN_QUOTE_PARAGRAPH_INDICES/TWIN_DISPLAY_PARAGRAPH_INDICES、Trial-10と同一、変更なし)"
    },
    {
      "segment_id": "story_016",
      "voice": "twin",
      "source_paragraph_indices": [
        19
      ],
      "quote_text": "“I only know how to carry it.”",
      "attribution_basis": "固定段落indices(TWIN_QUOTE_PARAGRAPH_INDICES/TWIN_DISPLAY_PARAGRAPH_INDICES、Trial-10と同一、変更なし)"
    },
    {
      "segment_id": "story_018",
      "voice": "twin",
      "source_paragraph_indices": [
        21
      ],
      "quote_text": "“You may fail. Then you may go back to the repair office. You may tell yourself you never really wanted this.”",
      "attribution_basis": "固定段落indices(TWIN_QUOTE_PARAGRAPH_INDICES/TWIN_DISPLAY_PARAGRAPH_INDICES、Trial-10と同一、変更なし)"
    },
    {
      "segment_id": "story_021",
      "voice": "twin",
      "source_paragraph_indices": [
        25
      ],
      "quote_text": "“I know you better than you know yourself. Let me protect the person you are trying to become.”",
      "attribution_basis": "固定段落indices(TWIN_QUOTE_PARAGRAPH_INDICES/TWIN_DISPLAY_PARAGRAPH_INDICES、Trial-10と同一、変更なし)"
    }

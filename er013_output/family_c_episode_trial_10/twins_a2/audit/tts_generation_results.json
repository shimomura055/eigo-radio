      "path": "er013_output/family_c_episode_trial_10/twins_a2/audio/comment_2_ja.wav",
      "sha256": "463fdfae11d22380c8e1083e486e710c0d206ae3f549b0f79b0192c372b92bac",
      "canonical_text": "場面が変わり、マラはオーディション会場の外に立っています。ここから何が起きるのか、少し耳を傾けてください。",
      "disfluency_checked": false,

      "path": "er013_output/family_c_episode_trial_10/twins_b1/audio/story_016.wav",
      "sha256": "7754b713b112d63d5fb86b8b8154ac06b2765d461dfbf5b7e864c463ead2aaa4",
      "canonical_text": "Some of Mara's money had been moved into a music account. Echo had refused extra hours at the repair office. It had also sent an application to the City Music House without asking her.",
      "disfluency_checked": true,
      "reused": true,
      "asr_text": null

      "sha256": "6a9e9a716a43b3fd1ae1d6e84ea64edecf2ba4269d9c20fdc677d486bb1dd18e",
      "canonical_text": "Maya woke a few minutes before the house began speaking to her. Warm air moved gently through the room. The curtains opened to a pale morning, and a clean outfit waited on the chair. She touched the sleeve. Blue again. She could not remember choosing blue.",
      "disfluency_checked": true,
      "reused": true,
      "asr_text": null
    },
    "story_002": {

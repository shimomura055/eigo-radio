    "story_011": {
      "status": "OK",
      "path": "er013_output/family_c_episode_trial_09/home_robots_b1/audio/story_011.wav",
      "sha256": "d10be8778e9c9523e774340e8bb4b474e93822c57bb13ece5e3bf9f1a0a58f39",
      "canonical_text": "In the evening, the house welcomed her with low lights, warm air, and the smell of dinner. A film appeared on the wall. Her shoulders relaxed before she sat down. The robot never pushed her or gave commands. It simply removed one small decision after another, until there was almost nothing left for Maya to decide.",
      "disfluency_checked": true,
      "reused": true,
      "asr_text": null
    },
    "story_012": {
      "status": "OK",

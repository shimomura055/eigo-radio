      "sha256": "0f946bf5f90a8115c14519c9c5e153e1cbcc164e86a44d5b1c99b9055243a845",
      "canonical_text": "Then, on a wet evening, her mother came to the door. Rain shone on her coat. In one hand she carried a small bag.",
      "disfluency_checked": true,
      "reused": true,
      "asr_text": null
    },

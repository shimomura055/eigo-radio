      "path": "er013_output/family_c_episode_trial_09/home_robots_b1/audio/story_002.wav",
      "sha256": "a1488c8290d029145ab6f9d4e655dbd710ecf58558bb03d00379aa7e1aac4cee",
      "canonical_text": "Downstairs, breakfast was ready: sweet rice, fruit, and tea at exactly the temperature she preferred. A short comedy played on the kitchen wall. Maya smiled before she had even watched it. The robot had selected it from thousands of programs because it matched her usual mood.",
      "disfluency_checked": true,
      "reused": true,
      "asr_text": null
    },
    "story_003": {
      "status": "OK",
      "path": "er013_output/family_c_episode_trial_09/home_robots_b1/audio/story_003.wav",
      "sha256": "2b13020b592100f97f8279d3a4b05398764b862d721f6bafa627f60d987716f3",
      "canonical_text": "\"Good morning. Your day is prepared,\"",
      "disfluency_checked": true,
      "reused": true,
      "asr_text": null
    },
    "story_004": {
      "status": "OK",
      "path": "er013_output/family_c_episode_trial_09/home_robots_b1/audio/story_004.wav",

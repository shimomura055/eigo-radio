      "path": "er013_output/family_c_episode_trial_09/home_robots_b1/audio/story_010.wav",
      "sha256": "2f9b6fa7d15277d05364386c999012a591e1157e7ad26f9011b08c3105e1bfa7",
      "canonical_text": "Maya usually read the words and pressed Send.",

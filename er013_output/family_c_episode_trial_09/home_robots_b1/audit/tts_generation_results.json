      "disfluency_checked": true,
      "reused": true,
      "asr_text": null
    },
    "story_015": {
      "status": "OK",
      "path": "er013_output/family_c_episode_trial_09/home_robots_b1/audio/story_015.wav",
      "sha256": "ad76db5738e4ebb5a5df2e6ead47c51623008b687d632e8ede526cc559244770",
      "canonical_text": "\"I can go to a care house, or I can stay here with you. Which do you think is better?\"",
      "disfluency_checked": true,
      "reused": true,
      "asr_text": null
    },
    "story_016": {
      "status": "OK",
      "path": "er013_output/family_c_episode_trial_09/home_robots_b1/audio/story_016.wav",

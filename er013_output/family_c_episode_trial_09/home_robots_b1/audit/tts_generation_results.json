      "sha256": "e69e9b204a527eb70bc7ddb85f62b9bc91a035db00547c537220f4e6d521f233",
      "canonical_text": "\"My doctor says I cannot live by myself anymore,\"",
      "disfluency_checked": true,
      "reused": true,
      "asr_text": null
    },

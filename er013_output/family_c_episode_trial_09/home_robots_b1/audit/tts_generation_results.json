      "sha256": "81ba420aaee7fab079d3bd8c640fc67c822a0061ec653c2edb2851a8d9d4c478",
      "canonical_text": "It selected her meals, clothes, music, and route to work. It watched the time and changed her plans when the trains were crowded. When a message from a friend arrived, the robot offered a reply.",
      "disfluency_checked": true,
      "reused": true,
      "asr_text": null
    },

      "disfluency_checked": true,
      "reused": true,
      "asr_text": null
    },
    "story_005": {
      "status": "OK",
      "path": "er013_output/family_c_episode_trial_09/home_robots_b1/audio/story_005.wav",
      "sha256": "926bccb11ba8e4ef4e8f2115d3a6316b75e5f6857dc3e1489e14e823c9cc2e9d",
      "canonical_text": "That was how her days had been prepared for years.",
      "disfluency_checked": true,
      "reused": true,

      result = writer_generic.run_writer_stage_generic(theme_mod.THEME_CONFIG, out_dir_base)\n1058\t        print(f\"[B-FAMILY-VOICES-3V-PROD-RUNNER][write_new_theme] status={result.get('status')}\")\n1059\t        return\n1060\t\n1061\t    os.makedirs(f\"{OUT_DIR_3V}/audit\", exist_ok=True)\n1062\t    cl.install(COST_LOG_PATH_3V)\n1063\t\n1064\t    needs_prep = stage in (\"prepare\", \"voice_check\", \"kp_reuse\", \"scaffold\", \"tts\", \"all\")\n1065\t    needs_voice_resolution = stage in (\"tts\", \"assemble\", \"player\", \"all\")\n1066\t\n1067\t    if stage in (\"prepare\", \"all\"):\n1068\t        prep = prepare_3v()\n1069\t    elif needs_prep:\n1070\t        prep = {\"article_text\": open(ARTICLE_PATH_3V, encoding=\"utf-8\").read()}\n1071\t        prep[\"parts\"] = load_json(f\"{OUT_B1_DIR_3V}/parts.json\")\n1072\t\n1073\t    if stage in (\"voice_check\", \"all\"):\n1074\t        vc = voice_check_3v(prep[\"parts\"])\n1075\t        voice_a, voice_b, voice_c, reasons = vc[\"voice_a\"], vc[\"voice_b\"], vc[\"voice_c\"], vc[\"reasons\"]\n1076\t    elif needs_voice_resolution:\n1077\t        resolution = load_json(f\"{OUT_DIR_3V}/audit/voice_resolution.json\")\n1078\t        # Fable修正指示3回目(見落とし2): voice_check_3v()未実行/衝突STOP済みの\n1079\t        # まま stage=\"tts\" 等を単独実行すると、以前は resolution[\"voice_a\"] が\n1080\t        # KeyErrorで不可解に落ちていた。status=\"VOICE_COLLISION_STOP\"の場合は\n1081\t        # ここで明示メッセージのRuntimeErrorとしてSTOPする(overrideしない、\n1082\t        # まずstage=\"voice_check\"のみ再実行して一過性か切り分けることを促す)。\n1083\t        if resolution.get(\"status\") == \"VOICE_COLLISION_STOP\":\n1084\t            raise RuntimeError(\n1085\t                \"[VOICE_COLLISION_STOP] main_b1_3v: 直近のvoice_check_3v()がVoice衝突で\"\n1086\t                \"STOPしたままです(audit/voice_resolution.json参照)。まずstage=\\\"voice_check\\\"\"\n1087\t                \"のみ再実行し、一過性の技術失敗か構造的な衝突かを切り分けてください。\"\n1088\t                f\"error={resolution.get('error')}\")\n1089\t        voice_a, voice_b, voice_c, reasons = (r
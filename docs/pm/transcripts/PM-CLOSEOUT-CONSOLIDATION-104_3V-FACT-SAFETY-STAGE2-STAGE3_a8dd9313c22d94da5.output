{"parentUuid":"cf3fbc44-c384-4265-9b3f-51b66cd164ae","isSidechain":true,"agentId":"a8dd9313c22d94da5","message":{"model":"claude-sonnet-5","id":"msg_011CezbJtjYuabjKy8ZtPaEa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01AGr7m1LR7ndae9PtGTXSK5","name":"Read","input":{"file_path":"C:\\Users\\tensh\\eigo-radio\\er012_b_family_voices_writer_generic_01_test_01.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":276,"cache_read_input_tokens":102925,"cache_creation":{"ephemeral_5m_input_tokens":276,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01AGr7m1LR7ndae9PtGTXSK5":{"file_path":"C:\\Users\\tensh\\eigo-radio\\er012_b_family_voices_writer_generic_01_test_01.py"}},"apiBlockIndex":1,"requestId":"req_011CezbJtFmby3k25kFYRXHi","attributionAgent":"sonnet-worker","type":"assistant","uuid":"a3402aee-c47a-428b-b1ce-9615401c519e","timestamp":"2026-09-13T01:44:55.654Z","effort":"high","perTurnEffort":null,"userType":"external","entrypoint":"cli","cwd":"C:\\Users\\tensh\\eigo-radio","sessionId":"294958fe-da6e-491c-8a02-4f864d8195c8","version":"2.1.267","gitBranch":"main","slug":"valiant-booping-rose"}
{"parentUuid":"a3402aee-c47a-428b-b1ce-9615401c519e","isSidechain":true,"promptId":"db7e4f9a-4dd3-497b-b0ec-15ab4ceb450c","agentId":"a8dd9313c22d94da5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AGr7m1LR7ndae9PtGTXSK5","type":"tool_result","content":"1\t# ============================================================\n2\t# er012_b_family_voices_writer_generic_01_test_01.py\n3\t# 管理ID: EDITORIAL-B-FAMILY-VOICES-3V-PRODUCTION-WIRING-PHASE1B-04-\n4\t# GENERALIZATION-AND-REGRESSION\n5\t# ============================================================\n6\t# `er012_b_family_voices_writer_generic_01.py`(汎用Writerテンプレート/\n7\t# パイプライン)+`er012_b_family_voices_theme_ai_screening_01.py`(テーマ\n8\t# データ)の単体テスト(API呼び出し無し、¥0)。\n9\t#   1. テンプレート組み立てのpin(ANCHOR挿入・出力の決定性)。\n10\t#   2. Voice Card→prompt注入(3枚とも本文へ現れる、Ledger evidence tag\n11\t#      traceabilityが保持される)。\n12\t#   3. 任意パターン(external_constraint)のON/OFF(3b・自己チェック・\n13\t#      Leakage QAフィールドが条件どおり出現/消失する)。\n14\t#   4. Ledger fragment一般化ルール(可視Voice数を超えるVoice番号のみ除去)。\n15\t#   5. 6区切りparserがProduction正式関数(b1prod)への委譲であること。\n16\t#   6. Dangling Reference Check相当: 旧Trialファイル\n17\t#      (`er012_editorial_b_voices_3v_person_voice_trial_02`等、\"trial\"を\n18\t#      含むモジュール名)をモジュールレベルでimportしていないこと。\n19\tfrom __future__ import annotations\n20\t\n21\timport copy\n22\timport unittest\n23\t\n24\timport er012_b_family_voices_theme_ai_screening_01 as theme_ai_screening\n25\timport er012_b_family_voices_writer_generic_01 as wg\n26\t\n27\t\n28\tclass BuildFocusModuleBlockDeterminismTests(unittest.TestCase):\n29\t    def test_same_theme_config_produces_identical_block(self):\n30\t        b1 = wg.build_focus_module_block_3v(theme_ai_screening.THEME_CONFIG)\n31\t        b2 = wg.build_focus_module_block_3v(theme_ai_screening.THEME_CONFIG)\n32\t        self.assertEqual(b1, b2)\n33\t\n34\t    def test_anchor_present_exactly_once_after_insertion(self):\n35\t        block = wg.build_focus_module_block_3v(theme_ai_screening.THEME_CONFIG)\n36\t        candidate = wg.build_candidate_template(block)\n37\t        self.assertEqual(candidate.count(wg.ANCHOR), 1)\n38\t        self.assertIn(block, candidate)\n39\t\n40\t\n41\tclass VoiceCardInjectionTests(unittest.TestCase):\n42\t    def setUp(self):\n43\t        self.block = wg.build_focus_module_block_3v(theme_ai_screening.THEME_CONFIG)\n44\t\n45\t    def test_all_three_voice_cards_appear_in_block(self):\n46\t        for card in theme_ai_screening.THEME_CONFIG[\"voice_cards\"]:\n47\t            self.assertIn(card[\"person\"], self.block)\n48\t            self.assertIn(card[\"stake\"], self.block)\n49\t\n50\t    def test_evidence_tags_preserved_verbatim_for_traceability(self):\n51\t        for card in theme_ai_screening.THEME_CONFIG[\"voice_cards\"]:\n52\t            tags = wg.voice_card_evidence_tags(card)\n53\t            self.assertTrue(tags, f\"{card['voice_key']}にLedger evidence tagが見つかりません\")\n54\t            for tag in tags:\n55\t                self.assertIn(tag, self.block)\n56\t\n57\t    def test_card_intro_caveat_included_when_present(self):\n58\t        card3 = theme_ai_screening.THEME_CONFIG[\"voice_cards\"][2]\n59\t        self.assertIn(card3[\"card_intro_caveat\"], self.block)\n60\t\n61\t    def test_reference_phrases_included_in_heading_instruction(self):\n62\t        for card in theme_ai_screening.THEME_CONFIG[\"voice_cards\"]:\n63\t            self.assertIn(card[\"reference_phrase\"], self.block)\n64\t\n65\t\n66\tclass ExperientialClaimGroundingPermanentPrincipleTests(unittest.TestCase):\n67\t    \"\"\"ユーザー決定2026-09-12(1): 恒久原則、フラグ無しで常時含まれること。\"\"\"\n68\t\n69\t    def test_grounding_block_always_present(self):\n70\t        theme_config_no_ext = copy.deepcopy(theme_ai_screening.THEME_CONFIG)\n71\t        theme_config_no_ext[\"external_constraint\"] = None\n72\t        block = wg.build_focus_module_block_3v(theme_config_no_ext)\n73\t        self.assertIn(wg.COMMON_EXPERIENTIAL_CLAIM_GROUNDING_BLOCK, block)\n74\t\n75\t\n76\tclass ExternalConstraintOptionalPatternToggleTests(unittest.TestCase):\n77\t    \"\"\"ユーザー決定2026-09-12(2): 任意パターン、ON/OFFで本文・QAスキーマが\n78\t    条件どおりに変わること(恒久ルール化しない、既定は呼び出し側が選ぶ)。\"\"\"\n79\t\n80\t    def setUp(self):\n81\t        self.theme_on = theme_ai_screening.THEME_CONFIG\n82\t        self.theme_off = copy.deepcopy(theme_ai_screening.THEME_CONFIG)\n83\t        self.theme_off[\"external_constraint\"] = None\n84\t\n85\t    def test_on_includes_3b_and_self_check(self):\n86\t        block = wg.build_focus_module_block_3v(self.theme_on)\n87\t        self.assertIn(\"外部制約の統合\", block)\n88\t        self.assertIn(\"Tensionの自己チェック\", block)\n89\t        self.assertIn(\"VOICE_4_EVIDENCE\", block)\n90\t\n91\t    def test_off_omits_3b_and_self_check(self):\n92\t        block = wg.build_focus_module_block_3v(self.theme_off)\n93\t        self.assertNotIn(\"外部制約の統合\", block)\n94\t        self.assertNotIn(\"Tensionの自己チェック\", block)\n95\t        self.assertNotIn(\"VOICE_4_EVIDENCE\", block)\n96\t\n97\t    def test_leakage_schema_includes_constraint_integration_field_only_when_enabled(self):\n98\t        schema_on, fields_on = wg.build_leakage_schema_3v(True)\n99\t        schema_off, fields_off = wg.build_leakage_schema_3v(False)\n100\t        self.assertIn(wg.TENSION_LEAKAGE_FIELD_CONSTRAINT_INTEGRATION, fields_on[\"tension\"])\n101\t        self.assertNotIn(wg.TENSION_LEAKAGE_FIELD_CONSTRAINT_INTEGRATION, fields_off[\"tension\"])\n102\t        # Voice/Closing側のfieldは有効/無効で変化しない(対象外の基準を追加/除去しない)。\n103\t        self.assertEqual(fields_on[\"voice_1\"], fields_off[\"voice_1\"])\n104\t        self.assertEqual(fields_on[\"closing\"], fields_off[\"closing\"])\n105\t\n106\t    def test_leakage_prompt_mentions_constraint_field_only_when_enabled(self):\n107\t        sections = {\n108\t            \"voice_1_body\": \"v1\", \"voice_2_body\": \"v2\", \"voice_3_body\": \"v3\",\n109\t            \"tension_body\": \"t\", \"closing_body\": \"c\",\n110\t        }\n111\t        prompt_on = wg.build_leakage_check_prompt_3v(sections, True)\n112\t        prompt_off = wg.build_leakage_check_prompt_3v(sections, False)\n113\t        self.assertIn(\"leak_tension_constraint_integration\", prompt_on)\n114\t        self.assertNotIn(\"leak_tension_constraint_integration\", prompt_off)\n115\t\n116\t\n117\tclass LedgerFragmentVisibleVoicesGeneralizationTests(unittest.TestCase):\n118\t    \"\"\"Trial-02の`build_ledger_fragment_voices_1_2_3_only()`(VOICE_4専用\n119\t    ハードコード)を一般化したもの: 可視Voice数を超えるVoice番号のブロックの\n120\t    みを除去する(意味は変更しない)。\"\"\"\n121\t\n122\t    # 実Ledgerの実際の記法(`[VOICE_n_EVIDENCE] n-xx(fact_id): ...`、閉じ\n123\t    # 角括弧の直後に半角スペース+番号が続く)に合わせる(er012_output/\n124\t    # ai_screening_ledger_trial_01/research/verified_fact_ledger.txt実物で確認済み)。\n125\t    LEDGER_TEXT = (\n126\t        \"[VOICE_1_EVIDENCE] 1-01(fact_a): Applicant fact line.\\n\\n\"\n127\t        \"[VOICE_2_EVIDENCE] 2-01(fact_b): Recruiter fact line.\\n\\n\"\n128\t        \"[VOICE_4_EVIDENCE] 4-01(fact_c): External constraint fact line.\\n\\n\"\n129\t        \"[VOICE_3_EVIDENCE] 3-01(fact_d): Owner fact line.\\n\"\n130\t    )\n131\t\n132\t    def test_default_three_visible_voices_excludes_voice_4_only(self):\n133\t        fragment = wg.build_ledger_fragment_visible_voices_only(self.LEDGER_TEXT, num_visible_voices=3)\n134\t        self.assertIn(\"[VOICE_1_EVIDENCE] 1-01\", fragment)\n135\t        self.assertIn(\"[VOICE_2_EVIDENCE] 2-01\", fragment)\n136\t        self.assertIn(\"[VOICE_3_EVIDENCE] 3-01\", fragment)\n137\t        self.assertNotIn(\"[VOICE_4_EVIDENCE] 4-01\", fragment)\n138\t        self.assertNotIn(\"External constraint fact line.\", fragment)\n139\t\n140\t    def test_two_visible_voices_excludes_voice_3_and_4(self):\n141\t        fragment = wg.build_ledger_fragment_visible_voices_only(self.LEDGER_TEXT, num_visible_voices=2)\n142\t        self.assertIn(\"[VOICE_1_EVIDENCE] 1-01\", fragment)\n143\t        self.assertIn(\"[VOICE_2_EVIDENCE] 2-01\", fragment)\n144\t        self.assertNotIn(\"[VOICE_3_EVIDENCE] 3-01\", fragment)\n145\t        self.assertNotIn(\"[VOICE_4_EVIDENCE] 4-01\", fragment)\n146\t\n147\t\n148\tclass SixSectionParserDelegatesToProductionTests(unittest.TestCase):\n149\t    ARTICLE = \"\"\"# Title\n150\t\n151\t## The Question\n152\t\n153\tHook body.\n154\t\n155\t### Voice One\n156\t\n157\tVoice one body.\n158\t\n159\t### Voice Two\n160\t\n161\tVoice two body.\n162\t\n163\t### Voice Three\n164\t\n165\tVoice three body.\n166\t\n167\t## Tension\n168\t\n169\tTension body.\n170\t\n171\t## Closing\n172\t\n173\tClosing body.\n174\t\"\"\"\n175\t\n176\t    def test_delegates_to_b1prod_split_six_voice_sections(self):\n177\t        import er012_b_family_voices_production_01 as b1prod\n178\t        expected = b1prod.split_six_voice_sections(self.ARTICLE)\n179\t        actual = wg.split_six_voice_sections(self.ARTICLE)\n180\t        self.assertEqual(expected, actual)\n181\t\n182\t    def test_downstream_pipeline_functions_use_matching_keys_no_api(self):\n183\t        \"\"\"回帰確認: `split_six_voice_sections()`が返すキー(b1prod方式の\n184\t        `voice_1_body`/`voice_2_body`/`voice_3_body`)と、`run_overlap_\n185\t        monitoring_3v()`/`build_leakage_check_prompt_3v()`が参照するキーが\n186\t        一致していること(¥0、API呼び出し無し)。過去にこの不一致で実行時\n187\t        `KeyError: 'point_one_body'`が発生した回帰の再発防止。\"\"\"\n188\t        import tempfile\n189\t        sections = wg.split_six_voice_sections(self.ARTICLE)\n190\t        with tempfile.TemporaryDirectory() as tmp:\n191\t            overlap = wg.run_overlap_monitoring_3v(sections, tmp)\n192\t        self.assertIn(\"directed_voice_pairs\", overlap)\n193\t        prompt = wg.build_leakage_check_prompt_3v(sections, True)\n194\t        self.assertIn(\"Voice one body.\", prompt)\n195\t        self.assertIn(\"Voice three body.\", prompt)\n196\t\n197\t\n198\tclass VoiceCardValidationTests(unittest.TestCase):\n199\t    def test_missing_required_field_raises(self):\n200\t        card = wg.make_voice_card(\n201\t            voice_key=\"voice_1\", stakeholder_label=\"X\", role_description_ja=\"\", reference_phrase=\"the x\",\n202\t            person=\"p\", situation=\"s\", need=\"n\", concern=\"c\", protect=\"pr\", why=\"w\", constraint=\"co\",\n203\t            concrete_scene=\"cs\", supporting_evidence=\"se\", stake=\"st\")\n204\t        with self.assertRaises(ValueError):\n205\t            wg.validate_voice_card(card)\n206\t\n207\t    def test_theme_config_requires_exactly_three_voice_cards(self):\n208\t        with self.assertRaises(ValueError):\n209\t            wg.make_theme_config(\n210\t                theme_id=\"t\", topic_ja=\"topic\", ledger_path=\"x.txt\",\n211\t                voice_cards=[theme_ai_screening.VOICE_CARD_1, theme_ai_screening.VOICE_CARD_2],\n212\t                tension_common_ground_value=\"g\", tension_asymmetry_value=\"a\")\n213\t\n214\t\n215\tclass NoTrialScriptModuleLevelImportTests(unittest.TestCase):\n216\t    \"\"\"Gate 4裏付け: 汎用モジュール・テーマdataモジュールのいずれも、\n217\t    Trialスクリプト(モジュール名に\"trial\"を含む)をモジュールレベルで\n218\t    importしていないことを、実ファイルのASTを解析して確認する(既存\n219\t    `er012_editorial_b_family_voices_3v_production_wiring_phase1_test_01.py`\n220\t    と同一手法)。\"\"\"\n221\t\n222\t    def _module_level_imports(self, path: str) -> list:\n223\t        import ast\n224\t        with open(path, encoding=\"utf-8\") as f:\n225\t            tree = ast.parse(f.read())\n226\t        imported_modules = []\n227\t        for node in ast.walk(tree):\n228\t            if isinstance(node, ast.Import):\n229\t                imported_modules.extend(alias.name for alias in node.names)\n230\t            elif isinstance(node, ast.ImportFrom) and node.module:\n231\t                imported_modules.append(node.module)\n232\t        return imported_modules\n233\t\n234\t    def test_writer_generic_module_does_not_import_any_trial_script(self):\n235\t        imports = self._module_level_imports(\"er012_b_family_voices_writer_generic_01.py\")\n236\t        self.assertEqual([m for m in imports if \"trial\" in m], [])\n237\t\n238\t    def test_theme_ai_screening_module_does_not_import_any_trial_script(self):\n239\t        imports = self._module_level_imports(\"er012_b_family_voices_theme_ai_screening_01.py\")\n240\t        self.assertEqual([m for m in imports if \"trial\" in m], [])\n241\t\n242\t    def test_production_runner_module_still_does_not_import_any_trial_script(self):\n243\t        imports = self._module_level_imports(\"er012_b_family_production_runner_01.py\")\n244\t        self.assertEqual([m for m in imports if \"trial\" in m], [])\n245\t\n246\t\n247\tif __name__ == \"__main__\":\n248\t    unittest.main()\n249\t"}]},"uuid":"36cd06f9-4de1-46e1-9137-3085527ad96d","timestamp":"2026-09-13T01:44:55.666Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\tensh\\eigo-radio\\er012_b_family_voices_writer_generic_01_test_01.py","content":"# ============================================================\n# er012_b_family_voices_writer_generic_01_test_01.py\n# 管理ID: EDITORIAL-B-FAMILY-VOICES-3V-PRODUCTION-WIRING-PHASE1B-04-\n# GENERALIZATION-AND-REGRESSION\n# ============================================================\n# `er012_b_family_voices_writer_generic_01.py`(汎用Writerテンプレート/\n# パイプライン)+`er012_b_family_voices_theme_ai_screening_01.py`(テーマ\n# データ)の単体テスト(API呼び出し無し、¥0)。\n#   1. テンプレート組み立てのpin(ANCHOR挿入・出力の決定性)。\n#   2. Voice Card→prompt注入(3枚とも本文へ現れる、Ledger evidence tag\n#      traceabilityが保持される)。\n#   3. 任意パターン(external_constraint)のON/OFF(3b・自己チェック・\n#      Leakage QAフィールドが条件どおり出現/消失する)。\n#   4. Ledger fragment一般化ルール(可視Voice数を超えるVoice番号のみ除去)。\n#   5. 6区切りparserがProduction正式関数(b1prod)への委譲であること。\n#   6. Dangling Reference Check相当: 旧Trialファイル\n#      (`er012_editorial_b_voices_3v_person_voice_trial_02`等、\"trial\"を\n#      含むモジュール名)をモジュールレベルでimportしていないこと。\nfrom __future__ import annotations\n\nimport copy\nimport unittest\n\nimport er012_b_family_voices_theme_ai_screening_01 as theme_ai_screening\nimport er012_b_family_voices_writer_generic_01 as wg\n\n\nclass BuildFocusModuleBlockDeterminismTests(unittest.TestCase):\n    def test_same_theme_config_produces_identical_block(self):\n        b1 = wg.build_focus_module_block_3v(theme_ai_screening.THEME_CONFIG)\n        b2 = wg.build_focus_module_block_3v(theme_ai_screening.THEME_CONFIG)\n        self.assertEqual(b1, b2)\n\n    def test_anchor_present_exactly_once_after_insertion(self):\n        block = wg.build_focus_module_block_3v(theme_ai_screening.THEME_CONFIG)\n        candidate = wg.build_candidate_template(block)\n        self.assertEqual(candidate.count(wg.ANCHOR), 1)\n        self.assertIn(block, candidate)\n\n\nclass VoiceCardInjectionTests(unittest.TestCase):\n    def setUp(self):\n        self.block = wg.build_focus_module_block_3v(theme_ai_screening.THEME_CONFIG)\n\n    def test_all_three_voice_cards_appear_in_block(self):\n        for card in theme_ai_screening.THEME_CONFIG[\"voice_cards\"]:\n            self.assertIn(card[\"person\"], self.block)\n            self.assertIn(card[\"stake\"], self.block)\n\n    def test_evidence_tags_preserved_verbatim_for_traceability(self):\n        for card in theme_ai_screening.THEME_CONFIG[\"voice_cards\"]:\n            tags = wg.voice_card_evidence_tags(card)\n            self.assertTrue(tags, f\"{card['voice_key']}にLedger evidence tagが見つかりません\")\n            for tag in tags:\n                self.assertIn(tag, self.block)\n\n    def test_card_intro_caveat_included_when_present(self):\n        card3 = theme_ai_screening.THEME_CONFIG[\"voice_cards\"][2]\n        self.assertIn(card3[\"card_intro_caveat\"], self.block)\n\n    def test_reference_phrases_included_in_heading_instruction(self):\n        for card in theme_ai_screening.THEME_CONFIG[\"voice_cards\"]:\n            self.assertIn(card[\"reference_phrase\"], self.block)\n\n\nclass ExperientialClaimGroundingPermanentPrincipleTests(unittest.TestCase):\n    \"\"\"ユーザー決定2026-09-12(1): 恒久原則、フラグ無しで常時含まれること。\"\"\"\n\n    def test_grounding_block_always_present(self):\n        theme_config_no_ext = copy.deepcopy(theme_ai_screening.THEME_CONFIG)\n        theme_config_no_ext[\"external_constraint\"] = None\n        block = wg.build_focus_module_block_3v(theme_config_no_ext)\n        self.assertIn(wg.COMMON_EXPERIENTIAL_CLAIM_GROUNDING_BLOCK, block)\n\n\nclass ExternalConstraintOptionalPatternToggleTests(unittest.TestCase):\n    \"\"\"ユーザー決定2026-09-12(2): 任意パターン、ON/OFFで本文・QAスキーマが\n    条件どおりに変わること(恒久ルール化しない、既定は呼び出し側が選ぶ)。\"\"\"\n\n    def setUp(self):\n        self.theme_on = theme_ai_screening.THEME_CONFIG\n        self.theme_off = copy.deepcopy(theme_ai_screening.THEME_CONFIG)\n        self.theme_off[\"external_constraint\"] = None\n\n    def test_on_includes_3b_and_self_check(self):\n        block = wg.build_focus_module_block_3v(self.theme_on)\n        self.assertIn(\"外部制約の統合\", block)\n        self.assertIn(\"Tensionの自己チェック\", block)\n        self.assertIn(\"VOICE_4_EVIDENCE\", block)\n\n    def test_off_omits_3b_and_self_check(self):\n        block = wg.build_focus_module_block_3v(self.theme_off)\n        self.assertNotIn(\"外部制約の統合\", block)\n        self.assertNotIn(\"Tensionの自己チェック\", block)\n        self.assertNotIn(\"VOICE_4_EVIDENCE\", block)\n\n    def test_leakage_schema_includes_constraint_integration_field_only_when_enabled(self):\n        schema_on, fields_on = wg.build_leakage_schema_3v(True)\n        schema_off, fields_off = wg.build_leakage_schema_3v(False)\n        self.assertIn(wg.TENSION_LEAKAGE_FIELD_CONSTRAINT_INTEGRATION, fields_on[\"tension\"])\n        self.assertNotIn(wg.TENSION_LEAKAGE_FIELD_CONSTRAINT_INTEGRATION, fields_off[\"tension\"])\n        # Voice/Closing側のfieldは有効/無効で変化しない(対象外の基準を追加/除去しない)。\n        self.assertEqual(fields_on[\"voice_1\"], fields_off[\"voice_1\"])\n        self.assertEqual(fields_on[\"closing\"], fields_off[\"closing\"])\n\n    def test_leakage_prompt_mentions_constraint_field_only_when_enabled(self):\n        sections = {\n            \"voice_1_body\": \"v1\", \"voice_2_body\": \"v2\", \"voice_3_body\": \"v3\",\n            \"tension_body\": \"t\", \"closing_body\": \"c\",\n        }\n        prompt_on = wg.build_leakage_check_prompt_3v(sections, True)\n        prompt_off = wg.build_leakage_check_prompt_3v(sections, False)\n        self.assertIn(\"leak_tension_constraint_integration\", prompt_on)\n        self.assertNotIn(\"leak_tension_constraint_integration\", prompt_off)\n\n\nclass LedgerFragmentVisibleVoicesGeneralizationTests(unittest.TestCase):\n    \"\"\"Trial-02の`build_ledger_fragment_voices_1_2_3_only()`(VOICE_4専用\n    ハードコード)を一般化したもの: 可視Voice数を超えるVoice番号のブロックの\n    みを除去する(意味は変更しない)。\"\"\"\n\n    # 実Ledgerの実際の記法(`[VOICE_n_EVIDENCE] n-xx(fact_id): ...`、閉じ\n    # 角括弧の直後に半角スペース+番号が続く)に合わせる(er012_output/\n    # ai_screening_ledger_trial_01/research/verified_fact_ledger.txt実物で確認済み)。\n    LEDGER_TEXT = (\n        \"[VOICE_1_EVIDENCE] 1-01(fact_a): Applicant fact line.\\n\\n\"\n        \"[VOICE_2_EVIDENCE] 2-01(fact_b): Recruiter fact line.\\n\\n\"\n        \"[VOICE_4_EVIDENCE] 4-01(fact_c): External constraint fact line.\\n\\n\"\n        \"[VOICE_3_EVIDENCE] 3-01(fact_d): Owner fact line.\\n\"\n    )\n\n    def test_default_three_visible_voices_excludes_voice_4_only(self):\n        fragment = wg.build_ledger_fragment_visible_voices_only(self.LEDGER_TEXT, num_visible_voices=3)\n        self.assertIn(\"[VOICE_1_EVIDENCE] 1-01\", fragment)\n        self.assertIn(\"[VOICE_2_EVIDENCE] 2-01\", fragment)\n        self.assertIn(\"[VOICE_3_EVIDENCE] 3-01\", fragment)\n        self.assertNotIn(\"[VOICE_4_EVIDENCE] 4-01\", fragment)\n        self.assertNotIn(\"External constraint fact line.\", fragment)\n\n    def test_two_visible_voices_excludes_voice_3_and_4(self):\n        fragment = wg.build_ledger_fragment_visible_voices_only(self.LEDGER_TEXT, num_visible_voices=2)\n        self.assertIn(\"[VOICE_1_EVIDENCE] 1-01\", fragment)\n        self.assertIn(\"[VOICE_2_EVIDENCE] 2-01\", fragment)\n        self.assertNotIn(\"[VOICE_3_EVIDENCE] 3-01\", fragment)\n        self.assertNotIn(\"[VOICE_4_EVIDENCE] 4-01\", fragment)\n\n\nclass SixSectionParserDelegatesToProductionTests(unittest.TestCase):\n    ARTICLE = \"\"\"# Title\n\n## The Question\n\nHook body.\n\n### Voice One\n\nVoice one body.\n\n### Voice Two\n\nVoice two body.\n\n### Voice Three\n\nVoice three body.\n\n## Tension\n\nTension body.\n\n## Closing\n\nClosing body.\n\"\"\"\n\n    def test_delegates_to_b1prod_split_six_voice_sections(self):\n        import er012_b_family_voices_production_01 as b1prod\n        expected = b1prod.split_six_voice_sections(self.ARTICLE)\n        actual = wg.split_six_voice_sections(self.ARTICLE)\n        self.assertEqual(expected, actual)\n\n    def test_downstream_pipeline_functions_use_matching_keys_no_api(self):\n        \"\"\"回帰確認: `split_six_voice_sections()`が返すキー(b1prod方式の\n        `voice_1_body`/`voice_2_body`/`voice_3_body`)と、`run_overlap_\n        monitoring_3v()`/`build_leakage_check_prompt_3v()`が参照するキーが\n        一致していること(¥0、API呼び出し無し)。過去にこの不一致で実行時\n        `KeyError: 'point_one_body'`が発生した回帰の再発防止。\"\"\"\n        import tempfile\n        sections = wg.split_six_voice_sections(self.ARTICLE)\n        with tempfile.TemporaryDirectory() as tmp:\n            overlap = wg.run_overlap_monitoring_3v(sections, tmp)\n        self.assertIn(\"directed_voice_pairs\", overlap)\n        prompt = wg.build_leakage_check_prompt_3v(sections, True)\n        self.assertIn(\"Voice one body.\", prompt)\n        self.assertIn(\"Voice three body.\", prompt)\n\n\nclass VoiceCardValidationTests(unittest.TestCase):\n    def test_missing_required_field_raises(self):\n        card = wg.make_voice_card(\n            voice_key=\"voice_1\", stakeholder_label=\"X\", role_description_ja=\"\", reference_phrase=\"the x\",\n            person=\"p\", situation=\"s\", need=\"n\", concern=\"c\", protect=\"pr\", why=\"w\", constraint=\"co\",\n            concrete_scene=\"cs\", supporting_evidence=\"se\", stake=\"st\")\n        with self.assertRaises(ValueError):\n            wg.validate_voice_card(card)\n\n    def test_theme_config_requires_exactly_three_voice_cards(self):\n        with self.assertRaises(ValueError):\n            wg.make_theme_config(\n                theme_id=\"t\", topic_ja=\"topic\", ledger_path=\"x.txt\",\n                voice_cards=[theme_ai_screening.VOICE_CARD_1, theme_ai_screening.VOICE_CARD_2],\n                tension_common_ground_value=\"g\", tension_asymmetry_value=\"a\")\n\n\nclass NoTrialScriptModuleLevelImportTests(unittest.TestCase):\n    \"\"\"Gate 4裏付け: 汎用モジュール・テーマdataモジュールのいずれも、\n    Trialスクリプト(モジュール名に\"trial\"を含む)をモジュールレベルで\n    importしていないことを、実ファイルのASTを解析して確認する(既存\n    `er012_editorial_b_family_voices_3v_production_wiring_phase1_test_01.py`\n    と同一手法)。\"\"\"\n\n    def _module_level_imports(self, path: str) -> list:\n        import ast\n        with open(path, encoding=\"utf-8\") as f:\n            tree = ast.parse(f.read())\n        imported_modules = []\n        for node in ast.walk(tree):\n            if isinstance(node, ast.Import):\n                imported_modules.extend(alias.name for alias in node.names)\n            elif isinstance(node, ast.ImportFrom) and node.module:\n                imported_modules.append(node.module)\n        return imported_modules\n\n    def test_writer_generic_module_does_not_import_any_trial_script(self):\n        imports = self._module_level_imports(\"er012_b_family_voices_writer_generic_01.py\")\n        self.assertEqual([m for m in imports if \"trial\" in m], [])\n\n    def test_theme_ai_screening_module_does_not_import_any_trial_script(self):\n        imports = self._module_level_imports(\"er012_b_family_voices_theme_ai_screening_01.py\")\n        self.assertEqual([m for m in imports if \"trial\" in m], [])\n\n    def test_production_runner_module_still_does_not_import_any_trial_script(self):\n        imports = self._module_level_imports(\"er012_b_family_production_runner_01.py\")\n        self.assertEqual([m for m in imports if \"trial\" in m], [])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":249,"startLine":1,"totalLines":249}},"sourceToolAssistantUUID":"a3402aee-c47a-428b-b1ce-9615401c519e","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\tensh\\eigo-radio","sessionId":"294958fe-da6e-491c-8a02-4f864d8195c8","version":"2.1.267","gitBranch":"main","slug":"valiant-booping-rose"}

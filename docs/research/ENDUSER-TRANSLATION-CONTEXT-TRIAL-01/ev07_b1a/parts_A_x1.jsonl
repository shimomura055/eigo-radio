{"unit": "family_z_melos_kphr_evidence_r3/adv/adv_12", "cond": "A_x1", "split": "custom", "slug": "family_z_melos_kphr_evidence_r3", "level": "adv", "family": "Z", "parts": [{"part": "adv_12", "kind": "story", "stratum": "gen", "sids": ["adv_12-s026", "adv_12-s027", "adv_12-s028", "adv_12-s029", "adv_12-s030", "adv_12-s031", "adv_12-s032", "adv_12-s033", "adv_12-s034", "adv_12-s035", "adv_12-s036", "adv_12-s037", "adv_12-s038", "adv_12-s039", "adv_12-s040", "adv_12-s041", "adv_12-s042"]}], "ctx_sentences": 0, "ctx_chars": 0, "double_ctx_block": false, "ja": {"adv_12-s026": "川に着くと、彼は立ち止まった。", "adv_12-s027": "橋はなくなっていた。", "adv_12-s028": "雨で川の水は茶色く濁り、荒れ狂っていた。", "adv_12-s029": "彼は後ずさりし、走り出すと、洪水の中に身を投げた。", "adv_12-s030": "激流に彼は水中へ引きずり込まれた。", "adv_12-s031": "彼は光に向かってもがき、枝をつかんで、向こう岸へ這い上がった。", "adv_12-s032": "さらに進むと、3人の男が道をふさいでいた。", "adv_12-s033": "ナイフがきらりと光った。", "adv_12-s034": "メロスはそれを持つ男を杖で殴り、坂を駆け上がった。彼らの叫び声が後を追ってきた。", "adv_12-s035": "午後になるころには、一歩ごとに痛みが走った。", "adv_12-s036": "足は血で染まっていた。", "adv_12-s037": "彼は岩のそばに倒れ、起き上がろうとしたが、足は言うことを聞かなかった。", "adv_12-s038": "ここで待つこともできた。", "adv_12-s039": "誰かが彼を見つけてくれるかもしれない。", "adv_12-s040": "家に帰ることもできた。", "adv_12-s041": "友人は死ぬだろう。", "adv_12-s042": "恐ろしいことに、ほんの一瞬、立ち上がるよりも友人を死なせるほうが楽に思えた。"}, "complete": true, "paragraphs": 1, "paragraphs_translated": 1, "failures": [], "api_calls": {"translate": 2, "verify": 1}, "wall_s": 24.94, "cost_jpy": 0.2669, "calls": [{"kind": "translate", "wall_s": 5.01, "cost_jpy": 0.0544, "usage": {"input_tokens": 568, "output_tokens": 567, "cached_input_tokens": 0, "reasoning_tokens": 154}}, {"kind": "translate", "wall_s": 7.45, "cost_jpy": 0.0905, "usage": {"input_tokens": 568, "output_tokens": 1018, "cached_input_tokens": 0, "reasoning_tokens": 578}}, {"kind": "verify", "wall_s": 12.48, "cost_jpy": 0.122, "usage": {"input_tokens": 863, "output_tokens": 1353, "cached_input_tokens": 0, "reasoning_tokens": 1206}}]}

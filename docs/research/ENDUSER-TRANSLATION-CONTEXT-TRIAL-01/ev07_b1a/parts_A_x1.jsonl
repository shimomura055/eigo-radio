{"unit": "family_z_melos_kphr_evidence_r3/std/std_13", "cond": "A_x1", "split": "custom", "slug": "family_z_melos_kphr_evidence_r3", "level": "std", "family": "Z", "parts": [{"part": "std_13", "kind": "story", "stratum": "gen", "sids": ["std_13-s005", "std_13-s006", "std_13-s007", "std_13-s008", "std_13-s009", "std_13-s010", "std_13-s011", "std_13-s012", "std_13-s013", "std_13-s014", "std_13-s015", "std_13-s016", "std_13-s017", "std_13-s018", "std_13-s019", "std_13-s020", "std_13-s021"]}], "ctx_sentences": 0, "ctx_chars": 0, "double_ctx_block": false, "ja": {"std_13-s005": "メロスは広間の向こうから呼びかけた。", "std_13-s006": "「恐怖から人を殺すのだ。", "std_13-s007": "彼らに話す機会を決して与えない。」", "std_13-s008": "沈黙が訪れ、衛兵たちは若い羊飼いを捕らえた。", "std_13-s009": "支配者は彼の死を命じた。", "std_13-s010": "私の女きょうだいの結婚式に出るため、3日間ください。", "std_13-s011": "とメロスは言った。", "std_13-s012": "「そうしたら、あなたのもとへ戻ります。」", "std_13-s013": "支配者は笑って言った。", "std_13-s014": "「お前の友人はここに残らなければならない。", "std_13-s015": "戻るのが遅れたら、彼がお前の身代わりに死ぬことになる。」", "std_13-s016": "メロスは、鎖につながれるために両手を差し出した友人のほうを向いた。", "std_13-s017": "メロスには話す時間がなかった。", "std_13-s018": "「今すぐ行け。お前が戻ってくると分かっているから。」", "std_13-s019": "結婚式では、彼の女きょうだいの笑い声が皆の声より高く響いた。", "std_13-s020": "彼はその正確な音を覚えておくため、注意深く耳を傾けた。", "std_13-s021": "彼は3日目の夜明け前に都市へ向けて出発した。"}, "complete": true, "paragraphs": 11, "paragraphs_translated": 11, "failures": [], "api_calls": {"translate": 2, "verify": 2}, "wall_s": 46.26, "cost_jpy": 0.3543, "calls": [{"kind": "translate", "wall_s": 15.03, "cost_jpy": 0.1212, "usage": {"input_tokens": 570, "output_tokens": 1401, "cached_input_tokens": 0, "reasoning_tokens": 977}}, {"kind": "verify", "wall_s": 11.6, "cost_jpy": 0.0982, "usage": {"input_tokens": 840, "output_tokens": 1059, "cached_input_tokens": 0, "reasoning_tokens": 855}}, {"kind": "translate", "wall_s": 12.24, "cost_jpy": 0.1107, "usage": {"input_tokens": 833, "output_tokens": 1217, "cached_input_tokens": 0, "reasoning_tokens": 1087}}, {"kind": "verify", "wall_s": 7.39, "cost_jpy": 0.0242, "usage": {"input_tokens": 435, "output_t
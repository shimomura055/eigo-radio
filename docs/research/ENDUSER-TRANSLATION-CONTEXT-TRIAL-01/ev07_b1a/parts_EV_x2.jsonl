{"unit": "family_z_melos_kphr_evidence_r3/std/std_13", "cond": "EV_x2", "split": "custom", "slug": "family_z_melos_kphr_evidence_r3", "level": "std", "family": "Z", "parts": [{"part": "std_13", "kind": "story", "stratum": "gen", "sids": ["std_13-s005", "std_13-s006", "std_13-s007", "std_13-s008", "std_13-s009", "std_13-s010", "std_13-s011", "std_13-s012", "std_13-s013", "std_13-s014", "std_13-s015", "std_13-s016", "std_13-s017", "std_13-s018", "std_13-s019", "std_13-s020", "std_13-s021"]}], "ctx_sentences": 8, "ctx_chars": 378, "double_ctx_block": false, "ja": {"std_13-s005": "メロスは広間の向こうから呼びかけた。", "std_13-s006": "「あなたは恐怖から人を殺す。", "std_13-s007": "彼らに話す機会を決して与えない。」", "std_13-s008": "静寂が訪れ、衛兵たちは若い羊飼いを捕らえた。", "std_13-s009": "支配者は彼の死を命じた。", "std_13-s010": "「妹の結婚式に出席するため、3日間ください」", "std_13-s011": "メロスは言った。", "std_13-s012": "「それから、あなたのもとへ戻ります。」", "std_13-s013": "支配者は笑って言った。", "std_13-s014": "「お前の友人はここに残らなければならない。", "std_13-s015": "遅れて戻れば、お前の代わりに彼が死ぬ。」", "std_13-s016": "メロスは、鎖をかけてもらうために両手を差し出した友人のほうを向いた。", "std_13-s017": "メロスには話す時間がなかった。", "std_13-s018": "「今すぐ行け。君が戻ってくると分かっているから。」", "std_13-s019": "結婚式では、妹の笑い声が皆の声を超えて響いた。", "std_13-s020": "メロスは、その正確な音を覚えておくために注意深く耳を傾けた。", "std_13-s021": "3日目の日が明ける前に、彼は都へ向けて出発した。"}, "complete": true, "paragraphs": 11, "paragraphs_translated": 11, "failures": [], "api_calls": {"translate": 1, "verify": 1}, "wall_s": 23.46, "cost_jpy": 0.1876, "calls": [{"kind": "translate", "wall_s": 18.83, "cost_jpy": 0.137, "usage": {"input_tokens": 680, "output_tokens": 1576, "cached_input_tokens": 0, "reasoning_tokens": 1159}}, {"kind": "verify", "wall_s": 4.63, "cost_jpy": 0.0506, "usage": {"input_tokens": 958, "output_tokens": 441, "cached_input_tokens": 0, "reasoning_tokens": 294}}]}
{"unit": "family_z_melos_kphr_evidence_r3/adv/adv_12", "cond": "EV_x2", "split": "custom", "slug": "family_z_melos_kphr_evidence_r3", "level": "adv", "family": "Z", "parts": [{"part": "adv_12", "kind": "story", "stratum": "gen", "sids": ["adv_12-s026", "adv_12-s027", "adv_12-s028", "adv_12-s029", "adv_12-s030", "adv_12-s031", "adv_12-s032", "adv_12-s033", "adv_12-s034", "adv_12-s035", "adv_12-s036", "adv_12-s037", "adv_12-s038", "adv_12-s039", "adv_12-s040", "adv_12-s041", "adv_12-s042"]}], "ctx_sentences": 9, "ctx_chars": 504, "double_ctx_block": false, "ja": {"adv_12-s026": "川のところで、彼は立ち止まった。", "adv_12-s027": "橋はなくなっていた。", "adv_12-s028": "雨で水は茶色く濁り、荒れ狂っていた。", "adv_12-s029": "彼は後ずさりし、走って、濁流に身を投げた。", "adv_12-s030": "流れに引き込まれた。", "adv_12-s031": "彼は光の方へ必死に進み、枝につかまって、なんとか向こう岸に上がった。", "adv_12-s032": "さらに進むと、3人の男が道をふさいでいた。", "adv_12-s033": "ナイフがきらりと光った。", "adv_12-s034": "メロスは杖でナイフを持った男を殴り、男たちの叫び声を背に受けながら坂を駆け上った。", "adv_12-s035": "午後になるころには、一歩ごとに痛みが走った。", "adv_12-s036": "足は血で染まっていた。", "adv_12-s037": "彼は岩のそばに倒れ、起き上がろうとしたが、足は言うことを聞かなかった。", "adv_12-s038": "ここで待っていてもいい。", "adv_12-s039": "誰かが見つけてくれるかもしれない。", "adv_12-s040": "家に帰ることもできる。", "adv_12-s041": "そうすれば、友は死ぬ。", "adv_12-s042": "恐ろしい一瞬、そのほうが起き上がるより楽に思えた。"}, "complete": true, "paragraphs": 1, "paragraphs_translated": 1, "failures": [], "api_calls": {"translate": 1, "verify": 1}, "wall_s": 13.8, "cost_jpy": 0.124, "calls": [{"kind": "translate", "wall_s": 7.65, "cost_jpy": 0.0678, "usage": {"input_tokens": 710, "output_tokens": 705, "cached_input_tokens": 0, "reasoning_tokens": 294}}, {"kind": "verify", "wall_s": 6.15, "cost_jpy": 0.0562, "usage": {"input_tokens": 992, "output_tokens": 504, "cached_input_tokens": 0, "reasoning_tokens": 357}}]}

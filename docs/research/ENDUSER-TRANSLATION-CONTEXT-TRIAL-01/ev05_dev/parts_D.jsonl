{"unit": "family_z_melos_kphr_evidence_r3/adv/adv_10", "cond": "D", "split": "dev", "slug": "family_z_melos_kphr_evidence_r3", "level": "adv", "family": "Z", "parts": [{"part": "adv_10", "kind": "story", "stratum": "gen", "sids": ["adv_10-s004", "adv_10-s005", "adv_10-s006", "adv_10-s007", "adv_10-s008", "adv_10-s009", "adv_10-s010", "adv_10-s011", "adv_10-s012", "adv_10-s013", "adv_10-s014", "adv_10-s015", "adv_10-s016", "adv_10-s017", "adv_10-s018", "adv_10-s019", "adv_10-s020", "adv_10-s021", "adv_10-s022", "adv_10-s023"]}], "ctx_sentences": 51, "ctx_chars": 1986, "double_ctx_block": false, "ja": {"adv_10-s004": "メロスの声が広間に響き渡った。", "adv_10-s005": "「あなたは人々を恐れているから、彼らを殺すのです。", "adv_10-s006": "彼らに話すことさえ許さない。」", "adv_10-s007": "そのあと、沈黙が訪れた。", "adv_10-s008": "すると警備兵たちは若い羊飼いを捕らえ、支配者は彼に死刑を宣告した。", "adv_10-s009": "「3日間ください」", "adv_10-s010": "とメロスは言った。", "adv_10-s011": "「妹が結婚するんです。", "adv_10-s012": "彼女の結婚式を見届けさせてください。", "adv_10-s013": "必ず戻ります。」", "adv_10-s014": "支配者は笑った。", "adv_10-s015": "「お前の友人はここに残る。", "adv_10-s016": "お前が遅れたら、代わりに彼が死ぬ。」", "adv_10-s017": "メロスは友人のほうを向いたが、彼が口を開く前に、友人は鎖をかけてもらうために両手を差し出した。", "adv_10-s018": "「行け。", "adv_10-s019": "お前が戻ってくると分かっている。」", "adv_10-s020": "結婚式では、妹の笑い声がほかの人々の声の中でもひときわ高く響いた。", "adv_10-s021": "メロスは注意深く耳を傾けた。", "adv_10-s022": "彼はその声がどんなふうに聞こえたか、正確に覚えておきたかった。", "adv_10-s023": "3日目の夜明け前、彼は都へ向けて出発した。"}, "complete": true, "paragraphs": 11, "paragraphs_translated": 11, "failures": [], "api_calls": {"translate": 2, "verify": 1}, "wall_s": 17.97, "cost_jpy": 0.1873, "calls": [{"kind": "translate", "wall_s": 3.05, "cost_jpy": 0.0342, "usage": {"input_tokens": 1107, "output_tokens": 206, "cached_input_tokens": 0, "reasoning_tokens": 104}}, {"kind": "translate", "wall_s": 9.42, "cost_jpy": 0.0949, "usage": {"input_tokens": 1107, "output_tokens": 1163, "cached_input_tokens": 1104, "reasoning_tokens": 694}}, {"kind": "verify", "wall_s": 5.5, "cost_jpy": 0.0582, "usage": {"input_tokens": 896, "output_tokens": 548, "cached_input_tokens": 0, "reasoning_
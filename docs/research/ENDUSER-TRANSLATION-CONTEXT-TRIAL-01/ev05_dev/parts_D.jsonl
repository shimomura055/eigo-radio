{"unit": "family_z_melos_kphr_evidence_r3/adv/adv_03", "cond": "D", "split": "dev", "slug": "family_z_melos_kphr_evidence_r3", "level": "adv", "family": "Z", "parts": [{"part": "adv_03", "kind": "preview", "stratum": "gen", "sids": ["adv_03-s001", "adv_03-s002"]}], "ctx_sentences": 69, "ctx_chars": 2474, "double_ctx_block": false, "ja": {"adv_03-s001": "この物語は、支配者に反論し、死刑を言い渡される若い羊飼いを描いています。", "adv_03-s002": "身近な人に影響を及ぼす選択に直面する彼を、この大きな重圧の中で導くものは何でしょうか？"}, "complete": true, "paragraphs": 1, "paragraphs_translated": 1, "failures": [], "api_calls": {"translate": 1, "verify": 1}, "wall_s": 5.06, "cost_jpy": 0.0527, "calls": [{"kind": "translate", "wall_s": 2.9, "cost_jpy": 0.0357, "usage": {"input_tokens": 1089, "output_tokens": 229, "cached_input_tokens": 0, "reasoning_tokens": 135}}, {"kind": "verify", "wall_s": 2.16, "cost_jpy": 0.017, "usage": {"input_tokens": 391, "output_tokens": 134, "cached_input_tokens": 0, "reasoning_tokens": 107}}]}

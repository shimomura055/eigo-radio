{"unit": "family_x_jwst_mystery_emission_line_01/adv/adv_14", "cond": "D", "split": "dev", "slug": "family_x_jwst_mystery_emission_line_01", "level": "adv", "family": "X", "parts": [{"part": "adv_14", "kind": "story", "stratum": "gold", "sids": ["adv_14-s005", "adv_14-s006", "adv_14-s007", "adv_14-s008", "adv_14-s009", "adv_14-s010", "adv_14-s011", "adv_14-s012", "adv_14-s013", "adv_14-s014", "adv_14-s015"]}], "ctx_sentences": 39, "ctx_chars": 2803, "double_ctx_block": false, "ja": {"adv_14-s005": "「声は聞こえるのに、顔は見えない。」", "adv_14-s006": "どんな探偵も悩ませるような謎が、宇宙に現れました。", "adv_14-s007": "手がかりは、JWSTの観測装置NIRSpecが捉えた「光の線」です。", "adv_14-s008": "しかし今回は、研究者たちは調査のいつもの手順を逆さまにしました。", "adv_14-s009": "通常はまず、画像の中から調べる天体を選び、それからその光を詳しく分析します。", "adv_14-s010": "これは、「招待客のリストを作り、一人ずつ話をする」ようなものです。", "adv_14-s011": "今回は、その逆を行いました。", "adv_14-s012": "リストに頼るのではなく、届いた声をたどって、その発生源を見つけようとしました。", "adv_14-s013": "観測した領域では、すでに知られているいくつかの天体と重なる小さな窓を閉じ、その他のほとんどは開いたままにしました。", "adv_14-s014": "特定の波長に現れる光の線を探しました。", "adv_14-s015": "これは宇宙全体を探すものではありませんでしたが、その領域では、画像に写っている天体だけを候補にするという決まりを取り払いました。"}, "complete": true, "paragraphs": 3, "paragraphs_translated": 3, "failures": [], "api_calls": {"translate": 1, "verify": 1}, "wall_s": 8.64, "cost_jpy": 0.1056, "calls": [{"kind": "translate", "wall_s": 5.47, "cost_jpy": 0.0682, "usage": {"input_tokens": 1274, "output_tokens": 598, "cached_input_tokens": 0, "reasoning_tokens": 237}}, {"kind": "verify", "wall_s": 3.16, "cost_jpy": 0.0374, "usage": {"input_tokens": 832, "output_tokens": 301, "cached_input_tokens": 0, "reasoning_tokens": 202}}]}

{"unit": "family_z_melos_kphr_evidence_r3/adv/adv_10", "cond": "C", "split": "dev", "slug": "family_z_melos_kphr_evidence_r3", "level": "adv", "family": "Z", "parts": [{"part": "adv_10", "kind": "story", "stratum": "gen", "sids": ["adv_10-s004", "adv_10-s005", "adv_10-s006", "adv_10-s007", "adv_10-s008", "adv_10-s009", "adv_10-s010", "adv_10-s011", "adv_10-s012", "adv_10-s013", "adv_10-s014", "adv_10-s015", "adv_10-s016", "adv_10-s017", "adv_10-s018", "adv_10-s019", "adv_10-s020", "adv_10-s021", "adv_10-s022", "adv_10-s023"]}], "ctx_sentences": 5, "ctx_chars": 370, "double_ctx_block": true, "ja": {"adv_10-s004": "メロスの声が広間に響き渡った。", "adv_10-s005": "お前たちは人々を恐れているから、人々を殺すのだ。", "adv_10-s006": "彼らに話すことさえ許さない。", "adv_10-s007": "その後、沈黙が訪れた。", "adv_10-s008": "それから衛兵たちは若い羊飼いを捕らえ、支配者は彼に死刑を宣告した。", "adv_10-s009": "「三日間、時間をくれ。」", "adv_10-s010": "メロスは言った。", "adv_10-s011": "「私の姉妹が結婚する。」", "adv_10-s012": "「彼女の結婚式を見届けさせてくれ。」", "adv_10-s013": "「私は戻る。」", "adv_10-s014": "支配者は笑みを浮かべた。", "adv_10-s015": "「お前の友人はここに残る。", "adv_10-s016": "お前が遅れたら、代わりに彼が死ぬ。」", "adv_10-s017": "メロスは友人のほうを向いたが、彼が口を開く前に、友人は鎖につなぐよう両手を差し出した。", "adv_10-s018": "「行け。」", "adv_10-s019": "「お前が戻ってくると分かっている。」", "adv_10-s020": "結婚式では、妹の笑い声がほかの人たちの声よりも高く響いた。", "adv_10-s021": "メロスは注意深く耳を傾けた。", "adv_10-s022": "彼は、その声がどんなふうに聞こえたかを正確に覚えておきたかった。", "adv_10-s023": "三日目の夜明け前、彼は都へ向けて出発した。"}, "complete": true, "paragraphs": 11, "paragraphs_translated": 11, "failures": [], "api_calls": {"translate": 2, "verify": 2}, "wall_s": 30.07, "cost_jpy": 0.2753, "calls": [{"kind": "translate", "wall_s": 7.71, "cost_jpy": 0.0781, "usage": {"input_tokens": 685, "output_tokens": 839, "cached_input_tokens": 0, "reasoning_tokens": 370}}, {"kind": "verify", "wall_s": 9.01, "cost_jpy": 0.0935, "usage": {"input_tokens": 895, "output_tokens": 990, "cached_input_tokens": 0, "reasoning_tokens": 781}}, {"kind": "translate", "wall_s": 8.62, "cost_jpy": 0.064, "usage": {"input_tokens": 892, "output_tokens": 622, "cached_input_tokens": 0, "reasoning_tokens": 52
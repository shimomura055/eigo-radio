{"unit": "family_y_production_redelivery_fee_03/adv/adv_05", "cond": "Ap", "split": "dev", "slug": "family_y_production_redelivery_fee_03", "level": "adv", "family": "Y", "parts": [{"part": "adv_05", "kind": "preview", "stratum": "gen", "sids": ["adv_05-s001", "adv_05-s002"]}], "ctx_sentences": 0, "ctx_chars": 0, "double_ctx_block": false, "ja": {"adv_05-s001": "荷物の受け取り損ねは、それを待っている人だけでなく、ほかの人にも影響を及ぼすことがあります。", "adv_05-s002": "このエピソードでは、配送の流れと、配達の受け取り損ねを減らそうとするときに考慮すべきことを見ていきます。"}, "complete": true, "paragraphs": 1, "paragraphs_translated": 1, "failures": [], "api_calls": {"translate": 1, "verify": 1}, "wall_s": 3.63, "cost_jpy": 0.0295, "calls": [{"kind": "translate", "wall_s": 1.89, "cost_jpy": 0.0148, "usage": {"input_tokens": 420, "output_tokens": 101, "cached_input_tokens": 0, "reasoning_tokens": 0}}, {"kind": "verify", "wall_s": 1.75, "cost_jpy": 0.0147, "usage": {"input_tokens": 396, "output_tokens": 105, "cached_input_tokens": 0, "reasoning_tokens": 78}}]}

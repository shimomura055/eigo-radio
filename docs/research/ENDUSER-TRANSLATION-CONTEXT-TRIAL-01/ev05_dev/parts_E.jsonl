{"unit": "family_z_melos_kphr_evidence_r3/adv/adv_10", "cond": "E", "split": "dev", "slug": "family_z_melos_kphr_evidence_r3", "level": "adv", "family": "Z", "parts": [{"part": "adv_10", "kind": "story", "stratum": "gen", "sids": ["adv_10-s004", "adv_10-s005", "adv_10-s006", "adv_10-s007", "adv_10-s008", "adv_10-s009", "adv_10-s010", "adv_10-s011", "adv_10-s012", "adv_10-s013", "adv_10-s014", "adv_10-s015", "adv_10-s016", "adv_10-s017", "adv_10-s018", "adv_10-s019", "adv_10-s020", "adv_10-s021", "adv_10-s022", "adv_10-s023"]}], "ctx_sentences": 9, "ctx_chars": 496, "double_ctx_block": true, "ja": {"adv_10-s004": "メロスの声が広間に響き渡った。", "adv_10-s005": "お前は人々を恐れているから、彼らを殺すのだ。", "adv_10-s006": "彼らに話すことさえ許さない。", "adv_10-s007": "そのあと、沈黙が続いた。", "adv_10-s008": "すると衛兵たちは若い羊飼いを捕らえ、支配者は彼に死刑を宣告した。", "adv_10-s009": "3日間、時間をください。", "adv_10-s010": "メロスは言った。", "adv_10-s011": "妹が結婚するのです。", "adv_10-s012": "妹の結婚式に出させてください。", "adv_10-s013": "必ず戻ってきます。", "adv_10-s014": "支配者はほほ笑んだ。", "adv_10-s015": "お前の友人はここに残る。", "adv_10-s016": "お前が遅れたら、代わりに彼が死ぬ。", "adv_10-s017": "メロスは友人のほうを向いたが、彼が口を開く前に、友人は鎖をかけてもらうために両手を差し出した。", "adv_10-s018": "行け。", "adv_10-s019": "お前が戻ってくると信じている。", "adv_10-s020": "結婚式では、彼の姉か妹の笑い声がほかの声よりもひときわよく響いていた。", "adv_10-s021": "メロスは注意深く耳を傾けた。", "adv_10-s022": "彼はそれがどんな響きだったかを正確に覚えておきたかった。", "adv_10-s023": "三日目の夜明け前、彼は街へ向けて出発した。"}, "complete": true, "paragraphs": 11, "paragraphs_translated": 11, "failures": [], "api_calls": {"translate": 2, "verify": 2}, "wall_s": 28.18, "cost_jpy": 0.2573, "calls": [{"kind": "translate", "wall_s": 10.84, "cost_jpy": 0.1035, "usage": {"input_tokens": 715, "output_tokens": 1151, "cached_input_tokens": 0, "reasoning_tokens": 697}}, {"kind": "verify", "wall_s": 6.71, "cost_jpy": 0.0572, "usage": {"input_tokens": 883, "output_tokens": 539, "cached_input_tokens": 0, "reasoning_tokens": 338}}, {"kind": "translate", "wall_s": 8.22, "cost_jpy": 0.0782, "usage": {"input_tokens": 857, "output_tokens": 806, "cached_input_tokens": 0, "reasoning_tokens": 680}}, 
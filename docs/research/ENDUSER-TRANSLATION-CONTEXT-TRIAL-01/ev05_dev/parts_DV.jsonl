{"unit": "family_x_moon_shrinking_reselect_01/adv/adv_15", "cond": "DV", "split": "dev", "slug": "family_x_moon_shrinking_reselect_01", "level": "adv", "family": "X", "parts": [{"part": "adv_15", "kind": "comment", "stratum": "gen", "sids": ["adv_15-s018", "adv_15-s019"]}], "ctx_sentences": 48, "ctx_chars": 3793, "double_ctx_block": false, "ja": {"adv_15-s018": "月の崖から、研究チームは月がどれくらい縮んだかを推定できました。", "adv_15-s019": "では、その推定は月の歴史全体を対象にしているのでしょうか？"}, "complete": true, "paragraphs": 1, "paragraphs_translated": 1, "failures": [], "api_calls": {"translate": 1, "verify": 1}, "wall_s": 3.83, "cost_jpy": 0.0348, "calls": [{"kind": "translate", "wall_s": 1.73, "cost_jpy": 0.0077, "usage": {"input_tokens": 1322, "output_tokens": 69, "cached_input_tokens": 1319, "reasoning_tokens": 0}}, {"kind": "verify", "wall_s": 2.1, "cost_jpy": 0.0271, "usage": {"input_tokens": 1281, "output_tokens": 82, "cached_input_tokens": 0, "reasoning_tokens": 55}}]}

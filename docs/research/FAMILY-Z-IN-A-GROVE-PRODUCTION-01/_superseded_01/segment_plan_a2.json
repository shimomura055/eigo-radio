    },
    {
      "id": "full_story_part1_c3",
      "part": 1,
      "voice": "woodcutter",
      "speaker": "woodcutter",
      "voice_role": "dialogue:woodcutter",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "\"He had one stab wound in his chest. His blood had dried. No sword or bow, sir, just rope under a cedar and a comb. The broken bamboo showed a fight.\"",
      "text_sha256": "7a62017c6055e62496476083fa8edac44a350ff7ceb967e981573d63581f9729",
      "word_count": 31,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part1_c3.wav"
    },
    {
      "id": "full_story_part1_c4",
      "part": 1,
      "voice": "monk",
      "speaker": "monk",
      "voice_role": "dialogue:monk",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "\"I saw them yesterday at noon,\"",
      "text_sha256": "2627ea08364da516854c7c8f180566746c7b82e0fd709755a17a62d6304dcc6d",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part1_c4.wav"
    },
    {
      "id": "full_story_part1_c5",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "the monk said.",
      "text_sha256": "a09f91548782ec2ce1d50da913038ecc7b86438b97fab7667d4aab90069df2d3",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part1_c5.wav"
    },
    {
      "id": "full_story_part1_c6",
      "part": 1,
      "voice": "monk",
      "speaker": "monk",
      "voice_role": "dialogue:monk",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "\"The man carried weapons, and his wife rode beside him with her face covered.\"",
      "text_sha256": "44e732eb6432581bdb378f81351e8a106df23af2b9950dc275618208007903e7",
      "word_count": 14,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part1_c6.wav"
    },
    {
      "id": "full_story_part1_c7",
      "part": 1,
      "voice": "constable",
      "speaker": "constable",
      "voice_role": "dialogue:constable",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"I caught Tajomaru, the famous bandit,\"",
      "text_sha256": "e838530e44c76ad6192e0a9eb0191c0032e28f8df7f228de4c2a254d86fdfaf4",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part1_c7.wav"
    },
    {
      "id": "full_story_part1_c8",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "the constable said.",
      "text_sha256": "efe818a3cefc925066630245a2de004403f82c84348b41567e6d085aaea82bb5",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part1_c8.wav"
    },
    {
      "id": "full_story_part1_c9",
      "part": 1,
      "voice": "constable",
      "speaker": "constable",
      "voice_role": "dialogue:constable",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"He had Takehiro's bow. Find the wife, and she'll tell you what he did.\"",
      "text_sha256": "cf0855153bfd0f465f97cf83d23d9c355aeb7603ec22199d84f674084aa709e3",
      "word_count": 14,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part1_c9.wav"
    },
    {
      "id": "full_story_part1_c10",
      "part": 1,
      "voice": "old_woman",
      "speaker": "old_woman",
      "voice_role": "dialogue:old_woman",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "\"Takehiro was my daughter's husband, a kind samurai,\"",
      "text_sha256": "7f6c5be435e9f0b9026218156556de35cd05c30c7606ebf74518ab2be838bb71",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part1_c10.wav"
    },
    {
      "id": "full_story_part1_c11",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "the old woman said.",
      "text_sha256": "7d08b066a9a18c0974874f621f2f8fc88e9fc9409d9e513c46ce5668b2fe88ec",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part1_c11.wav"
    },
    {
      "id": "full_story_part1_c12",
      "part": 1,
      "voice": "old_woman",
      "speaker": "old_woman",
      "voice_role": "dialogue:old_woman",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "\"Masago is nineteen. Please find her before I go home without news.\"",
      "text_sha256": "4753a6b0adfbf3a22d483783439997ea23bc3c9b48039b22ea021b0a787d00a6",
      "word_count": 12,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part1_c12.wav"
    },
    {
      "id": "full_story_part2_c1",
      "part": 2,
      "voice": "tajomaru",
      "speaker": "tajomaru",
      "voice_role": "dialogue:tajomaru",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "\"I killed him, but listen before calling me a coward,\"",
      "text_sha256": "0f1262a22ad10d6fe2d487eaab302c1c89e6c249740d47d37b7afe21d61b5b64",
      "word_count": 10,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part2_c1.wav"
    },
    {
      "id": "full_story_part2_c2",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "Tajomaru said. \"The wind lifted her veil, and I wanted her. I led him into the bushes with promises of buried treasure. There, I tied him to the cedar. She fought with her dagger, but I forced her to have sex with me.",
      "text_sha256": "0146239545b0c8e451d58c5a36ccd52c8b3c83778b7108696996ca78475b601c",
      "word_count": 43,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part2_c2.wav"
    },
    {
      "id": "full_story_part2_c3",
      "part": 2,
      "voice": "tajomaru",
      "speaker": "tajomaru",
      "voice_role": "dialogue:tajomaru",
      "paragraph_index": 5,
      "source_paragraph_indices": [
        5
      ],
      "text": "\"She grabbed my arm and said one of us must die. She would leave with the man who lived. I untied him, and we fought fairly with swords. He lasted twenty-three strokes, but nobody else had reached twenty. When he fell, she'd disappeared. I took his weapons and went away.\"",
      "text_sha256": "53241c41ce0fd5a4cdea0ce21ed5e07fde748ee3b943d8f0fe0ef5ee815d8a70",
      "word_count": 50,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part2_c3.wav"
    },
    {
      "id": "full_story_part2_c4",
      "part": 2,
      "voice": "masago",
      "speaker": "masago",
      "voice_role": "dialogue:masago",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "\"After the bandit left, I crawled towards my husband,\"",
      "text_sha256": "9569bdf88f8a5eece4b13d368955f66977626647044bb5b35d5a73244a8fb8c1",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part2_c4.wav"
    },
    {
      "id": "full_story_part2_c5",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6,
        7
      ],
      "text": "Masago said at the temple. \"He was still tied to the tree. I asked him to die with me. His cold eyes looked down on me, his own wife. \"The dagger was in my hand. His lips moved, telling me to kill him. I stabbed him because I couldn't bear those eyes.",
      "text_sha256": "ebfd28ed81f73b5f09ab7f8a4304064208d809b5b7394998062c026b55fdc142",
      "word_count": 52,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part2_c5.wav"
    },
    {
      "id": "full_story_part2_c6",
      "part": 2,
      "voice": "masago",
      "speaker": "masago",
      "voice_role": "dialogue:masago",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "\"I tried drowning myself later, but I couldn't even do that. Where can I go from here?\"",
      "text_sha256": "098b4784075b2dad44948fc344471fe94319418a5908ea893c2711809ddd910a",
      "word_count": 17,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part2_c6.wav"
    },
    {
      "id": "full_story_part3_c1",
      "part": 3,
      "voice": "takehiro",
      "speaker": "takehiro",
      "voice_role": "dialogue:takehiro",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "\"I heard the bandit trying to comfort her,\"",
      "text_sha256": "cb7fbecbfcaca23a365e615cfa1f01b48aaed041d772b8bfacb1c222521a7530",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part3_c1.wav"
    },
    {
      "id": "full_story_part3_c2",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9,
        10,
        11,
        12
      ],
      "text": "Takehiro's spirit said through a medium. \"My wife asked him to take her anywhere. Then she pointed at me and said, 'You must kill him.' \"He pushed her away and asked me to decide. Should he let her live, or should she die? I almost forgave him for that, but she ran away. He cut one rope, then left. \"I stood up beside the cedar and picked up her small dagger. She had dropped it there. Then I pushed it into my chest. \"The bushes around me became silent. Then someone came towards me with slow, quiet steps. A hand I couldn't see quietly pulled the dagger from my chest.",
      "text_sha256": "f617b7ba39ab2a3e91b3e7a65ee082984070c8a0860a7e32f19ec8f708bde2bf",
      "word_count": 110,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/a2/narration/full_story_part3_c2.wav"
    },
    {
      "id": "full_story_part3_c3",
      "part": 3,
      "voice": "takehiro",
      "speaker": "takehiro",
      "voice_role": "dialogue:takehiro",
      "paragraph_index": 13,
      "source_paragraph_indices": [
        13
      ],
      "text": "\"Then I sank into darkness and stayed there for ever.\"",
      "text_sha256": "19f54dbff293449809827f6ae419a4fd9ff975247f43dae1ffac988224f8a663",
      "word_count": 10,
      "split_reason": "article_end(直前の分割点から続く同一Voice区間)",
      "warnings": [],

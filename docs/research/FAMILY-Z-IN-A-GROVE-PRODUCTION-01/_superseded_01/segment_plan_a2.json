      "voice_role": "dialogue:woodcutter",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "\"This morning, I found a body in the bushes,\"",
      "text_sha256": "250ff04008324e23f220930fe600ee92b02a046aea87a6319d31c7709134e0d2",
      "word_count": 9,

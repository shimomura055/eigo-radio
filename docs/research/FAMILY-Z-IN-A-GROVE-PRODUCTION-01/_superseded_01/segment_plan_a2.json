      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "the woodcutter said.",
      "text_sha256": "8ed92eed78263196a2f5744da604acb33f62a7cff3d9334ef3bffb57c39fbba2",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],

    "y_voice_2": {
      "parent_id": "y_voice_2",
      "family": "Y",
      "planner_version": "chunk_tts_v1_x_paragraph_z_r1_20261025",
      "parent_text_sha256": "13a1558012652e03bc3154726a0f29e7d515cb59f2d3f183fae5289d0203960d",
      "chunked": true,
      "extra_pause_seconds": 0.2,
      "parent_words": 157,
      "chunks": [
        {
          "chunk_id": "y_voice_2_k1",
          "index": 1,
          "text": "Having to pay for a redelivery just doesn’t feel right to me. My husband and I are both away at work. So, when we can choose a delivery time, we choose a day and time when we know we’ll be home. But once, I chose a morning time, and the package did not come.",
          "words": 54,
          "boundary_kind": "paragraph"
        },
        {
          "chunk_id": "y_voice_2_k2",
          "index": 2,
          "text": "I went out to do an errand. When I came back, there was a note saying they had tried to deliver it. There are also many packages where we cannot choose a time. We do not know when they will come, either. Before they charge us, I want them to fix two things: come at the time we chose and tell us when the package will arrive.",
          "words": 67,
          "boundary_kind": "paragraph"
        },
        {
          "chunk_id": "y_voice_2_k3",
          "index": 3,
          "text": "Delivery workers must have a hard time because there are not enough of them. I guess it can’t be helped. But I can’t accept having to pay for that. Am I wrong to feel this way?",
          "words": 36,
          "boundary_kind": "paragraph"
        }
      ],
      "split_method": "X_paragraph_0.2s"
    },

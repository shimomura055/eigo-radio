    {
      "id": "full_story_part1_c1",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "Melos stood before the ruler. He was only a shepherd, but he was not afraid.",
      "text_sha256": "411f00789fb2673d487e4e52e0122312f619172ffe488ef242605243528a7cee",
      "word_count": 15,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part1_c1.wav"
    },
    {
      "id": "full_story_part1_c2",
      "part": 1,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "\"You kill people without asking if they did anything wrong!\"",
      "text_sha256": "084ca984ec7f503e49d4b082ca77d444aa08ba954a262fd0e3e90b7d0cd6d921",
      "word_count": 10,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part1_c2.wav"
    },
    {
      "id": "full_story_part1_c3",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "he shouted.",
      "text_sha256": "c3164fe23ed83c3b1418cc033eacfa9cb9dcda50cfd3cf0d1a7519031b281ec9",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part1_c3.wav"
    },
    {
      "id": "full_story_part1_c4",
      "part": 1,
      "voice": "king",
      "speaker": "king",
      "voice_role": "dialogue:king",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"My guards will kill you too,\"",
      "text_sha256": "ec2e50cfa0e7af820d8adceea6c2694847c09b1ed7d8c6b94821d3eb151e47ef",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part1_c4.wav"
    },
    {
      "id": "full_story_part1_c5",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2,
        3
      ],
      "text": "said the ruler. Melos thought of his sister. Her wedding was tomorrow.",
      "text_sha256": "30ee998e021d6fb58026ff54483a4ffbee3490334a8974d88e3e442c2cca7a51",
      "word_count": 12,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part1_c5.wav"
    },
    {
      "id": "full_story_part1_c6",
      "part": 1,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "\"Give me three days,\"",
      "text_sha256": "8da977f1e7329aa240c434ec6934362e788ca0d9cde1fa34284e009fecab6c11",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part1_c6.wav"
    },
    {
      "id": "full_story_part1_c7",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "he said.",
      "text_sha256": "0669e82b2925c89aa39333900dd53b5eddf64c21d53190788d892d0e0af37799",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part1_c7.wav"
    },
    {
      "id": "full_story_part1_c8",
      "part": 1,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4,
        5
      ],
      "text": "\"I promise to return.\" \"What if you run away?\"",
      "text_sha256": "33be37cbcc155e035d5f1862fb50d07572b3483e0bad89a3f56169c01c9aa422",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part1_c8.wav"
    },
    {
      "id": "full_story_part1_c9",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "His friend stepped forward.",
      "text_sha256": "f3f652b9d60bfac005c572b8d447bd4a5a03e2f9b440159ece455b637d26a892",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part1_c9.wav"
    },
    {
      "id": "full_story_part1_c10",
      "part": 1,
      "voice": "friend",
      "speaker": "friend",
      "voice_role": "dialogue:friend",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "\"Keep me here. I trust him.\"",
      "text_sha256": "9fc6b47ee4fe56bcab8398b6683f579d705e3dce46b520b166c512f4c793ce79",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part1_c10.wav"
    },
    {
      "id": "full_story_part1_c11",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "The ruler smiled.",
      "text_sha256": "09ef5b94a5432c31b9162de3f23239c9359c05d7383d13a9f9190787185d6429",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part1_c11.wav"
    },
    {
      "id": "full_story_part1_c12",
      "part": 1,
      "voice": "king",
      "speaker": "king",
      "voice_role": "dialogue:king",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "\"If you are not back by sunset on the third day, your friend will die.\"",
      "text_sha256": "f35599c033bbe44af61afd51051ee29c0cb382b0c515a5f496bc77af45273b83",
      "word_count": 15,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part1_c12.wav"
    },
    {
      "id": "full_story_part2_c1",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "Melos looked at his friend.",
      "text_sha256": "6452da5349eccb5785d1db401c030e6a8f497215fec5dccf6d370ce93d676d14",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part2_c1.wav"
    },
    {
      "id": "full_story_part2_c2",
      "part": 2,
      "voice": "friend",
      "speaker": "friend",
      "voice_role": "dialogue:friend",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "\"I will wait,\"",
      "text_sha256": "e7c88fa5708dc94aa1d60b6da7b2d0cbc2fe78dc1faf928a8fdd9021feaa5b67",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part2_c2.wav"
    },
    {
      "id": "full_story_part2_c3",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9,
        10,
        11,
        12,
        13,
        14,
        15
      ],
      "text": "his friend said. After the wedding, Melos started back. Rain fell hard all night. By morning, dark water covered the bridge. He could not wait. His friend's life depended on him. Melos jumped into the river. The water pulled him under. He fought to reach the other side. At last, he caught a tree branch and pulled himself out. Cold and wet, he ran on. Three men blocked the road.",
      "text_sha256": "73ac0602ee8e2786aec7c16757f7cf2e9fa2758d3ed780f6c83db087a28ea58c",
      "word_count": 70,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part2_c3.wav"
    },
    {
      "id": "full_story_part2_c4",
      "part": 2,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 16,
      "source_paragraph_indices": [
        16,
        17
      ],
      "text": "\"Give us your money!\" \"I have none!\"",
      "text_sha256": "0f713d163c039440e7f4593e31b3437bfe38be23228b53eab72f18276086869d",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part2_c4.wav"
    },
    {
      "id": "full_story_part2_c5",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 18,
      "source_paragraph_indices": [
        18,
        19
      ],
      "text": "One man hit him with a stick. Melos pushed past him and ran. The men shouted behind him. Soon his legs shook. He could hardly move. He fell beside the road.",
      "text_sha256": "5b6c2f47158193a7f6d964414b4d00aa7d73cea6ce6f32582ca73915beafe781",
      "word_count": 31,
      "split_reason": "comment_or_scene_boundary(呼び出し側指定のforce_split_before_paragraphs)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part2_c5.wav"
    },
    {
      "id": "full_story_part3_c1",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 20,
      "source_paragraph_indices": [
        20,
        21,
        22
      ],
      "text": "The sun was low. He could rest here. He could stay alive. But his friend would die.",
      "text_sha256": "a3730903e8861965e5739fbfd7eb184bfdb03c024c162582cb5f557e7defd6d2",
      "word_count": 17,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part3_c1.wav"
    },
    {
      "id": "full_story_part3_c2",
      "part": 3,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23
      ],
      "text": "\"Why did I make that promise?\"",
      "text_sha256": "5f92f09fd005754f145ad48b0a75e3e3bd885ca7bb80ee06b3b8754c86bd487e",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part3_c2.wav"
    },
    {
      "id": "full_story_part3_c3",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23,
        24,
        25
      ],
      "text": "he whispered. He closed his eyes. For a moment, he wanted to forget everything. Then he remembered his friend's face.",
      "text_sha256": "e89af7ebf200083bebdb94cd754e12da28c655a5c16e3275c2eb62c4abd084bc",
      "word_count": 20,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part3_c3.wav"
    },
    {
      "id": "full_story_part3_c4",
      "part": 3,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 26,
      "source_paragraph_indices": [
        26
      ],
      "text": "\"I will wait.\"",
      "text_sha256": "efa2ac8c6811a10fd5f1b1dc1f3a8e93f9a7f4c6ea57ade9cc3dfb7a37754666",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part3_c4.wav"
    },
    {
      "id": "full_story_part3_c5",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 27,
      "source_paragraph_indices": [
        27,
        28,
        29,
        30
      ],
      "text": "Melos opened his eyes. Water ran between some stones nearby. He drank and slowly stood up. His friend was still waiting. He began to run again. When he reached the city square, a guard was lifting his sword. His friend stood with his hands tied.",
      "text_sha256": "9e9e8775aacdf0b77d26af16c2c786b02f4853467496760ca238842ab22b67e7",
      "word_count": 45,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part3_c5.wav"
    },
    {
      "id": "full_story_part3_c6",
      "part": 3,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 31,
      "source_paragraph_indices": [
        31
      ],
      "text": "\"Stop!\"",
      "text_sha256": "2dfb7fbd26d9570a37f2a4b6cb4908b3d4d61e0bd312f03e489297def1d32061",
      "word_count": 1,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part3_c6.wav"
    },
    {
      "id": "full_story_part3_c7",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 31,
      "source_paragraph_indices": [
        31
      ],
      "text": "Melos cried.",
      "text_sha256": "65c5ea86cfdeb205f2e5044e48f11465feffcd2298389e40815ff63aa3da0ba3",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_mock/b1b/narration/full_story_part3_c7.wav"
    },
    {
      "id": "full_story_part3_c8",
      "part": 3,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 31,
      "source_paragraph_indices": [
        31
      ],
      "text": "\"I'm here!\"",
      "text_sha256": "078d10998c5115a48c58e652669c850ab40840835055f42aa1eaca690438adb7",
      "word_count": 2,

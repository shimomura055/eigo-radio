    {
      "id": "full_story_part3_c1",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 29,
      "source_paragraph_indices": [
        29,
        30,
        31,
        32,
        33,
        34
      ],
      "text": "His friend was waiting now, listening for footsteps. Melos lifted his head. A little water flowed between nearby stones. He drank, pushed himself onto his knees, and stood. His legs shook beneath him. He began to run again. The sun was sinking when he reached the city. He forced his way through the crowd. His friend stood with his wrists tied. The executioner raised his sword.",
      "text_sha256": "fe2a6241dceb28d46f008aef17a5d76c0bd6de608b08eb33da3eb4e309e79841",
      "word_count": 66,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_01/b1b/narration/full_story_part3_c1.wav"
    },

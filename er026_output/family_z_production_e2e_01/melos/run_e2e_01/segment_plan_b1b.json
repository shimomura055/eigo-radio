      "voice": "friend",
      "speaker": "friend",
      "voice_role": "dialogue:friend",
      "paragraph_index": 28,
      "source_paragraph_indices": [
        28
      ],
      "text": "\"I'll wait.\"",
      "text_sha256": "1ec3432d37779e1a1d9405be99343b9bdbdb2b0fe0a1fa3e090f332e21be53d9",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_01/b1b/narration/full_story_part2_c3.wav"

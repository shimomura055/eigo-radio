      "speaker": "king",
      "voice_role": "dialogue:king",
      "paragraph_index": 46,
      "source_paragraph_indices": [
        46
      ],
      "text": "\"Could you teach me to trust?\"",
      "text_sha256": "d1d389a5b4870ad427023956ebcef4225fd7e35a3377945ca4b935faec01de5d",
      "word_count": 6,

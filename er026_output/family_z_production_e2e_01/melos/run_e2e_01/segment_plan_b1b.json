      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_01/b1b/narration/full_story_part3_c2.wav"
    },
    {
      "id": "full_story_part3_c3",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 36,
      "source_paragraph_indices": [
        36
      ],
      "text": "Melos fell at his friend's feet.",
      "text_sha256": "d2015cd02e2a5637a1b26e58a631ac013f342a2ada7a0f0c9dd4689d20f44dc5",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_01/b1b/narration/full_story_part3_c3.wav"
    },

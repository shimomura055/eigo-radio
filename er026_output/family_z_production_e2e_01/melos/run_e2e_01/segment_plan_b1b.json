      "voice_role": "narrator",
      "paragraph_index": 43,
      "source_paragraph_indices": [
        43,
        44,
        45
      ],
      "text": "he said. Neither friend let go. For the first time, the ruler spoke without giving an order.",
      "text_sha256": "d822eda27cabf40782a3e4e6772879d8e6463fa63bfa78d444bbf160d140c323",
      "word_count": 17,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_01/b1b/narration/full_story_part3_c11.wav"

      "id": "full_story_part3_c6",
      "part": 3,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 40,
      "source_paragraph_indices": [
        40
      ],
      "text": "\"I nearly gave up,\"",
      "text_sha256": "c6673fc03ec9b449dec9c17fe581025f6d6f58a4eab83d6ddaa28c29c6c8137a",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",

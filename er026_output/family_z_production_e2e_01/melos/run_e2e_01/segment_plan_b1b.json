      "id": "full_story_part3_c4",
      "part": 3,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 37,
      "source_paragraph_indices": [
        37
      ],
      "text": "\"I'm here.\"",
      "text_sha256": "7ed95aa0b45f21a1e563e2a07f3c474a3efe5392b6c2877d2dbee1d540edc1d8",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_01/b1b/narration/full_story_part3_c4.wav"
    },
    {
      "id": "full_story_part3_c5",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 38,
      "source_paragraph_indices": [
        38,
        39
      ],
      "text": "The sword stopped. His friend bent over him, laughing and crying. Melos reached up and held him tightly.",
      "text_sha256": "83673c9fd64959c5ee151efb83f85c2c7825330a712e6ace96d821bb8d9c77d0",
      "word_count": 18,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_01/b1b/narration/full_story_part3_c5.wav"
    },

      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 42,
      "source_paragraph_indices": [
        42
      ],
      "text": "Watching their joined hands, the ruler finally ordered the guards to free both men.",
      "text_sha256": "ddf69780d90f0b5e86f4a79f2941aeee2a6c8a6c0bb3c0bb5ee7add6fe9621b8",
      "word_count": 14,

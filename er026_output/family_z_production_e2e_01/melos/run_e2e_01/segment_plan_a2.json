      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 36,
      "source_paragraph_indices": [
        36
      ],
      "text": "He fell down at his friend's feet.",
      "text_sha256": "a983449c18f3cf7b0ac0c3c5bbdb63bec3aa24b74396a6901c4de11d433844d3",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_01/a2/narration/full_story_part3_c3.wav"
    },
    {
      "id": "full_story_part3_c4",
      "part": 3,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 37,
      "source_paragraph_indices": [
        37
      ],
      "text": "\"I've come back!\"",
      "text_sha256": "cdd8e75b8ba2b84fb702f263548251274c3841e8351c8d8ccaff353b585d23d0",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_01/a2/narration/full_story_part3_c4.wav"
    },

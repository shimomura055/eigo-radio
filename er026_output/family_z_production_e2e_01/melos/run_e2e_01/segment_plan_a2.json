      "speaker": "friend",
      "voice_role": "dialogue:friend",
      "paragraph_index": 28,
      "source_paragraph_indices": [
        28
      ],
      "text": "\"I'll wait for you.\"",
      "text_sha256": "8aa7ff45573abba9a7ff3ba70b292000de060b5f90414b2b9835c2fac781844e",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",

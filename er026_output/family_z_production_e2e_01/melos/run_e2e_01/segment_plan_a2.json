      "voice_role": "narrator",
      "paragraph_index": 43,
      "source_paragraph_indices": [
        43,
        44,
        45
      ],
      "text": "he said. Their hands stayed together. For the first time, the ruler's words were not an order.",
      "text_sha256": "21608fd8e89c2931610bc4f1a98343ad88b4b7f17db6c8a10caf7c0a2e2f829a",
      "word_count": 17,

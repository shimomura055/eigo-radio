      "part": 3,
      "voice": "king",
      "speaker": "king",
      "voice_role": "dialogue:king",
      "paragraph_index": 43,
      "source_paragraph_indices": [
        43
      ],
      "text": "\"I thought everyone would save himself,\"",
      "text_sha256": "e2b1afe826fef8a89f6977ce5449ae28e4eeb22c62d77b01d7d76ef4231e902d",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",

      "speaker": "friend",
      "voice_role": "dialogue:friend",
      "paragraph_index": 41,
      "source_paragraph_indices": [
        41
      ],
      "text": "\"You came back, though.\"",
      "text_sha256": "38efcca638e7dafd3ae3036cefecbc6c28024caee801d3116ffb998a4db3f976",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",

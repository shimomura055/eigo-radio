      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 35,
      "source_paragraph_indices": [
        35
      ],
      "text": "\"Wait, please!\"",
      "text_sha256": "5e7de0965729a4436a7442547a15d772271794b319e90c5eda6972dcffafb414",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_01/a2/narration/full_story_part3_c2.wav"
    },

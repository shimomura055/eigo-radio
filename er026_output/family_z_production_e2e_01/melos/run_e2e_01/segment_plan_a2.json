      "part": 3,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 40,
      "source_paragraph_indices": [
        40
      ],
      "text": "\"I almost stopped trying,\"",
      "text_sha256": "bf1b55bf87e877a8a875d96d29a6b37379a350806641beda66feaf3b8043ef0f",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",

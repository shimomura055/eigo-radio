  "clips": [
    {
      "id": "full_story_part1_c1",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "Melos's voice rang through the hall.",
      "text_sha256": "0040a4a152400ed66d656e8f4a245a0887576b044a8a7aa334b1396df77eb92f",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part1_c1.wav"
    },
    {
      "id": "full_story_part1_c2",
      "part": 1,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "\"You kill men because you fear them. You won't even let them speak.\"",
      "text_sha256": "50716093a4e3cddc047beb98df7be1477e354d3c7e390f3165d9a9743bfc907e",
      "word_count": 13,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part1_c2.wav"
    },
    {
      "id": "full_story_part1_c3",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "Silence followed. Then the guards seized the young shepherd, and the ruler sentenced him to death.",
      "text_sha256": "5ae2369bd526a12ebe98f0440f922396291ebb2356f6816ba331696f359786c0",
      "word_count": 16,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part1_c3.wav"
    },
    {
      "id": "full_story_part1_c4",
      "part": 1,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"Give me three days,\"",
      "text_sha256": "8da977f1e7329aa240c434ec6934362e788ca0d9cde1fa34284e009fecab6c11",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part1_c4.wav"
    },
    {
      "id": "full_story_part1_c5",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "Melos said.",
      "text_sha256": "70572ff242a34ec1bb7665d2a0ad851621245a4728fd369f2955027e7ef1edaf",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part1_c5.wav"
    },
    {
      "id": "full_story_part1_c6",
      "part": 1,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"My sister is getting married. Let me see her wedding. I will return.\"",
      "text_sha256": "4900524a5cad07375bef4ae687df427dfdcec666f5dba24a8a26134670b604e5",
      "word_count": 13,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part1_c6.wav"
    },
    {
      "id": "full_story_part1_c7",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "The ruler smiled.",
      "text_sha256": "09ef5b94a5432c31b9162de3f23239c9359c05d7383d13a9f9190787185d6429",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part1_c7.wav"
    },
    {
      "id": "full_story_part1_c8",
      "part": 1,
      "voice": "king",
      "speaker": "king",
      "voice_role": "dialogue:king",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "\"Your friend will stay here. If you are late, he dies instead.\"",
      "text_sha256": "37a5efe342f3efccbf99e1e005dcbf01a8253203329635818dbccb20a59b9596",
      "word_count": 12,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part1_c8.wav"
    },
    {
      "id": "full_story_part1_c9",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "Melos turned to his friend, but before he could speak, his friend held out his hands for the chains.",
      "text_sha256": "33d690babd95aa5f66233122fc0e3219ac8db9a73a56c495697ddecd98599784",
      "word_count": 19,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part1_c9.wav"
    },
    {
      "id": "full_story_part1_c10",
      "part": 1,
      "voice": "friend",
      "speaker": "friend",
      "voice_role": "dialogue:friend",
      "paragraph_index": 5,
      "source_paragraph_indices": [
        5
      ],
      "text": "\"Go. I know you'll come back.\"",
      "text_sha256": "d2140650710ca61202a1f4b4c1565d94b75a25e38fac1256ddce7f9b5c825959",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part1_c10.wav"
    },
    {
      "id": "full_story_part1_c11",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6,
        7
      ],
      "text": "At the wedding, his sister's laughter rose above the other voices. Melos listened closely. He wanted to remember exactly how it sounded. Before dawn on the third day, he left for the city.",
      "text_sha256": "b9c96f9f96e022c53b91d3f0c455b6cb9348437b68d1d1b92b6703caa6470a95",
      "word_count": 33,
      "split_reason": "comment_or_scene_boundary(呼び出し側指定のforce_split_before_paragraphs)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part1_c11.wav"
    },
    {
      "id": "full_story_part2_c1",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8,
        9,
        10,
        11,
        12,
        13,
        14
      ],
      "text": "At the river, he stopped. The bridge was gone. Rain had turned the water brown and violent. He stepped back, ran, and threw himself into the flood. The current pulled him under. He fought toward the light, caught a branch, and dragged himself onto the far bank. Farther along, three men blocked the road. A knife flashed. Melos struck the man holding it with his walking stick and ran uphill, their shouts following him. By afternoon, every step hurt. Blood stained his feet. He fell beside a rock and tried to rise, but his legs would not obey. He could wait here. Someone might find him. He could go home. His friend would die. For one terrible moment, that seemed easier than getting up.",
      "text_sha256": "b82b6283fb4269caba1a5cbd29e07ac19a23163b4b4bd3551f91ebe7f8e9effe",
      "word_count": 124,
      "split_reason": "comment_or_scene_boundary(呼び出し側指定のforce_split_before_paragraphs)",
      "warnings": [
        "soft_max_exceeded(word_count=124, soft_max_words=120)"
      ],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part2_c1.wav"
    },
    {
      "id": "full_story_part3_c1",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 15,
      "source_paragraph_indices": [
        15,
        16,
        17,
        18,
        19
      ],
      "text": "Then he remembered the hands held out for the chains. His friend had trusted him without asking for another promise. Water dripped from a crack in the rock. Melos drank, pushed himself onto his knees, and stood. One step. Another. At the city gates, the execution bell rang. He ran toward the square. Above his friend, the sword was already raised.",
      "text_sha256": "b14691c411d88b948b5a51dd978dac45da0b07848f67c928cea5bbf7605e0c47",
      "word_count": 61,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part3_c1.wav"
    },
    {
      "id": "full_story_part3_c2",
      "part": 3,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 20,
      "source_paragraph_indices": [
        20
      ],
      "text": "\"Stop! I am here!\"",
      "text_sha256": "3f38faca25202fae7af78cade8e4701f8d467b86a0c47e4b6517829885e1cd20",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part3_c2.wav"
    },
    {
      "id": "full_story_part3_c3",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 21,
      "source_paragraph_indices": [
        21
      ],
      "text": "His friend turned. Melos fell against him.",
      "text_sha256": "773c6c519a34b83d6d7d619cd7d0e563b3d275c2a796c7c94f9516264db24ed1",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part3_c3.wav"
    },
    {
      "id": "full_story_part3_c4",
      "part": 3,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 22,
      "source_paragraph_indices": [
        22
      ],
      "text": "\"I nearly abandoned you,\"",
      "text_sha256": "fdc23ea09fb4c816937e6806aae18108cf8de66df15a7dc19a862a3b1bebd4c0",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part3_c4.wav"
    },
    {
      "id": "full_story_part3_c5",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 22,
      "source_paragraph_indices": [
        22
      ],
      "text": "he whispered.",
      "text_sha256": "3a21e5ba50bed160e6c2fd76317abe419305c43b5afa4762baba6f4dd7fb8ae7",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part3_c5.wav"
    },
    {
      "id": "full_story_part3_c6",
      "part": 3,
      "voice": "friend",
      "speaker": "friend",
      "voice_role": "dialogue:friend",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23
      ],
      "text": "\"I nearly stopped believing,\"",
      "text_sha256": "d716a3a826d0c24be4380bd248dfecf64b98ec3884ba1cbd70c3797fe4568e10",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part3_c6.wav"
    },
    {
      "id": "full_story_part3_c7",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23,
        24,
        25
      ],
      "text": "his friend answered. They held each other as the last sunlight touched the walls. The ruler stared at them.",
      "text_sha256": "6ead0c02e7955f49977e08b9cd39fc0dde30ca888c263268ee4ac6ce7de8ed19",
      "word_count": 19,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part3_c7.wav"
    },
    {
      "id": "full_story_part3_c8",
      "part": 3,
      "voice": "king",
      "speaker": "king",
      "voice_role": "dialogue:king",
      "paragraph_index": 26,
      "source_paragraph_indices": [
        26
      ],
      "text": "\"Lower the sword,\"",
      "text_sha256": "f38b1c88f3d0ed14dfb014a10ef8e448dfff636ba34fa5f369ea3619692c2978",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part3_c8.wav"
    },
    {
      "id": "full_story_part3_c9",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 26,
      "source_paragraph_indices": [
        26
      ],
      "text": "he said at last.",
      "text_sha256": "9da4229724b760634cb95fe029597661d252350eb1334c07f5064cf411a3c655",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part3_c9.wav"
    },
    {
      "id": "full_story_part3_c10",
      "part": 3,
      "voice": "king",
      "speaker": "king",
      "voice_role": "dialogue:king",
      "paragraph_index": 26,
      "source_paragraph_indices": [
        26
      ],
      "text": "\"Free them both.\"",
      "text_sha256": "32572eca0082ace86b583fb7836e4714425ebe426fc9f30d5950d9c723774a14",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part3_c10.wav"
    },
    {
      "id": "full_story_part3_c11",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 27,
      "source_paragraph_indices": [
        27
      ],
      "text": "Then, more quietly, he asked,",
      "text_sha256": "058b1857f74ff954dfceaa6d52efb6f337c03431fca5ad88700f2d42bb544a2c",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part3_c11.wav"
    },
    {
      "id": "full_story_part3_c12",
      "part": 3,
      "voice": "king",
      "speaker": "king",
      "voice_role": "dialogue:king",
      "paragraph_index": 27,
      "source_paragraph_indices": [
        27
      ],
      "text": "\"How does a man earn such trust?\"",
      "text_sha256": "cf88e62fce4a9bc4befb3a32cfd87e9d36e4032de9c2d87543b7123c284e247b",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/b1b/narration/full_story_part3_c12.wav"
    },
    {
      "id": "full_story_part3_c13",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 28,
      "source_paragraph_indices": [
        28
      ],
      "text": "For the first time, he waited for an answer instead of ordering one.",
      "text_sha256": "fef82ba320d55a4b86fa47dfebc4a53457dfcbe548236ec8478d72e964f5643b",
      "word_count": 13,
      "split_reason": "article_end(直前の分割点から続く同一Voice区間)",

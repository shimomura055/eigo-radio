  "clips": [
    {
      "id": "full_story_part1_c1",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "Melos called across the hall,",
      "text_sha256": "796b81097e766813b41f291cf829cdd647708cf29e03e65dda07f5df44a774a7",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part1_c1.wav"
    },
    {
      "id": "full_story_part1_c2",
      "part": 1,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "\"You kill men from fear. You never give them a chance to speak.\"",
      "text_sha256": "c14e0042a1f2e8c213bd8d5b61f9ba7bc3632049f79ae3b7a9d0e73630fc903a",
      "word_count": 13,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part1_c2.wav"
    },
    {
      "id": "full_story_part1_c3",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "Silence came, and guards grabbed the young shepherd. The ruler ordered his death.",
      "text_sha256": "b0a58240cdcabccb76c69ecce9c14ab488c2fd8948df7359e52d8c5dd97a57c3",
      "word_count": 13,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part1_c3.wav"
    },
    {
      "id": "full_story_part1_c4",
      "part": 1,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"Give me three days to see my sister's wedding,\"",
      "text_sha256": "c471265321c178da0063c6836cd3df3b8018a0a63e19b273fa74286499ab868b",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part1_c4.wav"
    },
    {
      "id": "full_story_part1_c5",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "Melos said.",
      "text_sha256": "70572ff242a34ec1bb7665d2a0ad851621245a4728fd369f2955027e7ef1edaf",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part1_c5.wav"
    },
    {
      "id": "full_story_part1_c6",
      "part": 1,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"Then I will return to you.\"",
      "text_sha256": "f26a45c5349db76f156a8e1704212dd7597de5b871cb0b8defad3bd9c9ca2cc3",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part1_c6.wav"
    },
    {
      "id": "full_story_part1_c7",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "The ruler smiled and said,",
      "text_sha256": "e94eec7b2b00e3e39f236f1ed6531689214b7a79c407825f6a899475abebfa8f",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part1_c7.wav"
    },
    {
      "id": "full_story_part1_c8",
      "part": 1,
      "voice": "king",
      "speaker": "king",
      "voice_role": "dialogue:king",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "\"Your friend must stay here. Return late, and he will die in your place.\"",
      "text_sha256": "9f55940338b12bc368bb7e80ccb2a0b23a02c2ad6ce8e75c919713faeafaebe9",
      "word_count": 14,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part1_c8.wav"
    },
    {
      "id": "full_story_part1_c9",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "Melos turned to his friend, who offered his hands for the chains. Melos had no time to speak.",
      "text_sha256": "5fa5f216cad875c0cf29758e4a96cf2cb74005a017c240c1319895bd11de3811",
      "word_count": 18,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part1_c9.wav"
    },
    {
      "id": "full_story_part1_c10",
      "part": 1,
      "voice": "friend",
      "speaker": "friend",
      "voice_role": "dialogue:friend",
      "paragraph_index": 5,
      "source_paragraph_indices": [
        5
      ],
      "text": "\"Go now, because I know you will come back.\"",
      "text_sha256": "66c441d0f279c399ed0f74642b348d41d0e1a71fb80c2ebc86121299dd274da5",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part1_c10.wav"
    },
    {
      "id": "full_story_part1_c11",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6,
        7
      ],
      "text": "At the wedding, his sister's laugh rose above everyone's voices. Melos listened closely to remember its exact sound. He left for the city before daylight on day three.",
      "text_sha256": "c7b19503af4f177e6a99e0c487a2221485abd020aacca6c14b2795197751151e",
      "word_count": 28,
      "split_reason": "comment_or_scene_boundary(呼び出し側指定のforce_split_before_paragraphs)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part1_c11.wav"
    },
    {
      "id": "full_story_part2_c1",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8,
        9,
        10,
        11,
        12,
        13,
        14
      ],
      "text": "The river stopped him; its bridge was gone. Rain made the water brown and dangerously fast. He stepped back, ran, and jumped into the flood. The water pulled him under, but he fought toward the light. He grabbed a branch and pulled himself onto the far bank. Later, three men blocked his way, and a knife flashed. He hit the man holding it with his walking stick. He ran uphill as their shouts followed behind him. By afternoon, each step hurt, and his feet were bloody. He fell beside a rock and tried to stand. But his legs would not lift him. He could wait here, and someone might find him. Or he could return home. But his friend would lose his life instead. For one awful moment, that felt easier than standing up.",
      "text_sha256": "1d1cb16024176612b166eaa983524256c91e5e38f8400d2974d46533c489e800",
      "word_count": 134,
      "split_reason": "comment_or_scene_boundary(呼び出し側指定のforce_split_before_paragraphs)",
      "warnings": [
        "soft_max_exceeded(word_count=134, soft_max_words=120)"
      ],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part2_c1.wav"
    },
    {
      "id": "full_story_part3_c1",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 15,
      "source_paragraph_indices": [
        15,
        16,
        17,
        18,
        19
      ],
      "text": "He remembered the hands held out for the chains. His friend trusted him without asking for another promise. Water came slowly through a crack in the rock. Melos drank, got onto his knees, and stood up. He managed one step, then took another. At the city gates, the bell rang for his friend's death. He raced to the square, where the sword was already raised above his friend.",
      "text_sha256": "b6d4377342693cf0925f2f9fbd89faf93c463d6d5b38bbd6c5052f3e62abccf8",
      "word_count": 68,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part3_c1.wav"
    },
    {
      "id": "full_story_part3_c2",
      "part": 3,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 20,
      "source_paragraph_indices": [
        20
      ],
      "text": "\"Stop now! I'm back!\"",
      "text_sha256": "4f537c698436ba68eb127e5ab6011d869ed879db651f2b0e35063e7b81ee8165",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part3_c2.wav"
    },
    {
      "id": "full_story_part3_c3",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 21,
      "source_paragraph_indices": [
        21
      ],
      "text": "His friend turned around, and Melos fell against him.",
      "text_sha256": "b0c3f9f59266c9cd429268ecca920084dbd8fda1b17ce759f55613c76dec75b9",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part3_c3.wav"
    },
    {
      "id": "full_story_part3_c4",
      "part": 3,
      "voice": "melos",
      "speaker": "melos",
      "voice_role": "dialogue:melos",
      "paragraph_index": 22,
      "source_paragraph_indices": [
        22
      ],
      "text": "\"I almost left you to die,\"",
      "text_sha256": "de4281d8e0f9782645685a273e205c4d4366b839210ed61e09bf924906e45606",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part3_c4.wav"
    },
    {
      "id": "full_story_part3_c5",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 22,
      "source_paragraph_indices": [
        22
      ],
      "text": "he said softly.",
      "text_sha256": "88fd2d8932be65c37bb4881e5ef48075205498b1cec866e14606e72c33eeb8b0",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part3_c5.wav"
    },
    {
      "id": "full_story_part3_c6",
      "part": 3,
      "voice": "friend",
      "speaker": "friend",
      "voice_role": "dialogue:friend",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23
      ],
      "text": "\"I almost lost my trust in you,\"",
      "text_sha256": "8425f46525e12faf81d8bd8f58a216510bafbedaa650a68c62cc5554b9660ed5",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part3_c6.wav"
    },
    {
      "id": "full_story_part3_c7",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23,
        24,
        25,
        26
      ],
      "text": "his friend replied. They held each other while the last sun lit the walls. The ruler kept his eyes on them. Finally, he said,",
      "text_sha256": "1f9378251b53911afaaa801151c88e7ba01c3e4f1c0612e2f45c70b56e982e90",
      "word_count": 24,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part3_c7.wav"
    },
    {
      "id": "full_story_part3_c8",
      "part": 3,
      "voice": "king",
      "speaker": "king",
      "voice_role": "dialogue:king",
      "paragraph_index": 26,
      "source_paragraph_indices": [
        26
      ],
      "text": "\"Put the sword down and free both men.\"",
      "text_sha256": "1e319b42dd6ac2849b97ef22a94712e87bea7c6fbcc19a634b6122a2fe6eb88e",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part3_c8.wav"
    },
    {
      "id": "full_story_part3_c9",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 27,
      "source_paragraph_indices": [
        27
      ],
      "text": "More softly, he then asked,",
      "text_sha256": "f96f4a7f3598c017c1b3de70865ce6b10013dbe9f6d72257cd700d0287b1974e",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part3_c9.wav"
    },
    {
      "id": "full_story_part3_c10",
      "part": 3,
      "voice": "king",
      "speaker": "king",
      "voice_role": "dialogue:king",
      "paragraph_index": 27,
      "source_paragraph_indices": [
        27
      ],
      "text": "\"How can a man win such trust?\"",
      "text_sha256": "36e6c2d26092deb3840a262f858e1946b4608672819bfb8152c7f6ee3bbc3287",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part3_c10.wav"
    },
    {
      "id": "full_story_part3_c11",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 28,
      "source_paragraph_indices": [
        28
      ],
      "text": "For once, he waited for a reply instead of demanding one.",
      "text_sha256": "6fbdedd5d10f9fd317dc90509f44b30ad4fd29402e49a6fafffbe74254700196",
      "word_count": 11,
      "split_reason": "article_end(直前の分割点から続く同一Voice区間)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/melos/run_e2e_02/a2/narration/full_story_part3_c11.wav"
    }

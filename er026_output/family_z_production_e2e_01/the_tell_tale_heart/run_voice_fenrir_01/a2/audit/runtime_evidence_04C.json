      "fallback_used": false,
      "fallback_attempts": [],
      "attempt_count": 1,
      "asr_text": "You think I am mad, but I am only nervous. illness made my senses stronger, especially my hearing. I hear everything in heaven and on earth. Listen, and judge how calmly I tell you this. I loved the old man who lived with me. He never hurt me, and I wanted none of his money. But a cloudy film covered his pale blue eye. That vulture's eye made my blood turn cold. I had to get free of it.",
      "status": "OK",
      "z_adoption": "adopted",
      "local_rewrite_diff": null,
      "cooldown_occurred": false,
      "slowdown_applied": true,

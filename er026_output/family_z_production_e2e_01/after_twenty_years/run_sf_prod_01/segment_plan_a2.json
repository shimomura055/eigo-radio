  "clips": [
    {
      "id": "full_story_part1_c1",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0,
        1
      ],
      "text": "Bob waited in the doorway of a closed tool shop. He was out of the rain, and it was nearly ten. He moved his unlit cigar between his teeth and watched the street. Even after twenty years, he still remembered this place. A police officer stopped beside the shop's doorway.",
      "text_sha256": "ed1ad126f7d9e0a89a2ee6d2f50fee05961da7bb33205bb6b9c82023905a000b",
      "word_count": 50,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part1_c1.wav"
    },
    {
      "id": "full_story_part1_c2",
      "part": 1,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"I'm only waiting for a friend,\"",
      "text_sha256": "b80d0250131a34b5516a6bb7a27d6d9f4b9e20f49f3080c3cf5e30f9cb3d8bc1",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part1_c2.wav"
    },
    {
      "id": "full_story_part1_c3",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "Bob told the officer.",
      "text_sha256": "2a8528d9d215a529c69710f9ab0889e1f11798bef28dd4e038745e8a3067e703",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part1_c3.wav"
    },
    {
      "id": "full_story_part1_c4",
      "part": 1,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"There was a restaurant here once.\"",
      "text_sha256": "a6976008c9d808151716d7bb85d3e490b02301ccf4ea5e919ee538ae312194ab",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part1_c4.wav"
    },
    {
      "id": "full_story_part1_c5",
      "part": 1,
      "voice": "patrolman",
      "speaker": "patrolman",
      "voice_role": "dialogue:patrolman",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "\"The restaurant was knocked down five years ago.\"",
      "text_sha256": "1ab1138b33f01af85e3bd57e182a16301b7a97709b07c70b1aec5074f10c5bdd",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part1_c5.wav"
    },
    {
      "id": "full_story_part1_c6",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "Bob struck a match and raised it to his cigar. Its flame made his face bright for a moment.",
      "text_sha256": "70ca7def8327e1418adc6b1119a6e141ef0058db69dd9fd35e5cd2ae9ebd1e39",
      "word_count": 19,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part1_c6.wav"
    },
    {
      "id": "full_story_part1_c7",
      "part": 1,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 5,
      "source_paragraph_indices": [
        5
      ],
      "text": "\"Jimmy and I ate there twenty years ago tonight. We were best friends and grew up like brothers.\"",
      "text_sha256": "84138698b1bfa99b7433ab0faa1e2390fd6d992f9b69f433afea5731a39b84b9",
      "word_count": 18,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part1_c7.wav"
    },
    {
      "id": "full_story_part1_c8",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "Rain hit the street as the officer listened quietly.",
      "text_sha256": "649cb9082292f379f839323be8432c51b6e8914c08d7783750dd86603d972e83",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part1_c8.wav"
    },
    {
      "id": "full_story_part1_c9",
      "part": 1,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "\"I moved West, but Jimmy stayed in New York. For him, no other place was good enough. We promised to meet here tonight at ten, whatever happened.\"",
      "text_sha256": "1f6e5c32c714c667c62409de5382b0e16d19469a5e1f2ed3b86fac7efe7ac7d4",
      "word_count": 27,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part1_c9.wav"
    },
    {
      "id": "full_story_part2_c1",
      "part": 2,
      "voice": "patrolman",
      "speaker": "patrolman",
      "voice_role": "dialogue:patrolman",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "\"Do you hear from him these days?\"",
      "text_sha256": "b11cf8d385729f0a2f1f785947bfc1ebc048a08c9901aa8f1aedeb8a083f8db7",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part2_c1.wav"
    },
    {
      "id": "full_story_part2_c2",
      "part": 2,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "\"We lost touch years ago,\"",
      "text_sha256": "91af3d0eaefa7c73df9a4cd58f25c5b7e2ed5f9f0f341a9df318de6b8a8b596f",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part2_c2.wav"
    },
    {
      "id": "full_story_part2_c3",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "Bob said with a smile.",
      "text_sha256": "fb6ac9719658d920e2b74326213e7c22fce91a2363ba56b8e3e04da9849ab788",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part2_c3.wav"
    },
    {
      "id": "full_story_part2_c4",
      "part": 2,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "\"But Jimmy always kept his promises, so he'll come if he's alive.\"",
      "text_sha256": "336c3ae02cd94c3efe0cd437c6cfbe7a83d607d4c2971db12048ad9a6ff4bad6",
      "word_count": 12,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part2_c4.wav"
    },
    {
      "id": "full_story_part2_c5",
      "part": 2,
      "voice": "patrolman",
      "speaker": "patrolman",
      "voice_role": "dialogue:patrolman",
      "paragraph_index": 10,
      "source_paragraph_indices": [
        10
      ],
      "text": "\"How much longer will you stay?\"",
      "text_sha256": "0839a0348a288cdd779374a0fc2419af2246b9956197af5cde9244d4f24d8b4c",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part2_c5.wav"
    },
    {
      "id": "full_story_part2_c6",
      "part": 2,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 11,
      "source_paragraph_indices": [
        11
      ],
      "text": "\"I'll give him thirty minutes.\"",
      "text_sha256": "97047992c70daf9ba82366eab3aa7e8e11d4fac40dfc40ba88de07f180b9d699",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part2_c6.wav"
    },
    {
      "id": "full_story_part2_c7",
      "part": 2,
      "voice": "patrolman",
      "speaker": "patrolman",
      "voice_role": "dialogue:patrolman",
      "paragraph_index": 12,
      "source_paragraph_indices": [
        12
      ],
      "text": "\"Good night, and I hope your friend arrives soon.\"",
      "text_sha256": "5f818350573b2994f05f26221de55ab741a08bd177f7571026bfa6911ec7e4bf",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part2_c7.wav"
    },
    {
      "id": "full_story_part2_c8",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 13,
      "source_paragraph_indices": [
        13,
        14,
        15
      ],
      "text": "The officer continued down the street. Bob leaned back in the doorway, listening for footsteps. He checked his watch, then put it away. After such a long journey, a few minutes hardly mattered. At ten thirty, a tall man in a long overcoat hurried towards Bob.",
      "text_sha256": "4e9bff992795700ccec41d2a6127ee19e267074ae4b5801fdcac2cae44ec79c7",
      "word_count": 46,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part2_c8.wav"
    },
    {
      "id": "full_story_part2_c9",
      "part": 2,
      "voice": "detective",
      "speaker": "detective",
      "voice_role": "dialogue:detective",
      "paragraph_index": 16,
      "source_paragraph_indices": [
        16
      ],
      "text": "\"Bob, is that really you?\"",
      "text_sha256": "49b8a27b1fc26f9a64a5954215ebe5702cb0739696864fd227d72d739e722279",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part2_c9.wav"
    },
    {
      "id": "full_story_part2_c10",
      "part": 2,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 17,
      "source_paragraph_indices": [
        17
      ],
      "text": "\"Jimmy, you're here!\"",
      "text_sha256": "8992d0936ac73dd2d8e185bb232da096b997219dbf39fc748395dc80ef01a3c9",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part2_c10.wav"
    },
    {
      "id": "full_story_part2_c11",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 18,
      "source_paragraph_indices": [
        18,
        19,
        20,
        21
      ],
      "text": "The man held both Bob's hands, and Bob laughed happily. They seemed young again, with their lives still in front of them. They walked away with their arms linked together. Bob eagerly talked about his life, business and money out West. After twenty years, there was so much to tell. They passed a drugstore, and its windows lit their faces. Bob suddenly stopped and pulled his arm away.",
      "text_sha256": "b77963960fd067f92a96945e3559e5cd81887b056a9e707ddf6872cc12f13b7d",
      "word_count": 68,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part2_c11.wav"
    },
    {
      "id": "full_story_part3_c1",
      "part": 3,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 22,
      "source_paragraph_indices": [
        22
      ],
      "text": "\"You can't be Jimmy! A man may look different after twenty years, but his nose won't change.\"",
      "text_sha256": "5aa0019ef5573458703de9ba72c2ac223ec85ef2ccc1914a5285757e09bbf082",
      "word_count": 17,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part3_c1.wav"
    },
    {
      "id": "full_story_part3_c2",
      "part": 3,
      "voice": "detective",
      "speaker": "detective",
      "voice_role": "dialogue:detective",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23
      ],
      "text": "\"Twenty years can turn a good man bad,\"",
      "text_sha256": "7d5bcb48ae321e64fdb32708827875c9b00fd4dc02fdcbb10e28b8bbc22ef319",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part3_c2.wav"
    },
    {
      "id": "full_story_part3_c3",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23
      ],
      "text": "the tall man replied.",
      "text_sha256": "414c90e2da53b01419d04980017f900637d5736dca74f6cfe303ae3ab704ba4f",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part3_c3.wav"
    },
    {
      "id": "full_story_part3_c4",
      "part": 3,
      "voice": "detective",
      "speaker": "detective",
      "voice_role": "dialogue:detective",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23
      ],
      "text": "\"I'm arresting you, Bob, because Chicago's police are looking for you.\"",
      "text_sha256": "f2bc4f1116af1177bad6bb299e3dc341921efd5455c96fdcd1d491208055e556",
      "word_count": 11,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part3_c4.wav"
    },
    {
      "id": "full_story_part3_c5",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 24,
      "source_paragraph_indices": [
        24
      ],
      "text": "Bob looked hard at the man without a word.",
      "text_sha256": "eb3c64402e9ee04bf28c87b6c1b4ee93fa18c70a0864f64fab7087ae338ee2e8",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/a2/narration/full_story_part3_c5.wav"
    },
    {
      "id": "full_story_part3_c6",
      "part": 3,
      "voice": "detective",

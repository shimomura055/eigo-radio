  "clips": [
    {
      "id": "full_story_part1_c1",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0,
        1
      ],
      "text": "Bob stood in the doorway of a closed hardware store, sheltered from the rain. It was almost ten. He shifted his unlit cigar between his teeth and looked down the street. Twenty years was a long time, but he had not forgotten the place. A patrolman stopped beside him.",
      "text_sha256": "b88319b51e4beb5e82c59eefb5e4b15b1654cfda7837f13979c0f776fbe34a89",
      "word_count": 49,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part1_c1.wav"
    },
    {
      "id": "full_story_part1_c2",
      "part": 1,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"Just waiting for a friend,\"",
      "text_sha256": "64def9315d25007459767a92c2a959efe1de465a163f74695041ac0b095cf14a",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part1_c2.wav"
    },
    {
      "id": "full_story_part1_c3",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "Bob explained.",
      "text_sha256": "658d0b519c6e4925afbb4f307b6998752fcee9b9dea709c39c794f48b782b19f",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part1_c3.wav"
    },
    {
      "id": "full_story_part1_c4",
      "part": 1,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"There used to be a restaurant here.\"",
      "text_sha256": "32e21a5cf9c96d8d40a32d0b1ff47eb774b2252117ce9c649a7a619699ad2df7",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part1_c4.wav"
    },
    {
      "id": "full_story_part1_c5",
      "part": 1,
      "voice": "patrolman",
      "speaker": "patrolman",
      "voice_role": "dialogue:patrolman",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "\"They pulled it down five years ago.\"",
      "text_sha256": "f99e8aa604564b8cc091b0751ed4607f6bf06429b06375dc94fb533e6557e8cc",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part1_c5.wav"
    },
    {
      "id": "full_story_part1_c6",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "Bob struck a match. The flame lit his face as he raised it to his cigar.",
      "text_sha256": "467730b7626577a00a587c0b6f705a18b78cacfdd5cb307a0e477d76b523aa05",
      "word_count": 16,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part1_c6.wav"
    },
    {
      "id": "full_story_part1_c7",
      "part": 1,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 5,
      "source_paragraph_indices": [
        5
      ],
      "text": "\"We had our last dinner there twenty years ago tonight. My best friend, Jimmy. We grew up together, like brothers.\"",
      "text_sha256": "7572b7a775eb6b87c47b1fc6852f5225a53648ad3210845807e4782e8d453753",
      "word_count": 20,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part1_c7.wav"
    },
    {
      "id": "full_story_part1_c8",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "The patrolman listened calmly while rain tapped against the pavement.",
      "text_sha256": "62f47a37bb68901c7e0de12f3dd5718284a6f2e19944c648411a18745093c004",
      "word_count": 10,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part1_c8.wav"
    },
    {
      "id": "full_story_part1_c9",
      "part": 1,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "\"I went West,\"",
      "text_sha256": "c631f3313ec3a2af8b60cc52e06887e35cd74caf697e7c02e4cd39aa175c160f",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part1_c9.wav"
    },
    {
      "id": "full_story_part1_c10",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "Bob continued.",
      "text_sha256": "6910e744ccd8e2ba21bf067f744172544006697233e22bb4f7ea7a6a7a85c2e7",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part1_c10.wav"
    },
    {
      "id": "full_story_part1_c11",
      "part": 1,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "\"Jimmy stayed here. He thought New York was the only place worth living. Before we parted, we promised to meet here at ten tonight, whatever happened.\"",
      "text_sha256": "a79779e959ca5904fc0616934e529f12d8a5fd4a24f1ff269696908c35f6224f",
      "word_count": 26,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part1_c11.wav"
    },
    {
      "id": "full_story_part2_c1",
      "part": 2,
      "voice": "patrolman",
      "speaker": "patrolman",
      "voice_role": "dialogue:patrolman",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "\"Have you heard from him?\"",
      "text_sha256": "e301839a38ec85a2f3bfa2ff79886d55f7c5434ae8d3e739296fdb980647f559",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part2_c1.wav"
    },
    {
      "id": "full_story_part2_c2",
      "part": 2,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "\"Not for years. We lost touch.\"",
      "text_sha256": "2c9b83db81c034d2fd4cb9b54193dbc6d48c777665c6025b324cfbee98e004dd",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part2_c2.wav"
    },
    {
      "id": "full_story_part2_c3",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "Bob smiled.",
      "text_sha256": "ad58b55bbe23145775c374ed974c46eaa7bfb28cf8f19c392a35c8755042d2ef",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part2_c3.wav"
    },
    {
      "id": "full_story_part2_c4",
      "part": 2,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "\"Still, a promise meant something to Jimmy. He'll come if he's alive.\"",
      "text_sha256": "e031da6060e093a655a8caa105b9f947022551e237b511ebe43b86f8c121393b",
      "word_count": 12,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part2_c4.wav"
    },
    {
      "id": "full_story_part2_c5",
      "part": 2,
      "voice": "patrolman",
      "speaker": "patrolman",
      "voice_role": "dialogue:patrolman",
      "paragraph_index": 10,
      "source_paragraph_indices": [
        10
      ],
      "text": "\"How long will you wait?\"",
      "text_sha256": "68863ea78e56440c47b66f1b95ab38651fe26f32d177ab9c8d9e51b59d5007aa",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part2_c5.wav"
    },
    {
      "id": "full_story_part2_c6",
      "part": 2,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 11,
      "source_paragraph_indices": [
        11
      ],
      "text": "\"Half an hour.\"",
      "text_sha256": "176b0417f7c389d7156ba80640515f54189c7c351737c9e1df9becd9783c329d",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part2_c6.wav"
    },
    {
      "id": "full_story_part2_c7",
      "part": 2,
      "voice": "patrolman",
      "speaker": "patrolman",
      "voice_role": "dialogue:patrolman",
      "paragraph_index": 12,
      "source_paragraph_indices": [
        12
      ],
      "text": "\"Well, I hope he turns up. Good night.\"",
      "text_sha256": "80cb062f72e67e13cbef19a184f2d215db1f693e842e3dd31b6a9c7ef80b024c",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part2_c7.wav"
    },
    {
      "id": "full_story_part2_c8",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 13,
      "source_paragraph_indices": [
        13,
        14,
        15
      ],
      "text": "The patrolman walked on. Bob leaned against the doorway, listening for footsteps. Once, he took out his watch, then slipped it away again. He had travelled too far to worry about a few minutes. At half past ten, a tall man in a long overcoat hurried towards him.",
      "text_sha256": "c47536151827ef271f4590b0eebb5d74aad6a0cecdf4730b2a362fce3c18d510",
      "word_count": 48,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part2_c8.wav"
    },
    {
      "id": "full_story_part2_c9",
      "part": 2,
      "voice": "detective",
      "speaker": "detective",
      "voice_role": "dialogue:detective",
      "paragraph_index": 16,
      "source_paragraph_indices": [
        16
      ],
      "text": "\"Is that you, Bob?\"",
      "text_sha256": "90395b222b44b64b2309a2d0dbd0211378fd7935307396036fa2978be8489765",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part2_c9.wav"
    },
    {
      "id": "full_story_part2_c10",
      "part": 2,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 17,
      "source_paragraph_indices": [
        17
      ],
      "text": "\"Jimmy!\"",
      "text_sha256": "f238e8d9747b0d195c36e2490277e1deeacbb5ec671dec1fd5482cd2c0208fc9",
      "word_count": 1,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part2_c10.wav"
    },
    {
      "id": "full_story_part2_c11",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 18,
      "source_paragraph_indices": [
        18,
        19,
        20,
        21
      ],
      "text": "The man caught both his hands. Bob laughed with relief. For a moment, they seemed young again, with their whole lives ahead of them. They set off arm in arm. Bob talked eagerly about the West, his business and the money he had made. After twenty years, there was almost too much to say. Then they passed a drugstore. Light from its windows fell across their faces. Bob stopped and pulled his arm free.",
      "text_sha256": "8c5570cd870c6911c663edee248d6ebe49b87c0ccba470b3a82d33aa7201d1ec",
      "word_count": 74,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part2_c11.wav"
    },
    {
      "id": "full_story_part3_c1",
      "part": 3,
      "voice": "bob",
      "speaker": "bob",
      "voice_role": "dialogue:bob",
      "paragraph_index": 22,
      "source_paragraph_indices": [
        22
      ],
      "text": "\"You're not Jimmy. Twenty years can change a man, but not the shape of his nose.\"",
      "text_sha256": "05dd96f184a455295e6c14634dc51b84d57fbd40edc36798b96532b10cee7ac7",
      "word_count": 16,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part3_c1.wav"
    },
    {
      "id": "full_story_part3_c2",
      "part": 3,
      "voice": "detective",
      "speaker": "detective",
      "voice_role": "dialogue:detective",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23
      ],
      "text": "\"They can change a good man into a bad one,\"",
      "text_sha256": "c58f7d8bdaae4d957d306cb912b0f55b19ed4a91348e26afa5026817e535c159",
      "word_count": 10,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part3_c2.wav"
    },
    {
      "id": "full_story_part3_c3",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23
      ],
      "text": "the tall man replied.",
      "text_sha256": "414c90e2da53b01419d04980017f900637d5736dca74f6cfe303ae3ab704ba4f",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/after_twenty_years/run_sf_prod_01/b1b/narration/full_story_part3_c3.wav"
    },
    {
      "id": "full_story_part3_c4",
      "part": 3,
      "voice": "detective",
      "speaker": "detective",
      "voice_role": "dialogue:detective",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23
      ],
      "text": "\"You're under arrest, Bob. You're wanted in Chicago.\"",

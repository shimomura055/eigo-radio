  "clips": [
    {
      "id": "full_story_part1_c1",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "Framton Nuttel felt nervous, even in this quiet sitting room. He kept turning his letter of introduction between his fingers. His doctor wanted him resting quietly in the country, not visiting strangers.",
      "text_sha256": "0bcd576db52e436ab0043e1027b4af7dff8acb39d229eec3b3fde71bb22585b6",
      "word_count": 32,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part1_c1.wav"
    },
    {
      "id": "full_story_part1_c2",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "\"My aunt will come downstairs in a minute,\"",
      "text_sha256": "e4484ad35716e2aec6aa97e1aa23fc38b5e6936bfc7a640c216201e36c28d863",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part1_c2.wav"
    },
    {
      "id": "full_story_part1_c3",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "said the fifteen-year-old sitting opposite him.",
      "text_sha256": "7363f7ff02e5afc08acff566ded57179236a5569ef9a6d51c89b6e0c5a6d9e23",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part1_c3.wav"
    },
    {
      "id": "full_story_part1_c4",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "\"How well do you know her?\"",
      "text_sha256": "7282067f2d92ea2874d2fee25078783cea601957f415b3503b71aae800821012",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part1_c4.wav"
    },
    {
      "id": "full_story_part1_c5",
      "part": 1,
      "voice": "framton",
      "speaker": "framton",
      "voice_role": "dialogue:framton",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"I don't really know anything about her.\"",
      "text_sha256": "3299d7397246396bbcfdb2979827de7521b787a2c20e5df33bd5e500ef51f331",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part1_c5.wav"
    },
    {
      "id": "full_story_part1_c6",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "The girl's eyes turned towards the French window, open onto the lawn.",
      "text_sha256": "86edb53c048d074cf80103bce102c52338ebb924dd445b102c81fcdc4692b0af",
      "word_count": 12,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part1_c6.wav"
    },
    {
      "id": "full_story_part1_c7",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "\"Doesn't that open window seem strange at this time in October?\"",
      "text_sha256": "5f2762db76a58b0da58451585109878bc70cd531936b7a5979fa7d708255f1c7",
      "word_count": 11,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part1_c7.wav"
    },
    {
      "id": "full_story_part1_c8",
      "part": 1,
      "voice": "framton",
      "speaker": "framton",
      "voice_role": "dialogue:framton",
      "paragraph_index": 5,
      "source_paragraph_indices": [
        5
      ],
      "text": "\"Well, the weather's still quite warm,\"",
      "text_sha256": "dba8b5841468899876807445a090b3200e87161899dfa284920f88099a46b000",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part1_c8.wav"
    },
    {
      "id": "full_story_part1_c9",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 5,
      "source_paragraph_indices": [
        5
      ],
      "text": "Framton answered.",
      "text_sha256": "555facbb4e1ea84c00f0bb2084531175253f57a3e46e1411b83574d779b7094d",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part1_c9.wav"
    },
    {
      "id": "full_story_part1_c10",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "\"Her husband and two young brothers went shooting three years ago today. They went outside through that very window.\"",
      "text_sha256": "0cdbb2f6310b7130ce6727238058d1859b4adc3409d32aa7a95eb72dce11e08c",
      "word_count": 19,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part1_c10.wav"
    },
    {
      "id": "full_story_part1_c11",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "For a moment she stopped speaking, and Framton waited.",
      "text_sha256": "8f32216c79ace25bcec998ee643967238defbc87367e971ecd3d39f91524a16d",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part1_c11.wav"
    },
    {
      "id": "full_story_part1_c12",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "\"They never came back from the marsh, where the ground seemed firm. All three sank into deep mud with their little brown spaniel. Nobody ever found their bodies.\"",
      "text_sha256": "8ff5dcaf143651e87f4cd9ee807d5679265f7412f0ea0a99aee64a8e8945646d",
      "word_count": 28,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part1_c12.wav"
    },
    {
      "id": "full_story_part2_c1",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "Framton's fingers stopped turning the letter.",
      "text_sha256": "65fe96547c00e5394bd7255da89684ffe866445dfc6f5ddbbc3fde9d617ffefe",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part2_c1.wav"
    },
    {
      "id": "full_story_part2_c2",
      "part": 2,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 10,
      "source_paragraph_indices": [
        10
      ],
      "text": "\"She expects them back and leaves it open until dark. Her husband wore a white waterproof coat over his shoulders. Her youngest brother sang, 'Oh, brother, why are you jumping?' He always sang that to annoy her.\"",
      "text_sha256": "8cb27cd5ac4a0f829f965d93a009afd0c3dde4ac028f4a957fd34d027853e288",
      "word_count": 37,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part2_c2.wav"
    },
    {
      "id": "full_story_part2_c3",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 11,
      "source_paragraph_indices": [
        11
      ],
      "text": "The girl swallowed hard.",
      "text_sha256": "ec2c95a291eb8e2cc7c93762de2180bc7d110ecf69d4eba28a148105c14ed5a2",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part2_c3.wav"
    },
    {
      "id": "full_story_part2_c4",
      "part": 2,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 12,
      "source_paragraph_indices": [
        12
      ],
      "text": "\"When it starts getting dark, I sometimes almost feel they really will—\"",
      "text_sha256": "4ecd8c7a69133ff77b46194576e0305b418278ee3bb4622a28e84c8144df1b54",
      "word_count": 12,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part2_c4.wav"
    },
    {
      "id": "full_story_part2_c5",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 13,
      "source_paragraph_indices": [
        13,
        14
      ],
      "text": "Then someone opened the door. His host rushed in, saying how sorry she was.",
      "text_sha256": "293239815a9e97e69e390e7b17f1a304904c730d299cfafbc8564b29f6195eae",
      "word_count": 14,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part2_c5.wav"
    },
    {
      "id": "full_story_part2_c6",
      "part": 2,
      "voice": "mrs_sappleton",
      "speaker": "mrs_sappleton",
      "voice_role": "dialogue:mrs_sappleton",
      "paragraph_index": 15,
      "source_paragraph_indices": [
        15
      ],
      "text": "\"I hope you've enjoyed talking to my niece. Is the open window all right with you? My husband and brothers will soon return from shooting. They'll get my carpets so dirty!\"",
      "text_sha256": "0cbe6d28134ffc20b6630c373152da775070353c714dccf4f966c7c0f280dc8b",
      "word_count": 31,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part2_c6.wav"
    },
    {
      "id": "full_story_part2_c7",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 16,
      "source_paragraph_indices": [
        16,
        17
      ],
      "text": "Framton tried to find a safe subject and explained his doctor's orders. He needed complete rest, without any excitement. She listened, but kept looking past him towards the lawn. Suddenly, she looked happy.",
      "text_sha256": "6b4f41a18d13054d46a1c911c6380a280a50e00c131ca9d60a0769918fb0ddec",
      "word_count": 33,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part2_c7.wav"
    },
    {
      "id": "full_story_part2_c8",
      "part": 2,
      "voice": "mrs_sappleton",
      "speaker": "mrs_sappleton",
      "voice_role": "dialogue:mrs_sappleton",
      "paragraph_index": 18,
      "source_paragraph_indices": [
        18
      ],
      "text": "\"They're finally back!\"",
      "text_sha256": "c6ac2bc6a31138a79cc023daf598e6bc6a4f642080aeb7a845460eb87f9c7ebf",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part2_c8.wav"
    },
    {
      "id": "full_story_part2_c9",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 19,
      "source_paragraph_indices": [
        19
      ],
      "text": "The girl watched the window with her mouth slightly open. Framton turned, feeling cold inside.",
      "text_sha256": "9bc10336fcff1510eded30f3de28d31b489fa9e62c2f320dec7c59ea66f1c3f1",
      "word_count": 15,
      "split_reason": "comment_or_scene_boundary(呼び出し側指定のforce_split_before_paragraphs)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part2_c9.wav"
    },
    {
      "id": "full_story_part3_c1",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 20,
      "source_paragraph_indices": [
        20,
        21
      ],
      "text": "Three men with guns were crossing the lawn as darkness came. One wore a white coat over his shoulders, and a tired brown spaniel followed them. A young man's voice called in the evening light.",
      "text_sha256": "ce6b91c170e9a033d9a28bdb6f9c3add36c31f7272d1cf9661c1a918aa0b1755",
      "word_count": 35,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part3_c1.wav"
    },
    {
      "id": "full_story_part3_c2",
      "part": 3,
      "voice": "men",
      "speaker": "men",
      "voice_role": "dialogue:men",
      "paragraph_index": 22,
      "source_paragraph_indices": [
        22
      ],
      "text": "\"Oh, brother, why are you jumping?\"",
      "text_sha256": "b8a50b4e23f0b94a01b3ffee0658c155d5d81265f7b9cbac3aca996442a4b75d",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part3_c2.wav"
    },
    {
      "id": "full_story_part3_c3",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23,
        24
      ],
      "text": "Framton took his hat and stick and ran through the hall. He rushed out of the gate, forcing a passing cyclist into the hedge. The men entered through the open window.",
      "text_sha256": "6134426778f029c3b4c5e1300f8437b1b818bbb3fd6d05ed233f2d22d63a7231",
      "word_count": 31,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part3_c3.wav"
    },
    {
      "id": "full_story_part3_c4",
      "part": 3,
      "voice": "men",
      "speaker": "men",
      "voice_role": "dialogue:men",
      "paragraph_index": 25,
      "source_paragraph_indices": [
        25
      ],
      "text": "\"Who's the man who just ran away?\"",
      "text_sha256": "e3688c1944a2be5677721c5b350efa01cff87b7c2f9c1320be46a0b19b60e47b",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/a2/narration/full_story_part3_c4.wav"
    },
    {
      "id": "full_story_part3_c5",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 25,
      "source_paragraph_indices": [
        25
      ],
      "text": "the husband asked as he cleaned his muddy boots.",
      "text_sha256": "27ebf9a1940764a75db38c5113f25255bb733df1c60e3d0049729678438bc9f4",
      "word_count": 9,

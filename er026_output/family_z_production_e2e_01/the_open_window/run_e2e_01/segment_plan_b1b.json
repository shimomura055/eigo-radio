  "clips": [
    {
      "id": "full_story_part1_c1",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "The drawing room was quiet, but Framton Nuttel could not relax. He turned his letter of introduction between his fingers. His doctor had ordered peace and quiet in the country, not visits to strangers.",
      "text_sha256": "24d6668ad693d3b1b8aaa250478232a025e6a1cc8be0d49e660c065ef9fb608b",
      "word_count": 34,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part1_c1.wav"
    },
    {
      "id": "full_story_part1_c2",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "\"My aunt will be down soon,\"",
      "text_sha256": "93eb38320f6f995ab01e7fd8c89c8b16de69579d22763ee06d2f01360bb9d409",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part1_c2.wav"
    },
    {
      "id": "full_story_part1_c3",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "said the fifteen-year-old girl opposite him.",
      "text_sha256": "3f02da7fa70fb6b8b930a3c012edf263e610c1fff1fd6588da75679eb2c9a360",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part1_c3.wav"
    },
    {
      "id": "full_story_part1_c4",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "\"Do you know much about her?\"",
      "text_sha256": "0de0978dcfe76e5b1f37dcb08eb27ff3c8068cd18a1bce462fefa19e74a41bc3",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part1_c4.wav"
    },
    {
      "id": "full_story_part1_c5",
      "part": 1,
      "voice": "framton",
      "speaker": "framton",
      "voice_role": "dialogue:framton",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"Nothing, really.\"",
      "text_sha256": "b61f33b903a3bdabac9a72cfa7c1ecd4f6898303885651e35eb14f925c103ffa",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part1_c5.wav"
    },
    {
      "id": "full_story_part1_c6",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "Her eyes moved to the French window, open to the lawn.",
      "text_sha256": "ddf4c3f307403b0d39816009707dbdb20a2a78e9822edd2cc6289e047046ba7c",
      "word_count": 11,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part1_c6.wav"
    },
    {
      "id": "full_story_part1_c7",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "\"You may wonder why that's open in October.\"",
      "text_sha256": "8118159e6a527d67f9b43c91de05edfa7491fd6bee3e63bf51241faaa1381385",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part1_c7.wav"
    },
    {
      "id": "full_story_part1_c8",
      "part": 1,
      "voice": "framton",
      "speaker": "framton",
      "voice_role": "dialogue:framton",
      "paragraph_index": 5,
      "source_paragraph_indices": [
        5
      ],
      "text": "\"It's quite warm,\"",
      "text_sha256": "380d98102e3f151d0c2aea9d94222c7e078485d0ec8b5ad7dcb06820854af7df",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part1_c8.wav"
    },
    {
      "id": "full_story_part1_c9",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 5,
      "source_paragraph_indices": [
        5
      ],
      "text": "Framton said.",
      "text_sha256": "deee1a100247699ed1677388cc53f216927f625a87220d575234787b148454e6",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part1_c9.wav"
    },
    {
      "id": "full_story_part1_c10",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "\"Three years ago today, her husband and her two young brothers went shooting. They left through that window.\"",
      "text_sha256": "de9987a604e2d2720ac6a5fa204dcfb4695a253f53d3c7ff98150b49c751fc98",
      "word_count": 18,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part1_c10.wav"
    },
    {
      "id": "full_story_part1_c11",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "She paused, and Framton waited.",
      "text_sha256": "5b73d3e243b98787a6100409b5196e5c679334e40877b4fc7541c82067f6a8fb",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part1_c11.wav"
    },
    {
      "id": "full_story_part1_c12",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "\"They never came back. They crossed the marsh where the ground seemed firm, and all three sank into a bog. Their little brown spaniel went too. The bodies were never found.\"",
      "text_sha256": "6ccb9b70eed86de89644244559c15dd1c78f6caabc1176b2f52c15fad26e7bc8",
      "word_count": 31,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part1_c12.wav"
    },
    {
      "id": "full_story_part2_c1",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "The letter lay still in Framton's hands.",
      "text_sha256": "de41d4cc1128edc918e06defb85539841f0c8798c893a4c1944f41e85c29d76a",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part2_c1.wav"
    },
    {
      "id": "full_story_part2_c2",
      "part": 2,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 10,
      "source_paragraph_indices": [
        10
      ],
      "text": "\"My aunt thinks they'll return. She keeps the window open until dark. Her husband had his white waterproof coat over his shoulders. Her youngest brother sang, 'Oh, brother, why do you bound?' He always did that to annoy her.\"",
      "text_sha256": "1c79abf500de698a6cbb982457dd57e495ef5ceb324d0c3d3730510f4a983045",
      "word_count": 39,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part2_c2.wav"
    },
    {
      "id": "full_story_part2_c3",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 11,
      "source_paragraph_indices": [
        11
      ],
      "text": "The girl swallowed.",
      "text_sha256": "aa61d04a1f5f506bd2e8fce5406862118a0c21e4fc43a64400d07ec151600127",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part2_c3.wav"
    },
    {
      "id": "full_story_part2_c4",
      "part": 2,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 12,
      "source_paragraph_indices": [
        12
      ],
      "text": "\"Sometimes, when it starts getting dark, I almost feel they really will—\"",
      "text_sha256": "fd167f0cd15510047ec34588202da9481a5cb3569487f1507cc250b97750612f",
      "word_count": 12,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part2_c4.wav"
    },
    {
      "id": "full_story_part2_c5",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 13,
      "source_paragraph_indices": [
        13,
        14
      ],
      "text": "The door opened. His hostess hurried in, full of apologies.",
      "text_sha256": "2f5142d93fab7f513e562013a9ad1baee1888c9bb03b59ef88906df07fa2b0b9",
      "word_count": 10,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part2_c5.wav"
    },
    {
      "id": "full_story_part2_c6",
      "part": 2,
      "voice": "mrs_sappleton",
      "speaker": "mrs_sappleton",
      "voice_role": "dialogue:mrs_sappleton",
      "paragraph_index": 15,
      "source_paragraph_indices": [
        15
      ],
      "text": "\"I hope my niece has entertained you. You don't mind the open window? My husband and brothers will be back directly. They've been shooting. Such a mess they'll make of my carpets!\"",
      "text_sha256": "a777dfee43e61e229f7de0074fdb2630b2138f947b56e62a6386718267839d1d",
      "word_count": 32,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part2_c6.wav"
    },
    {
      "id": "full_story_part2_c7",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 16,
      "source_paragraph_indices": [
        16,
        17
      ],
      "text": "Framton struggled to find a safe subject. He explained that his doctor had ordered complete rest and no excitement. She listened, but kept looking past him towards the lawn. Then her face brightened.",
      "text_sha256": "9984d83059f3e5e2529507580e893c9eaba15a24dd24987fcfcbb6f42253d08b",
      "word_count": 33,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part2_c7.wav"
    },
    {
      "id": "full_story_part2_c8",
      "part": 2,
      "voice": "mrs_sappleton",
      "speaker": "mrs_sappleton",
      "voice_role": "dialogue:mrs_sappleton",
      "paragraph_index": 18,
      "source_paragraph_indices": [
        18
      ],
      "text": "\"Here they are at last!\"",
      "text_sha256": "683254957e0875f02f1cf7478fa0f01b962e67f86a0d336cc109b6fe6b30ddb0",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part2_c8.wav"
    },
    {
      "id": "full_story_part2_c9",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 19,
      "source_paragraph_indices": [
        19
      ],
      "text": "The girl stared at the window, her lips parted. A cold feeling spread through Framton as he turned.",
      "text_sha256": "b3ecb4515d55763804292891ab8c2dad12961cd3a11e9f251ed42f3d3af09e2e",
      "word_count": 18,
      "split_reason": "comment_or_scene_boundary(呼び出し側指定のforce_split_before_paragraphs)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part2_c9.wav"
    },
    {
      "id": "full_story_part3_c1",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 20,
      "source_paragraph_indices": [
        20,
        21
      ],
      "text": "Three men were approaching across the darkening lawn, carrying guns. One had a white coat over his shoulders. A tired brown spaniel followed them. A young voice called through the twilight.",
      "text_sha256": "717ad7f226faf40ac7f2f5f5101c289d350f44b53f4eb30e277bafa261c96f01",
      "word_count": 31,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part3_c1.wav"
    },
    {
      "id": "full_story_part3_c2",
      "part": 3,
      "voice": "men",
      "speaker": "men",
      "voice_role": "dialogue:men",
      "paragraph_index": 22,
      "source_paragraph_indices": [
        22
      ],
      "text": "\"Oh, brother, why do you bound?\"",
      "text_sha256": "1cf221e1e124299dbf6a436c91d7d072c817e694fad45d65ed8c65dc4d25edc1",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part3_c2.wav"
    },
    {
      "id": "full_story_part3_c3",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23,
        24
      ],
      "text": "Framton grabbed his hat and stick. He rushed through the hall and out of the gate, forcing a passing cyclist into the hedge. The men stepped through the window.",
      "text_sha256": "9aea4c80f4350147f8f5ccbc4fb2750c0bc7b9207c538988a01e2013aaa4144a",
      "word_count": 29,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part3_c3.wav"
    },
    {
      "id": "full_story_part3_c4",
      "part": 3,
      "voice": "men",
      "speaker": "men",
      "voice_role": "dialogue:men",
      "paragraph_index": 25,
      "source_paragraph_indices": [
        25
      ],
      "text": "\"Who was that running away?\"",
      "text_sha256": "1e4b049f11457180850c862b84587390a1050b9ad95e6093d600f706621b7a5c",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_e2e_01/b1b/narration/full_story_part3_c4.wav"
    },
    {
      "id": "full_story_part3_c5",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 25,
      "source_paragraph_indices": [
        25
      ],
      "text": "asked the husband, wiping his muddy boots.",
      "text_sha256": "702d7f01e52e27782bf1a045838b02b5f3cd33f5491b1fe38da049eae0bfad4e",
      "word_count": 7,

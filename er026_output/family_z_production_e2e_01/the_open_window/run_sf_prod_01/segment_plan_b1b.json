  "clips": [
    {
      "id": "full_story_part1_c1",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "Framton sat on the edge of his chair, turning his letter of introduction between his fingers. His doctor had recommended peace and country air, but visiting strangers was hardly peaceful.",
      "text_sha256": "a2cb35cb21491ed9a3dd5a3e9cc41c6713e1a5d18db1234ee5ebdf062b84a316",
      "word_count": 30,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part1_c1.wav"
    },
    {
      "id": "full_story_part1_c2",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "\"My aunt will be down soon,\"",
      "text_sha256": "93eb38320f6f995ab01e7fd8c89c8b16de69579d22763ee06d2f01360bb9d409",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part1_c2.wav"
    },
    {
      "id": "full_story_part1_c3",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "said Vera, her fifteen-year-old niece.",
      "text_sha256": "86b671b2a3ee5af41990339007532dc9dc8c4ade0eebb55edbcbb1655ef70cd5",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part1_c3.wav"
    },
    {
      "id": "full_story_part1_c4",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "\"Do you know much about her?\"",
      "text_sha256": "0de0978dcfe76e5b1f37dcb08eb27ff3c8068cd18a1bce462fefa19e74a41bc3",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part1_c4.wav"
    },
    {
      "id": "full_story_part1_c5",
      "part": 1,
      "voice": "framton",
      "speaker": "framton",
      "voice_role": "dialogue:framton",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"Almost nothing,\"",
      "text_sha256": "d1281d1c08d374f663dddc0fc6ae4bb140b53bd6990d8b9f98e92d4dcb6fbd8a",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part1_c5.wav"
    },
    {
      "id": "full_story_part1_c6",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2,
        3
      ],
      "text": "he admitted. Vera glanced towards the French window, which stood wide open to the lawn.",
      "text_sha256": "4b1693ec63d375c09f556592d7da8c4c84c84674717109c22a87d3c804f34613",
      "word_count": 15,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part1_c6.wav"
    },
    {
      "id": "full_story_part1_c7",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "\"Her great tragedy happened three years ago today.\"",
      "text_sha256": "a8f78dd1f27a8ede63b09aa782da04dad0549273dfd74cf427c9ad0e1fd49cb6",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part1_c7.wav"
    },
    {
      "id": "full_story_part1_c8",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 5,
      "source_paragraph_indices": [
        5
      ],
      "text": "Framton stopped turning the letter.",
      "text_sha256": "7a7d3ce889598ff84692c3cf61a985a1ba80b57f83b883837c804133d86d6101",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part1_c8.wav"
    },
    {
      "id": "full_story_part1_c9",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "\"Her husband and her two young brothers went out shooting through that window. Their little brown spaniel went with them. They tried to cross a bog, but the ground gave way beneath them. They all disappeared. Their bodies were never found.\"",
      "text_sha256": "a2ae9836f95a8e539fe6419f903dc9372ffaf6c1260b81c79a645cb105aea61f",
      "word_count": 41,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part1_c9.wav"
    },
    {
      "id": "full_story_part1_c10",
      "part": 1,
      "voice": "framton",
      "speaker": "framton",
      "voice_role": "dialogue:framton",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "\"How terrible,\"",
      "text_sha256": "37b9c8cd234b52cbc6d0bc2d86e03d3c92db425b4167af3892b9d91c93d14e26",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part1_c10.wav"
    },
    {
      "id": "full_story_part1_c11",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "Framton murmured.",
      "text_sha256": "51d0ab365f189de7a33bad0a0922e6def2aaf42cde74c57001aa834213682b57",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part1_c11.wav"
    },
    {
      "id": "full_story_part1_c12",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "\"My aunt still thinks they'll come back. She keeps the window open until dark, waiting for them.\"",
      "text_sha256": "e047b193bcaecbf5dd2f7b55d7e9ce0f3171a1e03fb2d3818b0a598cfcf7bd89",
      "word_count": 17,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part1_c12.wav"
    },
    {
      "id": "full_story_part1_c13",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "Vera's voice grew quieter.",
      "text_sha256": "3adc1ad302d2e495237a0b81ca90ad9d70f6efec93d888fb82bacd41324c31d2",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part1_c13.wav"
    },
    {
      "id": "full_story_part1_c14",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "\"Her husband had his white coat over his arm. Her youngest brother was singing, 'Bertie, why do you bound?' He always sang it to tease her.\"",
      "text_sha256": "8b8e7c1d64141eeef6a9c9b85641bb4cbcf314cdf58a853e92f2dc797dc55a9f",
      "word_count": 26,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part1_c14.wav"
    },
    {
      "id": "full_story_part2_c1",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "She looked out across the empty lawn.",
      "text_sha256": "2f80211014d5637cc1367d0c4ac0b1d5bee20593ae41278805f19b5fb2ddfe45",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part2_c1.wav"
    },
    {
      "id": "full_story_part2_c2",
      "part": 2,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 10,
      "source_paragraph_indices": [
        10
      ],
      "text": "\"Sometimes, on evenings like this, I almost expect to see them.\"",
      "text_sha256": "0238f8c30646066a3d95bc632ec0b8f5a3640238bf347b82eefd68ad98b1ccd1",
      "word_count": 11,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part2_c2.wav"
    },
    {
      "id": "full_story_part2_c3",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 11,
      "source_paragraph_indices": [
        11
      ],
      "text": "Before Framton could reply, her aunt hurried into the room.",
      "text_sha256": "b5e180fabc86f01bafb14be68251a7c807cbe6f6c0849adf4af197ad70b8fa6e",
      "word_count": 10,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part2_c3.wav"
    },
    {
      "id": "full_story_part2_c4",
      "part": 2,
      "voice": "mrs_sappleton",
      "speaker": "mrs_sappleton",
      "voice_role": "dialogue:mrs_sappleton",
      "paragraph_index": 12,
      "source_paragraph_indices": [
        12
      ],
      "text": "\"I hope Vera has kept you company! You don't mind the open window? My husband and brothers will be back soon. They've been shooting. Their boots will be covered in mud, of course!\"",
      "text_sha256": "5460d7f49900e6be0e025d6e9c56be6aabac69011ced2ae610071c5375b553e9",
      "word_count": 33,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part2_c4.wav"
    },
    {
      "id": "full_story_part2_c5",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 13,
      "source_paragraph_indices": [
        13,
        14,
        15
      ],
      "text": "Framton felt a chill. So she really was waiting. He began describing his illness, trying to keep his eyes away from the window. His hostess listened with only half her attention. Again and again, she looked past him towards the lawn. Then her face brightened.",
      "text_sha256": "8f8d6c904775183c2017c716e9a7018a6ca344b6ce1946976df30a4547f4e470",
      "word_count": 45,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part2_c5.wav"
    },
    {
      "id": "full_story_part2_c6",
      "part": 2,
      "voice": "mrs_sappleton",
      "speaker": "mrs_sappleton",
      "voice_role": "dialogue:mrs_sappleton",
      "paragraph_index": 16,
      "source_paragraph_indices": [
        16
      ],
      "text": "\"Here they are at last!\"",
      "text_sha256": "683254957e0875f02f1cf7478fa0f01b962e67f86a0d336cc109b6fe6b30ddb0",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part2_c6.wav"
    },
    {
      "id": "full_story_part2_c7",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 17,
      "source_paragraph_indices": [
        17,
        18
      ],
      "text": "Vera stared outside, her eyes wide with horror. Framton turned.",
      "text_sha256": "2d2924ddce0bc01a0648405afb83fdea8a87503e3023a5c7df4acf112c065769",
      "word_count": 10,
      "split_reason": "comment_or_scene_boundary(呼び出し側指定のforce_split_before_paragraphs)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part2_c7.wav"
    },
    {
      "id": "full_story_part3_c1",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 19,
      "source_paragraph_indices": [
        19,
        20
      ],
      "text": "Three figures were crossing the lawn in the fading light, carrying guns. A white coat hung over one man's arm. A brown spaniel followed close behind. Across the quiet garden came a young voice:",
      "text_sha256": "bf672a77cc818c564809fa724d73769c2995ef87aaf1978786a7fa4191112319",
      "word_count": 34,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part3_c1.wav"
    },
    {
      "id": "full_story_part3_c2",
      "part": 3,
      "voice": "men",
      "speaker": "men",
      "voice_role": "dialogue:men",
      "paragraph_index": 21,
      "source_paragraph_indices": [
        21
      ],
      "text": "\"Bertie, why do you bound?\"",
      "text_sha256": "38705718fbe22ef92914a71bbbe63ee63f24c5f2d2134697486e52f931869443",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part3_c2.wav"
    },
    {
      "id": "full_story_part3_c3",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 22,
      "source_paragraph_indices": [
        22,
        23,
        24
      ],
      "text": "Framton could scarcely breathe. The dead were coming towards the house. He grabbed his hat and stick and rushed out. Within seconds, he was running down the drive. The men stepped through the window, muddy and hungry.",
      "text_sha256": "b9bb142ab1857ba10d59d8d17a55ad7bb08d511fcecb55b6ca035a15435de9f3",
      "word_count": 37,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part3_c3.wav"
    },
    {
      "id": "full_story_part3_c4",
      "part": 3,
      "voice": "men",
      "speaker": "men",
      "voice_role": "dialogue:men",
      "paragraph_index": 25,
      "source_paragraph_indices": [
        25
      ],
      "text": "\"Who was that?\"",
      "text_sha256": "e41c6f4231a8140f01bca3f8cc06a6bda1206756d7016e03da0a8843f5c7dba2",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/b1b/narration/full_story_part3_c4.wav"
    },
    {
      "id": "full_story_part3_c5",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 25,

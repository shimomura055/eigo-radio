  "clips": [
    {
      "id": "full_story_part1_c1",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "Framton sat on his chair's edge, turning his letter of introduction. His doctor suggested country air, but visiting strangers brought little peace.",
      "text_sha256": "c94aec84771b2aa1f00671c2c60249ed2f0e4c12f22d5f421a0276bfd1995c8b",
      "word_count": 22,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part1_c1.wav"
    },
    {
      "id": "full_story_part1_c2",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "\"My aunt will join us soon,\"",
      "text_sha256": "354608f49762936f166af02fdc2708e51ebfcbfd75eccb9ba755f1a17ab0c7b9",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part1_c2.wav"
    },
    {
      "id": "full_story_part1_c3",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "said fifteen-year-old Vera.",
      "text_sha256": "2ed8ce66c35359add66be5df4f4fa9529127d80a3fa2b64956f5318baab18b99",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part1_c3.wav"
    },
    {
      "id": "full_story_part1_c4",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "\"How well do you know her?\"",
      "text_sha256": "7282067f2d92ea2874d2fee25078783cea601957f415b3503b71aae800821012",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part1_c4.wav"
    },
    {
      "id": "full_story_part1_c5",
      "part": 1,
      "voice": "framton",
      "speaker": "framton",
      "voice_role": "dialogue:framton",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"I know very little,\"",
      "text_sha256": "955433737a5b546222a98cdbbcd2b39b18f2fc09c4d7ddf17652266c42984226",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part1_c5.wav"
    },
    {
      "id": "full_story_part1_c6",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2,
        3
      ],
      "text": "Framton answered. Vera looked at the wide-open window leading onto the lawn.",
      "text_sha256": "44e332eee4688bb511cd3c9d49ce87850e71d15da4248c9a624200a355f11908",
      "word_count": 12,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part1_c6.wav"
    },
    {
      "id": "full_story_part1_c7",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "\"Something terrible happened to her exactly three years ago today.\"",
      "text_sha256": "fb7599945445ba5806e1699c9c35bee39104050d4140e1cf504c26f51d44c7e0",
      "word_count": 10,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part1_c7.wav"
    },
    {
      "id": "full_story_part1_c8",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 5,
      "source_paragraph_indices": [
        5
      ],
      "text": "The letter lay still in Framton's hands.",
      "text_sha256": "de41d4cc1128edc918e06defb85539841f0c8798c893a4c1944f41e85c29d76a",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part1_c8.wav"
    },
    {
      "id": "full_story_part1_c9",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "\"Her husband and two younger brothers left through that window. They went shooting, taking their small brown spaniel with them. They tried crossing wet ground, but it broke under them. All of them disappeared, and nobody ever found their bodies.\"",
      "text_sha256": "2df605d4aaf3a3c8c7c751dcba488af2d8dc53391aa6a624b60cf0bfb0677dd6",
      "word_count": 40,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part1_c9.wav"
    },
    {
      "id": "full_story_part1_c10",
      "part": 1,
      "voice": "framton",
      "speaker": "framton",
      "voice_role": "dialogue:framton",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "\"How awful,\"",
      "text_sha256": "64b9658d23e31c46ca2a3c6f340ec13c99dd1517e9cabd75361d9533c852c402",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part1_c10.wav"
    },
    {
      "id": "full_story_part1_c11",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "said Framton quietly.",
      "text_sha256": "26b7f3c1cb3a67669f8745005585bf901333da2c8facaaf5e90f89c316c6a522",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part1_c11.wav"
    },
    {
      "id": "full_story_part1_c12",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "\"She still believes they'll return, so she waits until dark. That's why she leaves the window open,\"",
      "text_sha256": "e0927b4f5cd6caae3924eba4bab6be8d03839383973e65abd360508da1b0c631",
      "word_count": 17,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part1_c12.wav"
    },
    {
      "id": "full_story_part1_c13",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "Vera said more quietly.",
      "text_sha256": "c6bca08039effe4161dc5d3cc87c1dc78b540acc54d70f4635f6848b7ae5419d",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part1_c13.wav"
    },
    {
      "id": "full_story_part1_c14",
      "part": 1,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "\"Her husband carried his white coat over his arm. Her youngest brother sang, 'Bertie, why do you bound?' He always sang that song to annoy her.\"",
      "text_sha256": "770b417749530ce97a97cd0eeb5bb25cb315ffa8011d2029ca11b5f97fde1640",
      "word_count": 26,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part1_c14.wav"
    },
    {
      "id": "full_story_part2_c1",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "Her eyes moved across the lawn, but nobody was there.",
      "text_sha256": "3e6af3953e87260b545a0f37de8d1437673a7c70bd326d9b67a9ed0d45cf8e8a",
      "word_count": 10,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part2_c1.wav"
    },
    {
      "id": "full_story_part2_c2",
      "part": 2,
      "voice": "vera",
      "speaker": "vera",
      "voice_role": "dialogue:vera",
      "paragraph_index": 10,
      "source_paragraph_indices": [
        10
      ],
      "text": "\"On evenings like this, I sometimes think they might appear.\"",
      "text_sha256": "e834e931d6bdb803728031c0a4f6e42bb58bca584b3cc164f252a626e311ff4c",
      "word_count": 10,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part2_c2.wav"
    },
    {
      "id": "full_story_part2_c3",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 11,
      "source_paragraph_indices": [
        11
      ],
      "text": "Her aunt came in quickly before Framton could answer her.",
      "text_sha256": "d0afa1d6036867831268658bafbd13b3652099c56e8c0bd3da00ab775428a502",
      "word_count": 10,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part2_c3.wav"
    },
    {
      "id": "full_story_part2_c4",
      "part": 2,
      "voice": "mrs_sappleton",
      "speaker": "mrs_sappleton",
      "voice_role": "dialogue:mrs_sappleton",
      "paragraph_index": 12,
      "source_paragraph_indices": [
        12
      ],
      "text": "\"Has Vera been looking after you? I hope the open window doesn't bother you. My husband and brothers are coming back from shooting soon. Their boots will be muddy, as usual!\"",
      "text_sha256": "f621f84f175c58187eef7f8e2553d6c8d174a576a02c70b619e817eb22d4e9b4",
      "word_count": 31,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part2_c4.wav"
    },
    {
      "id": "full_story_part2_c5",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 13,
      "source_paragraph_indices": [
        13,
        14,
        15
      ],
      "text": "Framton went cold because she really did expect them back. He talked about his health problems and avoided the window. But his hostess hardly listened, often looking past him towards the lawn. Then a happy smile suddenly appeared on her face.",
      "text_sha256": "fcef00de82f90430a12f19a301465c8f9c592cf9aa04e1404178723b7bfb2e36",
      "word_count": 41,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part2_c5.wav"
    },
    {
      "id": "full_story_part2_c6",
      "part": 2,
      "voice": "mrs_sappleton",
      "speaker": "mrs_sappleton",
      "voice_role": "dialogue:mrs_sappleton",
      "paragraph_index": 16,
      "source_paragraph_indices": [
        16
      ],
      "text": "\"Look, they're finally home!\"",
      "text_sha256": "0d060be2558256b95e8f888e972d52b594ef7067edb3671348caa1fd7a50a680",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part2_c6.wav"
    },
    {
      "id": "full_story_part2_c7",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 17,
      "source_paragraph_indices": [
        17,
        18
      ],
      "text": "Vera's eyes opened wide as she looked outside in fear. Framton looked behind him.",
      "text_sha256": "6acccf186b9f0c3bf3d822d4f781633cac79ed75b599824cfc77e6add4bca72c",
      "word_count": 14,
      "split_reason": "comment_or_scene_boundary(呼び出し側指定のforce_split_before_paragraphs)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part2_c7.wav"
    },
    {
      "id": "full_story_part3_c1",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 19,
      "source_paragraph_indices": [
        19,
        20
      ],
      "text": "Three men crossed the lawn with guns as daylight faded. One carried a white coat, and a brown spaniel followed. A young man's voice reached them across the silent garden:",
      "text_sha256": "3cdabecde405ea5833d34804e9bbc6ddf30060903f5f70e06d9a783acdc9642e",
      "word_count": 30,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part3_c1.wav"
    },
    {
      "id": "full_story_part3_c2",
      "part": 3,
      "voice": "men",
      "speaker": "men",
      "voice_role": "dialogue:men",
      "paragraph_index": 21,
      "source_paragraph_indices": [
        21
      ],
      "text": "\"Bertie, why do you bound?\"",
      "text_sha256": "38705718fbe22ef92914a71bbbe63ee63f24c5f2d2134697486e52f931869443",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part3_c2.wav"
    },
    {
      "id": "full_story_part3_c3",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 22,
      "source_paragraph_indices": [
        22,
        23,
        24
      ],
      "text": "Framton struggled for breath as the dead approached the house. He took his hat and stick and hurried outside. Moments later, he was racing down the drive. The men came through the window, hungry and covered in mud.",
      "text_sha256": "929817185c185b41a28a257b12c3dff81311765abda395cfb73538fad605b889",
      "word_count": 38,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part3_c3.wav"
    },
    {
      "id": "full_story_part3_c4",
      "part": 3,
      "voice": "men",
      "speaker": "men",
      "voice_role": "dialogue:men",
      "paragraph_index": 25,
      "source_paragraph_indices": [
        25
      ],
      "text": "\"Who just left?\"",
      "text_sha256": "96119014e7ab38927c2c65edd9f25107d5cab7cd49385e994561df57ef0b38d1",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_open_window/run_sf_prod_01/a2/narration/full_story_part3_c4.wav"
    },
    {
      "id": "full_story_part3_c5",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 25,
      "source_paragraph_indices": [
        25
      ],
      "text": "her husband asked.",

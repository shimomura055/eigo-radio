  "clips": [
    {
      "id": "full_story_part1_c1",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0,
        1,
        2,
        3,
        4
      ],
      "text": "One dollar and eighty-seven cents. Della counted the coins again, pressing each one against the table. Still the same. And tomorrow was Christmas. She had saved every penny she could. How could she buy Jim something worthy of him? For a while, she cried on their shabby couch. Then she caught sight of herself in the mirror. They owned two things that made them proud. One was Jim's gold watch, handed down from his grandfather to his father, and then to him. The other was Della's long brown hair. Slowly, she loosened her hair. It fell below her knees, shining in the pale light. She ran her fingers through it once. Then, before she could change her mind, she pulled on her coat.",
      "text_sha256": "a8a43cd267254f16ac920a05d6bc977927c3cdda820c9203d71f474abd81868d",
      "word_count": 123,
      "split_reason": "comment_or_scene_boundary(呼び出し側指定のforce_split_before_paragraphs)",
      "warnings": [
        "soft_max_exceeded(word_count=123, soft_max_words=120)"
      ],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part1_c1.wav"
    },
    {
      "id": "full_story_part2_c1",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 5,
      "source_paragraph_indices": [
        5
      ],
      "text": "Outside a hair-goods shop, she paused just long enough to catch her breath.",
      "text_sha256": "cbebf136d039f4c919966a2efc63e82cbeac50dd3590334c9754e0bd35f2379a",
      "word_count": 13,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part2_c1.wav"
    },
    {
      "id": "full_story_part2_c2",
      "part": 2,
      "voice": "della",
      "speaker": "della",
      "voice_role": "dialogue:della",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "\"Will you buy my hair?\"",
      "text_sha256": "984d6a271c9162d9a762da6bb8141838e6579b2f514525184e06802a8fbb8b71",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part2_c2.wav"
    },
    {
      "id": "full_story_part2_c3",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "The owner lifted the heavy waves.",
      "text_sha256": "868efc62b7d9b03cc325911213831dcea82b7ecc0b9b1b5733733bb4d24634d0",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part2_c3.wav"
    },
    {
      "id": "full_story_part2_c4",
      "part": 2,
      "voice": "madame",
      "speaker": "madame",
      "voice_role": "dialogue:madame",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "\"Twenty dollars.\"",
      "text_sha256": "f7873949b776ccaa78f51399d1cb6dc532b27e58588a72d19055d629996ed61d",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part2_c4.wav"
    },
    {
      "id": "full_story_part2_c5",
      "part": 2,
      "voice": "della",
      "speaker": "della",
      "voice_role": "dialogue:della",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "\"Cut it quickly, please.\"",
      "text_sha256": "de03bd81a066f04fd3a0885129377f8677c6deb1ad7eafea13622a00092df5c5",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part2_c5.wav"
    },
    {
      "id": "full_story_part2_c6",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 10,
      "source_paragraph_indices": [
        10,
        11,
        12,
        13,
        14
      ],
      "text": "At the first touch of the scissors, Della shut her eyes. For two hours afterward, she hurried from shop to shop. Finally, she found it: a simple platinum watch chain. Nothing showy, nothing unnecessary. Like Jim, it needed no decoration to prove its worth. It cost twenty-one dollars. She carried it home with eighty-seven cents left, imagining Jim replacing his worn leather watch strap with her beautiful gift. By seven, dinner was nearly ready. Della had curled her short hair, but she kept returning to the mirror.",
      "text_sha256": "60a3e85d5af4adab4a5dc14229066c1c8b33054557a0b86601cff1192a4b6510",
      "word_count": 87,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part2_c6.wav"
    },
    {
      "id": "full_story_part2_c7",
      "part": 2,
      "voice": "della",
      "speaker": "della",
      "voice_role": "dialogue:della",
      "paragraph_index": 15,
      "source_paragraph_indices": [
        15
      ],
      "text": "\"Please let him still think I'm pretty,\"",
      "text_sha256": "21dea12bfa8fcdc2532cb17eb47abbc959b108c467b0e841a1a6b96aa375b8cb",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part2_c7.wav"
    },
    {
      "id": "full_story_part2_c8",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 15,
      "source_paragraph_indices": [
        15
      ],
      "text": "she whispered.",
      "text_sha256": "01768b2d3ccccfdf42f4c6d004db8fc5bf54ab0b586dc0a30e848aabb7ba87fb",
      "word_count": 2,
      "split_reason": "comment_or_scene_boundary(呼び出し側指定のforce_split_before_paragraphs)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part2_c8.wav"
    },
    {
      "id": "full_story_part3_c1",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 16,
      "source_paragraph_indices": [
        16,
        17,
        18
      ],
      "text": "Footsteps sounded. The door opened. Jim stopped. His eyes stayed on her hair. Della rushed toward him.",
      "text_sha256": "eada6a3f0f03b95e6713a40887935afbbf67424e3926438cf7b7969769a525b8",
      "word_count": 17,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part3_c1.wav"
    },
    {
      "id": "full_story_part3_c2",
      "part": 3,
      "voice": "della",
      "speaker": "della",
      "voice_role": "dialogue:della",
      "paragraph_index": 19,
      "source_paragraph_indices": [
        19
      ],
      "text": "\"I sold it, Jim. I couldn't let Christmas come without giving you something. It'll grow again!\"",
      "text_sha256": "1e748da23f3d0153e29df8eae550b8a2c222c27e8d7708b6d6df2979296d3577",
      "word_count": 16,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part3_c2.wav"
    },
    {
      "id": "full_story_part3_c3",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 20,
      "source_paragraph_indices": [
        20,
        21,
        22
      ],
      "text": "He put his arms around her. Then he gave her a package. Inside were the tortoise-shell combs she had so often admired in a shop window. She held them against her chest, smiling through tears.",
      "text_sha256": "e7218aca15c082e23d81ef2f65ec0095e765be00c21c9bc34a24ccec15fbcc54",
      "word_count": 35,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part3_c3.wav"
    },
    {
      "id": "full_story_part3_c4",
      "part": 3,
      "voice": "della",
      "speaker": "della",
      "voice_role": "dialogue:della",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23
      ],
      "text": "\"My hair grows quickly.\"",
      "text_sha256": "d8a20d99be1b109727c0ed8920aeb5029f4b193b6a0f3093938167e2a05e726d",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part3_c4.wav"
    },
    {
      "id": "full_story_part3_c5",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 24,
      "source_paragraph_indices": [
        24
      ],
      "text": "Suddenly remembering, she brought out the chain.",
      "text_sha256": "ce8fa9a104e16f7b8cea0672c11dabcf06593278a3c11805245e0652e94f8941",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part3_c5.wav"
    },
    {
      "id": "full_story_part3_c6",
      "part": 3,
      "voice": "della",
      "speaker": "della",
      "voice_role": "dialogue:della",
      "paragraph_index": 25,
      "source_paragraph_indices": [
        25
      ],
      "text": "\"Look! Isn't it perfect? Give me your watch.\"",
      "text_sha256": "b6875716eb7ff30758c22e6a65855df9547eba841b02421de687c42f725d46fc",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part3_c6.wav"
    },
    {
      "id": "full_story_part3_c7",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 26,
      "source_paragraph_indices": [
        26
      ],
      "text": "Jim sat down and smiled gently.",
      "text_sha256": "adeb555c9300014aec09d512c0a3a786eec4e254bd526dda8cadffefd4f220e3",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part3_c7.wav"
    },
    {
      "id": "full_story_part3_c8",
      "part": 3,
      "voice": "jim",
      "speaker": "jim",
      "voice_role": "dialogue:jim",
      "paragraph_index": 27,
      "source_paragraph_indices": [
        27
      ],
      "text": "\"I sold the watch to buy your combs.\"",
      "text_sha256": "1a49faa20df26a70b816b365bebba138b49876f9e297da2907ae716da0e37807",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/b1b/narration/full_story_part3_c8.wav"
    },
    {
      "id": "full_story_part3_c9",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 28,
      "source_paragraph_indices": [
        28,
        29
      ],
      "text": "Della sat beside him and took his hand. Her hair was gone; the combs could not hold it. His watch was gone; the chain had nothing to carry. Each had sold their greatest treasure to buy the other a gift. The magi were wise men who brought gifts on the first Christmas. Yet here, with gifts they could not use, sat two foolish young people whose love made them the wisest of all gift-givers. They were the magi.",
      "text_sha256": "75f47dd4dfc3c3ad5010900081335f040b41d4a0f79442e711fb718e2754c498",
      "word_count": 78,
      "split_reason": "article_end(直前の分割点から続く同一Voice区間)",

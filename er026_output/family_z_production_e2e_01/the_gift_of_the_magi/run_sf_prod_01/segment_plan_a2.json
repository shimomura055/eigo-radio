  "clips": [
    {
      "id": "full_story_part1_c1",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "text": "Della counted her coins again, pressing them against the table. She still had only $1.87, and Christmas was tomorrow. She had saved every coin she could for Jim, her husband. How could she buy him a good enough gift? She cried for a while on their old couch. Then she noticed her face in the mirror. They were proud of two things: Della's long brown hair and Jim's gold watch. His grandfather, then his father, had owned the watch before him. She slowly let down her hair, shining below her knees. She ran her fingers through it in the pale light. Quickly, she put on her coat before changing her mind. Outside a shop selling hair, she stopped to catch her breath.",
      "text_sha256": "160999424d039580b1c8caaebfed69f8883422e85ea185031a6447c5256ee783",
      "word_count": 122,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [
        "soft_max_exceeded(word_count=122, soft_max_words=120)"
      ],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part1_c1.wav"
    },
    {
      "id": "full_story_part1_c2",
      "part": 1,
      "voice": "della",
      "speaker": "della",
      "voice_role": "dialogue:della",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "\"Would you like to buy my hair?\"",
      "text_sha256": "9f3f26931202d47201fa1aff3910ab5a7d2fe6c56b37efd05c7dfc082dde902c",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part1_c2.wav"
    },
    {
      "id": "full_story_part1_c3",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "The shop owner lifted her thick waves of hair.",
      "text_sha256": "e6d665112c1d7bc32432c1374a0b627484032dd38e411859444351e9fdb8192a",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part1_c3.wav"
    },
    {
      "id": "full_story_part1_c4",
      "part": 1,
      "voice": "madame",
      "speaker": "madame",
      "voice_role": "dialogue:madame",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "\"I can pay you twenty dollars.\"",
      "text_sha256": "b3f0400eb1163d37d361ea02a1740ff5fee0b55bc86583b16ea1552503179a81",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part1_c4.wav"
    },
    {
      "id": "full_story_part1_c5",
      "part": 1,
      "voice": "della",
      "speaker": "della",
      "voice_role": "dialogue:della",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "\"Please cut it off right now.\"",
      "text_sha256": "a4b5b7440b4d0fc45930ed90870e3478bd854496e23e7c691f92360eee50c7a5",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part1_c5.wav"
    },
    {
      "id": "full_story_part1_c6",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 10,
      "source_paragraph_indices": [
        10,
        11,
        12
      ],
      "text": "Della closed her eyes as the scissors first touched her hair. For two hours, she rushed between shops until she found it: a simple platinum watch chain. Like Jim, it needed nothing extra to show its value. Its price was twenty-one dollars.",
      "text_sha256": "7a9f5831a5601674cbe7e1cbc481b791e500c20a983c1c2121d290ce9048fb0e",
      "word_count": 42,
      "split_reason": "comment_or_scene_boundary(呼び出し側指定のforce_split_before_paragraphs)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part1_c6.wav"
    },
    {
      "id": "full_story_part2_c1",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 13,
      "source_paragraph_indices": [
        13,
        14
      ],
      "text": "With eighty-seven cents left, she took it home. She pictured Jim using it instead of his worn leather strap. By seven, dinner was almost ready, and her short hair was curled. Still, she kept looking in the mirror.",
      "text_sha256": "cf0223c5732342027629601e0507ecd4ce68355a832843111dbe4c53c2aa544b",
      "word_count": 38,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part2_c1.wav"
    },
    {
      "id": "full_story_part2_c2",
      "part": 2,
      "voice": "della",
      "speaker": "della",
      "voice_role": "dialogue:della",
      "paragraph_index": 15,
      "source_paragraph_indices": [
        15
      ],
      "text": "\"Please, let me still look pretty to him,\"",
      "text_sha256": "130b224070e1a9c6a03a3d6fa178b563f54d4e7054c206bf74575009e1f110b9",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part2_c2.wav"
    },
    {
      "id": "full_story_part2_c3",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 15,
      "source_paragraph_indices": [
        15,
        16,
        17,
        18
      ],
      "text": "she said softly. She heard his steps, and then the door opened. Jim stood still in the doorway. He stared at her hair as she hurried towards him.",
      "text_sha256": "2595879567bca3fb1c172de973cc992843d712043eb967d6cd014e370dad66c0",
      "word_count": 28,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part2_c3.wav"
    },
    {
      "id": "full_story_part2_c4",
      "part": 2,
      "voice": "della",
      "speaker": "della",
      "voice_role": "dialogue:della",
      "paragraph_index": 19,
      "source_paragraph_indices": [
        19
      ],
      "text": "\"Jim, I sold my hair to buy you a Christmas gift. It will grow back!\"",
      "text_sha256": "11744f564400e0024a790391f22710c051073bd2b9604bd8cf6e99d5ef42a067",
      "word_count": 15,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part2_c4.wav"
    },
    {
      "id": "full_story_part2_c5",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 20,
      "source_paragraph_indices": [
        20,
        21
      ],
      "text": "He held her close, then handed her a package. She found the tortoise-shell combs inside the package. She had often admired them in a shop window.",
      "text_sha256": "ee471b0167a395674d8f11b600404ebf1464cfc901364919278afee7df08ce86",
      "word_count": 26,
      "split_reason": "comment_or_scene_boundary(呼び出し側指定のforce_split_before_paragraphs)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part2_c5.wav"
    },
    {
      "id": "full_story_part3_c1",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 22,
      "source_paragraph_indices": [
        22
      ],
      "text": "She pressed them to her chest and smiled through her tears.",
      "text_sha256": "8ba216cd5ed6d53bf9bb3a31793421271c9a785cae91929bab8b068a83f13ee1",
      "word_count": 11,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part3_c1.wav"
    },
    {
      "id": "full_story_part3_c2",
      "part": 3,
      "voice": "della",
      "speaker": "della",
      "voice_role": "dialogue:della",
      "paragraph_index": 23,
      "source_paragraph_indices": [
        23
      ],
      "text": "\"It won't take long for my hair to grow.\"",
      "text_sha256": "168386b478a25599ff135f7c541c44b6af5e32b45f25f15814451383fc649a9f",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part3_c2.wav"
    },
    {
      "id": "full_story_part3_c3",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 24,
      "source_paragraph_indices": [
        24
      ],
      "text": "Then she remembered her gift and took out the chain.",
      "text_sha256": "0ce1dbda49cb7a8b107d2041266b7fc2cf6a48cfe757a801ccffe3dac28cadf1",
      "word_count": 10,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part3_c3.wav"
    },
    {
      "id": "full_story_part3_c4",
      "part": 3,
      "voice": "della",
      "speaker": "della",
      "voice_role": "dialogue:della",
      "paragraph_index": 25,
      "source_paragraph_indices": [
        25
      ],
      "text": "\"See how beautiful it is! Let me have your watch.\"",
      "text_sha256": "313dcbc9bd868ff93df4002d8b7e9973dde2388db1affb40cb6ae073d5d34643",
      "word_count": 10,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part3_c4.wav"
    },
    {
      "id": "full_story_part3_c5",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 26,
      "source_paragraph_indices": [
        26
      ],
      "text": "Jim smiled softly as he took a seat.",
      "text_sha256": "38c271f182d93214e6148a29232eb334177388c233f7e412bb4544ad94fcdebe",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part3_c5.wav"
    },
    {
      "id": "full_story_part3_c6",
      "part": 3,
      "voice": "jim",
      "speaker": "jim",
      "voice_role": "dialogue:jim",
      "paragraph_index": 27,
      "source_paragraph_indices": [
        27
      ],
      "text": "\"To buy your combs, I had to sell my watch.\"",
      "text_sha256": "e221d4d34bd252db2c314685fafdb6539dac1a9982f0365e5c2290d2838dac57",
      "word_count": 10,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part3_c6.wav"
    },
    {
      "id": "full_story_part3_c7",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 28,
      "source_paragraph_indices": [
        28,
        29
      ],
      "text": "Della joined him and held his hand. Without her hair, she could not use the combs. Without his watch, he could not use the chain. Both had sold their greatest treasure for the other's gift. Wise men called the magi brought gifts on the first Christmas. The two young people seemed foolish with their useless gifts. But their love made them wiser than all other gift-givers. In every place, they are the wisest; these two are the magi.",
      "text_sha256": "af1accc866b3d72d1c0034304b1a783a73c926a524d08a2a726fbbf194bf50c0",
      "word_count": 78,
      "split_reason": "article_end(直前の分割点から続く同一Voice区間)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_gift_of_the_magi/run_sf_prod_01/a2/narration/full_story_part3_c7.wav"
    }
  ],

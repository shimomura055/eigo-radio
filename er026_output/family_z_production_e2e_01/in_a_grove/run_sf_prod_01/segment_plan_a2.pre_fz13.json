      "voice_role": "dialogue:woodcutter",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "\"I found him in the bushes this morning,\"",
      "text_sha256": "b20e7fa282ab3c5a5973e80ebe49e4a00409568e074e15a9c1a5d2941ca9d9b3",
      "word_count": 8,

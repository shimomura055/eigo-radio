  "clips": [
    {
      "id": "full_story_part1_c1",
      "part": 1,
      "voice": "woodcutter",
      "speaker": "woodcutter",
      "voice_role": "dialogue:woodcutter",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "\"One stab in the chest. That's what I saw,\"",
      "text_sha256": "e3228b1178c76e8ec844524716c40d53723a8b4bc540c28cb0106a20954f7c76",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part1_c1.wav"
    },
    {
      "id": "full_story_part1_c2",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "said the woodcutter.",
      "text_sha256": "93e8ffde78a74b2317657a0fb88ff3428c6c423e73cb2b063cfd578c314d4209",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part1_c2.wav"
    },
    {
      "id": "full_story_part1_c3",
      "part": 1,
      "voice": "woodcutter",
      "speaker": "woodcutter",
      "voice_role": "dialogue:woodcutter",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0
      ],
      "text": "\"I found him this morning, in a thicket off the mountain road. The blood was dry. No sword or bow, sir—only rope beneath a cedar, and a comb. The broken bamboo and trampled earth showed a struggle.\"",
      "text_sha256": "16c23ad77eadb6a5193f5cd3c68e85474c582af8f8a13df0d1d5f78607a8b1fb",
      "word_count": 37,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part1_c3.wav"
    },
    {
      "id": "full_story_part1_c4",
      "part": 1,
      "voice": "monk",
      "speaker": "monk",
      "voice_role": "dialogue:monk",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "\"I passed them yesterday at noon,\"",
      "text_sha256": "ab492584333c9a94e6565bd19f5eb1ee73f6d15d671deda16e4e233dc34015ee",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part1_c4.wav"
    },
    {
      "id": "full_story_part1_c5",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "said the monk.",
      "text_sha256": "2cfe0f0749c7369cc250c096ffa31dbc551a88c0a74d79308160e239de95b25e",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part1_c5.wav"
    },
    {
      "id": "full_story_part1_c6",
      "part": 1,
      "voice": "monk",
      "speaker": "monk",
      "voice_role": "dialogue:monk",
      "paragraph_index": 1,
      "source_paragraph_indices": [
        1
      ],
      "text": "\"He carried a sword and bow. His wife rode beside him, her face veiled. I hardly looked at them. Now I wish I had.\"",
      "text_sha256": "895160fc669cffbd031ea11ffa66961cdad0177c400a9ee5e55c21377baa32cf",
      "word_count": 24,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part1_c6.wav"
    },
    {
      "id": "full_story_part1_c7",
      "part": 1,
      "voice": "constable",
      "speaker": "constable",
      "voice_role": "dialogue:constable",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"I caught Tajomaru, the famous bandit, by the stone bridge,\"",
      "text_sha256": "39afa024cef7c7cc7633507ff68905b80658a90ba2232f85a505078a381680c9",
      "word_count": 10,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part1_c7.wav"
    },
    {
      "id": "full_story_part1_c8",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "said the constable.",
      "text_sha256": "0c4d642ccdcda3cea4f5a04bac026ce5872093cae1d23e7dbfebaf3baa91f0db",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part1_c8.wav"
    },
    {
      "id": "full_story_part1_c9",
      "part": 1,
      "voice": "constable",
      "speaker": "constable",
      "voice_role": "dialogue:constable",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"He'd fallen from a horse, but he still had the dead man's bow. Find the woman. She'll tell you what he did.\"",
      "text_sha256": "7abb33c58942b23c6f08adf1b35fa99846101fa86f554a467c001712e5a6857e",
      "word_count": 22,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part1_c9.wav"
    },
    {
      "id": "full_story_part1_c10",
      "part": 1,
      "voice": "old_woman",
      "speaker": "old_woman",
      "voice_role": "dialogue:old_woman",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "\"Takehiro was my daughter's husband,\"",
      "text_sha256": "f9192b4543711c2960e7d552ee3acfe81e8cf3dac87d6e5a66b955f46070a30f",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part1_c10.wav"
    },
    {
      "id": "full_story_part1_c11",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "said the old woman.",
      "text_sha256": "235f43632b9593bfc8bb5abcd935be749b7593974693aaa556dedb0513a6773a",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part1_c11.wav"
    },
    {
      "id": "full_story_part1_c12",
      "part": 1,
      "voice": "old_woman",
      "speaker": "old_woman",
      "voice_role": "dialogue:old_woman",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "\"A gentle samurai. Masago is proud, yes, but she's only nineteen. Please find her. Don't send me home without news.\"",
      "text_sha256": "e073de3ec9c17a72b1e5a0a7bb8eca000a921f0d4a0ce45cc23ff60ee49dc8be",
      "word_count": 20,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part1_c12.wav"
    },
    {
      "id": "full_story_part2_c1",
      "part": 2,
      "voice": "tajomaru",
      "speaker": "tajomaru",
      "voice_role": "dialogue:tajomaru",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "\"Yes, I killed him,\"",
      "text_sha256": "f21a1b89135dc4defb343bd84c5f37e88a0f92bbf200a9c897fd56dc80c01d11",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part2_c1.wav"
    },
    {
      "id": "full_story_part2_c2",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "said Tajomaru. \"But listen before you call me a coward! A breeze lifted her veil, and I wanted her. I promised him buried treasure, led him into the thicket and tied him to the cedar. She fought with her dagger, but I took her by force.",
      "text_sha256": "4debb6ba5e661082702acda25e3a16498d5fc8ea41cb9d0cf6922cd0646f82f6",
      "word_count": 46,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part2_c2.wav"
    },
    {
      "id": "full_story_part2_c3",
      "part": 2,
      "voice": "tajomaru",
      "speaker": "tajomaru",
      "voice_role": "dialogue:tajomaru",
      "paragraph_index": 5,
      "source_paragraph_indices": [
        5
      ],
      "text": "\"Then she seized my arm. One of us must die, she said. She would go with the survivor. So I freed him. We fought fairly, sword against sword. Twenty-three strokes! No other man had lasted twenty. When he fell, she was gone. I took his weapons and left.\"",
      "text_sha256": "30e6f56bcf31c6cd2eb36e9896dee07f5e7cd5f88cfdbb2fe72514e06b5a3451",
      "word_count": 48,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part2_c3.wav"
    },
    {
      "id": "full_story_part3_c1",
      "part": 3,
      "voice": "masago",
      "speaker": "masago",
      "voice_role": "dialogue:masago",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "\"I crawled towards my husband after the bandit left,\"",
      "text_sha256": "d695470f6ffbcfccd8a749c74a7b2d9f4338b77f7701418b8fbe3ff19fdea30b",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part3_c1.wav"
    },
    {
      "id": "full_story_part3_c2",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6,
        7
      ],
      "text": "said Masago at the temple. \"He was still tied up. I begged him to die with me. But his eyes held nothing except cold contempt. For me. His own wife. \"I held my dagger. His lips moved: 'Kill me.' So I stabbed him. How could I bear those eyes?",
      "text_sha256": "a7d875c921cdb347d5945f71603099848035f6acb9efab25e202dfc5d98cf53d",
      "word_count": 49,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part3_c2.wav"
    },
    {
      "id": "full_story_part3_c3",
      "part": 3,
      "voice": "masago",
      "speaker": "masago",
      "voice_role": "dialogue:masago",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "\"Afterwards, I tried to drown myself. I couldn't even do that. Where can I go now?\"",
      "text_sha256": "ecdb7ecff0d3f7c4d4b9394c707c73bd507d6285cb6dd03912e4a73014d73de2",
      "word_count": 16,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part3_c3.wav"
    },
    {
      "id": "full_story_part3_c4",
      "part": 3,
      "voice": "takehiro",
      "speaker": "takehiro",
      "voice_role": "dialogue:takehiro",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "\"I heard the bandit comforting her,\"",
      "text_sha256": "130521b86e6087b3bd38e89798cd64fd2e0d72131d0a7bc4a4029cdbc6ad931d",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part3_c4.wav"
    },
    {
      "id": "full_story_part3_c5",
      "part": 3,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9,
        10,
        11,
        12
      ],
      "text": "said Takehiro's spirit through the medium. \"My wife said, 'Take me anywhere.' Then she pointed at me. 'Kill that man.' \"He pushed her away and asked me whether she should live or die. For that, I almost forgave him. But she fled. He cut one rope and left. \"I rose from the cedar and picked up the small dagger she had dropped. I stabbed myself in the chest. \"The thicket fell silent. Then someone crept towards me on soft feet. An unseen hand quietly drew the dagger from my chest.",
      "text_sha256": "7a9056f76509480d036d63d83e2d926cffd67676a6206768a10c049782293740",
      "word_count": 90,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part3_c5.wav"
    },
    {
      "id": "full_story_part3_c6",
      "part": 3,
      "voice": "takehiro",
      "speaker": "takehiro",
      "voice_role": "dialogue:takehiro",
      "paragraph_index": 13,
      "source_paragraph_indices": [
        13
      ],
      "text": "\"I sank for ever into the darkness.\"",
      "text_sha256": "f026d6f427ff6e5f4ad15d98d4fb257c14b963a797870947cca5ae9e57f115a5",
      "word_count": 7,
      "split_reason": "article_end(直前の分割点から続く同一Voice区間)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/in_a_grove/run_sf_prod_01/b1b/narration/full_story_part3_c6.wav"
    }
  ],

  "clips": [
    {
      "id": "full_story_part1_c1",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0,
        1
      ],
      "text": "Wind shook the windows, but a bright fire warmed the room. Mr. White lost at chess to his grown son, Herbert. Mrs. White smiled as she knitted beside them. An old friend visited them, a retired sergeant-major from India. He showed them a small, dry monkey's paw.",
      "text_sha256": "01cfe1bd0080368430e5677d13152a76f21c1b5ad6768e1983a7bbb228bb48f9",
      "word_count": 47,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part1_c1.wav"
    },
    {
      "id": "full_story_part1_c2",
      "part": 1,
      "voice": "morris",
      "speaker": "morris",
      "voice_role": "dialogue:morris",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"The paw gives three wishes,\"",
      "text_sha256": "0a5cf20f18cb8fc741be40933528bd558c9917d3790e0ec79a1d8db7d7a6c506",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part1_c2.wav"
    },
    {
      "id": "full_story_part1_c3",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "he said.",
      "text_sha256": "0669e82b2925c89aa39333900dd53b5eddf64c21d53190788d892d0e0af37799",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part1_c3.wav"
    },
    {
      "id": "full_story_part1_c4",
      "part": 1,
      "voice": "morris",
      "speaker": "morris",
      "voice_role": "dialogue:morris",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"But trying to change your fate brings sadness.\"",
      "text_sha256": "6403aaaed8262bc62ebb946aaff50532ee9d0eff2ca5d0a627d5a1a0ff894f08",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part1_c4.wav"
    },
    {
      "id": "full_story_part1_c5",
      "part": 1,
      "voice": "mr_white",
      "speaker": "mr_white",
      "voice_role": "dialogue:mr_white",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "\"Did you make any wishes?\"",
      "text_sha256": "f0387c55e29ecdf65892075db612e17038e8c8f008b9fe20289bafd5b39823ed",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part1_c5.wav"
    },
    {
      "id": "full_story_part1_c6",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "Mr. White asked.",
      "text_sha256": "b68e3e0ba17408b0ae44eb2a38797922404a5528fd64abfc262e231d04a7d590",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part1_c6.wav"
    },
    {
      "id": "full_story_part1_c7",
      "part": 1,
      "voice": "morris",
      "speaker": "morris",
      "voice_role": "dialogue:morris",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "\"I've already used all three wishes.\"",
      "text_sha256": "d67083dd77ab91ebf46f0883e4ba67c4439ca4ce33aac41dfc2f30d63deb93b6",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part1_c7.wav"
    },
    {
      "id": "full_story_part1_c8",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 5,
      "source_paragraph_indices": [
        5
      ],
      "text": "The soldier suddenly threw the paw into the fire. Mr. White quickly pulled it out.",
      "text_sha256": "392a5e25a21160d3429589e9fed403603b55be8d3db74724251ae862fc645cb3",
      "word_count": 15,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part1_c8.wav"
    },
    {
      "id": "full_story_part1_c9",
      "part": 1,
      "voice": "morris",
      "speaker": "morris",
      "voice_role": "dialogue:morris",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "\"Burn it, or don't blame me for what happens,\"",
      "text_sha256": "6b5a25e6c2c91846302077b2378f5473eb53e2e1424bca5610d281b8e71b21f0",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part1_c9.wav"
    },
    {
      "id": "full_story_part1_c10",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6,
        7
      ],
      "text": "his friend warned. After their guest left, Herbert joked,",
      "text_sha256": "04af0e3ed487a8a9cd1b8d428f4bebb8a8b34e8db7935f4b3b429b8da51c0b36",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part1_c10.wav"
    },
    {
      "id": "full_story_part1_c11",
      "part": 1,
      "voice": "herbert",
      "speaker": "herbert",
      "voice_role": "dialogue:herbert",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "\"Ask for two hundred pounds, Father! That would pay for the house.\"",
      "text_sha256": "fb746d10178ab4906dd003340714354ae623b8346a071f4c8c5e5e917cc373e8",
      "word_count": 12,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part1_c11.wav"
    },
    {
      "id": "full_story_part1_c12",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "Mr. White smiled as he raised the paw.",
      "text_sha256": "51a019104ef9c6e22d68bee139c727129cee18a6e311fb25e5a65580bde6555a",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part1_c12.wav"
    },
    {
      "id": "full_story_part1_c13",
      "part": 1,
      "voice": "mr_white",
      "speaker": "mr_white",
      "voice_role": "dialogue:mr_white",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "\"I wish to have two hundred pounds.\"",
      "text_sha256": "620b60625fe4ddd5c7fb1257b712a67a35b002b6571314e1ebe57423c7a821ef",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part1_c13.wav"
    },
    {
      "id": "full_story_part1_c14",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "The paw twisted in his hand, and he dropped it with a cry. They watched the floor, but nothing happened.",
      "text_sha256": "9ce263d52a5c1b7ceea9e1769c34b56f1770d4933f4b69957226da72788d3870",
      "word_count": 20,
      "split_reason": "comment_or_scene_boundary(呼び出し側指定のforce_split_before_paragraphs)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part1_c14.wav"
    },
    {
      "id": "full_story_part2_c1",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 10,
      "source_paragraph_indices": [
        10,
        11
      ],
      "text": "They laughed about it again over breakfast before Herbert left for work. Mrs. White then cleared the table. Later, a man from Herbert's company came to visit.",
      "text_sha256": "69b033f4bf9ef9fe5a3589af4315c41f32b2b4bc1e6495105076efbed05f844f",
      "word_count": 27,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part2_c1.wav"
    },
    {
      "id": "full_story_part2_c2",
      "part": 2,
      "voice": "visitor",
      "speaker": "visitor",
      "voice_role": "dialogue:visitor",
      "paragraph_index": 12,
      "source_paragraph_indices": [
        12
      ],
      "text": "\"Your son died after a machine caught him at work,\"",
      "text_sha256": "6864de500dbf857efc6d06b3ff466f62f73903aca8abd891dadbef5b9e28cc94",
      "word_count": 10,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part2_c2.wav"
    },
    {
      "id": "full_story_part2_c3",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 12,
      "source_paragraph_indices": [
        12,
        13
      ],
      "text": "the man said. Mr. White took hold of his wife's hand.",
      "text_sha256": "81d14fc05340c345386382db8e1d5eaaede422a6b17f144d0ecabc9e33443ba6",
      "word_count": 11,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part2_c3.wav"
    },
    {
      "id": "full_story_part2_c4",
      "part": 2,
      "voice": "visitor",
      "speaker": "visitor",
      "voice_role": "dialogue:visitor",
      "paragraph_index": 14,
      "source_paragraph_indices": [
        14
      ],
      "text": "\"The company says it isn't to blame, but offers two hundred pounds for your loss.\"",
      "text_sha256": "b8e016813c2fc91dd1e1518da076793b85190fd022d0922c4343eb3160eea2c2",
      "word_count": 15,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part2_c4.wav"
    },
    {
      "id": "full_story_part2_c5",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 15,
      "source_paragraph_indices": [
        15,
        16
      ],
      "text": "Mr. White fell off his chair. A week after the funeral, Mrs. White woke her husband with tears on her face.",
      "text_sha256": "2d18517f5a688f97cb2143fa8135ae31237bd71f926abea6e71e218d9a934f39",
      "word_count": 21,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part2_c5.wav"
    },
    {
      "id": "full_story_part2_c6",
      "part": 2,
      "voice": "mrs_white",
      "speaker": "mrs_white",
      "voice_role": "dialogue:mrs_white",
      "paragraph_index": 17,
      "source_paragraph_indices": [
        17
      ],
      "text": "\"There are still two wishes in the paw! Bring our son back to life!\"",
      "text_sha256": "3b4d9386996198c373979de79fb9df81139bddb717f8806d4322efb5616cbb86",
      "word_count": 14,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part2_c6.wav"
    },
    {
      "id": "full_story_part2_c7",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 18,
      "source_paragraph_indices": [
        18
      ],
      "text": "He looked away.",
      "text_sha256": "ab352483e2b3351d02906e96722d3a7a641bc086e4f6f9ebe29dbf06fdc57066",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part2_c7.wav"
    },
    {
      "id": "full_story_part2_c8",
      "part": 2,
      "voice": "mr_white",
      "speaker": "mr_white",
      "voice_role": "dialogue:mr_white",
      "paragraph_index": 18,
      "source_paragraph_indices": [
        18
      ],
      "text": "\"You didn't see him, and I'm afraid of what might return.\"",
      "text_sha256": "74e8b459cb60407a795281ae61c527d1f78ab2d361f740a97db6ed222b2edfde",
      "word_count": 11,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part2_c8.wav"
    },
    {
      "id": "full_story_part2_c9",
      "part": 2,
      "voice": "mrs_white",
      "speaker": "mrs_white",
      "voice_role": "dialogue:mrs_white",
      "paragraph_index": 19,
      "source_paragraph_indices": [
        19
      ],
      "text": "\"But he's our own son!\"",
      "text_sha256": "a338a7f91fe92beb9568f89009113b124b922ddb13b58dae98d2955aa5018264",
      "word_count": 5,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part2_c9.wav"
    },
    {
      "id": "full_story_part2_c10",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 20,
      "source_paragraph_indices": [
        20
      ],
      "text": "Mr. White finally went downstairs and found the paw. His wife followed, and his voice was shaking.",
      "text_sha256": "541ddf19fc8b9bca70ef9315455b1f6b730b2560af7878b162b45055d3e33d60",
      "word_count": 17,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part2_c10.wav"
    },
    {
      "id": "full_story_part3_c1",
      "part": 3,
      "voice": "mr_white",
      "speaker": "mr_white",
      "voice_role": "dialogue:mr_white",
      "paragraph_index": 21,
      "source_paragraph_indices": [
        21
      ],
      "text": "\"I wish for Herbert to live again.\"",
      "text_sha256": "1506fd27312ddc3e2ac7969a8f5380e21dfe43bcd7e97f1a9c68cfdd64771280",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/a2/narration/full_story_part3_c1.wav"
    },
    {

      "paragraph_index": 24,
      "source_paragraph_indices": [
        24
      ],
      "text": "\"It's Herbert!\"",
      "text_sha256": "fd07eab4dffc05bddc9c64539e1595268f8aba0517ed9c6a4ea92f269a478bad",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",

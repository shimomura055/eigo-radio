      "voice_role": "dialogue:mr_white",
      "paragraph_index": 27,
      "source_paragraph_indices": [
        27
      ],
      "text": "\"Please wait!\"",
      "text_sha256": "327e9c157b7eec44a8c915bc0d3d12c9b4d4bd8c9988b6f70fee06173481e1d9",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],

  "clips": [
    {
      "id": "full_story_part1_c1",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 0,
      "source_paragraph_indices": [
        0,
        1
      ],
      "text": "Wind rattled the windows, but the fire burned brightly. Herbert grinned over the chessboard while Mr. White leaned back, defeated. Beside them, Mrs. White smiled over her knitting. A knock announced an old friend, a retired sergeant-major home from India. By the fire, he showed them a small, dried monkey's paw.",
      "text_sha256": "16dc1d3628e47d8bdaa175ef8d4a84f4eac09695d4fd3a3d6489d7972b3c84f8",
      "word_count": 51,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c1.wav"
    },
    {
      "id": "full_story_part1_c2",
      "part": 1,
      "voice": "morris",
      "speaker": "morris",
      "voice_role": "dialogue:morris",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"It grants three wishes,\"",
      "text_sha256": "411da7ed4e72510c5f1a25507306492cd27a764e7b59e9465aadb1b19954fd48",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c2.wav"
    },
    {
      "id": "full_story_part1_c3",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "he said,",
      "text_sha256": "7144daaa71361caf40cc57cc7f6fd85171d694e4953ea610370d65deb1bc80fc",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c3.wav"
    },
    {
      "id": "full_story_part1_c4",
      "part": 1,
      "voice": "morris",
      "speaker": "morris",
      "voice_role": "dialogue:morris",
      "paragraph_index": 2,
      "source_paragraph_indices": [
        2
      ],
      "text": "\"but brings sorrow to anyone who interferes with fate.\"",
      "text_sha256": "b02a90eed33fd06153ec78a5d2c4ebdbaf5ebc0b76ecae23e5171ae9c76ac46a",
      "word_count": 9,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c4.wav"
    },
    {
      "id": "full_story_part1_c5",
      "part": 1,
      "voice": "mr_white",
      "speaker": "mr_white",
      "voice_role": "dialogue:mr_white",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "\"Have you used it?\"",
      "text_sha256": "1e859f3797260a4d9a4fff0eff72076faeef89ba2a9c77f8f550868f7510f20d",
      "word_count": 4,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c5.wav"
    },
    {
      "id": "full_story_part1_c6",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 3,
      "source_paragraph_indices": [
        3
      ],
      "text": "asked Mr. White.",
      "text_sha256": "13c9bf1ab2297eacc552d3686b9baf0f23d725c86901ee5f5b6ff787bbf55bf9",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c6.wav"
    },
    {
      "id": "full_story_part1_c7",
      "part": 1,
      "voice": "morris",
      "speaker": "morris",
      "voice_role": "dialogue:morris",
      "paragraph_index": 4,
      "source_paragraph_indices": [
        4
      ],
      "text": "\"All three.\"",
      "text_sha256": "3bc0c9f43a22b30bd31b62be7d4b2682a972af8a078e11c13bc7e4fc6671c92a",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c7.wav"
    },
    {
      "id": "full_story_part1_c8",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 5,
      "source_paragraph_indices": [
        5
      ],
      "text": "Suddenly, the soldier threw it into the flames. Mr. White snatched it out.",
      "text_sha256": "d76f2a8afc1d6266d4c2fbf9c5ccbefb461dca1c45b8fbf792cb2bd2c5374eed",
      "word_count": 13,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c8.wav"
    },
    {
      "id": "full_story_part1_c9",
      "part": 1,
      "voice": "morris",
      "speaker": "morris",
      "voice_role": "dialogue:morris",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "\"Burn it,\"",
      "text_sha256": "ac7e1fd4cb4a065841bf5187502ecf4ea6509a3b859a2144cbcdae43108d1c39",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c9.wav"
    },
    {
      "id": "full_story_part1_c10",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "his friend warned.",
      "text_sha256": "725389d0461b25ddee1715166c1f4105f7ce9d6e1d0f68225550811a21170410",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c10.wav"
    },
    {
      "id": "full_story_part1_c11",
      "part": 1,
      "voice": "morris",
      "speaker": "morris",
      "voice_role": "dialogue:morris",
      "paragraph_index": 6,
      "source_paragraph_indices": [
        6
      ],
      "text": "\"And don't blame me if you keep it.\"",
      "text_sha256": "4c0291ddd7645185ee260e13184de5b1e4da9f5b7d8a7ee1fba58675ce27c730",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c11.wav"
    },
    {
      "id": "full_story_part1_c12",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "After their visitor left, Herbert laughed.",
      "text_sha256": "8b554b70c1e9db304b651c0d115f3d0ac1467329db49f62b7ed0745533629b12",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c12.wav"
    },
    {
      "id": "full_story_part1_c13",
      "part": 1,
      "voice": "herbert",
      "speaker": "herbert",
      "voice_role": "dialogue:herbert",
      "paragraph_index": 7,
      "source_paragraph_indices": [
        7
      ],
      "text": "\"Ask for two hundred pounds, Father. Enough to pay off the house!\"",
      "text_sha256": "ec0d26c416ad9b6d06b16fd547afa7fcdb0d6ce25b6358773c9f380d145238d5",
      "word_count": 12,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c13.wav"
    },
    {
      "id": "full_story_part1_c14",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "Mr. White raised the paw with a smile.",
      "text_sha256": "840403293997869af20744a1a4289796eb8f422861fe7dbcbb1c1d6e2fa0b4bd",
      "word_count": 8,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c14.wav"
    },
    {
      "id": "full_story_part1_c15",
      "part": 1,
      "voice": "mr_white",
      "speaker": "mr_white",
      "voice_role": "dialogue:mr_white",
      "paragraph_index": 8,
      "source_paragraph_indices": [
        8
      ],
      "text": "\"I wish for two hundred pounds.\"",
      "text_sha256": "54916a4f432bf2515c2c693552437543cdf45831017c62462d8c9ec549aad089",
      "word_count": 6,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c15.wav"
    },
    {
      "id": "full_story_part1_c16",
      "part": 1,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 9,
      "source_paragraph_indices": [
        9
      ],
      "text": "It twisted in his hand. He cried out and dropped it. They stared at the floor, but nothing else happened.",
      "text_sha256": "82866ed5d96f4ae3314bfb76c2ac1bcf012d9595bdb2b7690a327acef6e4bdc5",
      "word_count": 20,
      "split_reason": "comment_or_scene_boundary(呼び出し側指定のforce_split_before_paragraphs)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part1_c16.wav"
    },
    {
      "id": "full_story_part2_c1",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 10,
      "source_paragraph_indices": [
        10,
        11
      ],
      "text": "By breakfast, they were joking again. Herbert left for work, and Mrs. White cleared the table. Later, a stranger from the firm arrived.",
      "text_sha256": "08ea8f3e0e33ce5f70c9659243adf46c44b2beba33fd91c94142b070578bc3f4",
      "word_count": 23,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part2_c1.wav"
    },
    {
      "id": "full_story_part2_c2",
      "part": 2,
      "voice": "visitor",
      "speaker": "visitor",
      "voice_role": "dialogue:visitor",
      "paragraph_index": 12,
      "source_paragraph_indices": [
        12
      ],
      "text": "\"Your son was caught in the machinery,\"",
      "text_sha256": "e47414b5c4ecf58f9ef8b315751ee8ede17eeb1b25115d023551f842563051b5",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part2_c2.wav"
    },
    {
      "id": "full_story_part2_c3",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 12,
      "source_paragraph_indices": [
        12
      ],
      "text": "he said.",
      "text_sha256": "0669e82b2925c89aa39333900dd53b5eddf64c21d53190788d892d0e0af37799",
      "word_count": 2,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part2_c3.wav"
    },
    {
      "id": "full_story_part2_c4",
      "part": 2,
      "voice": "visitor",
      "speaker": "visitor",
      "voice_role": "dialogue:visitor",
      "paragraph_index": 12,
      "source_paragraph_indices": [
        12
      ],
      "text": "\"He is dead.\"",
      "text_sha256": "69d9bb4111ece0b3e4452b8ea70143929113a13aa2416240141e8d8ae000d933",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part2_c4.wav"
    },
    {
      "id": "full_story_part2_c5",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 13,
      "source_paragraph_indices": [
        13
      ],
      "text": "Mr. White reached for his wife's hand.",
      "text_sha256": "7e5b1cfd1675cf3eb47af1d891c5e55d43cf6369961b449b447e393deebcf3ee",
      "word_count": 7,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part2_c5.wav"
    },
    {
      "id": "full_story_part2_c6",
      "part": 2,
      "voice": "visitor",
      "speaker": "visitor",
      "voice_role": "dialogue:visitor",
      "paragraph_index": 14,
      "source_paragraph_indices": [
        14
      ],
      "text": "\"The firm accepts no responsibility, but offers you two hundred pounds in compensation.\"",
      "text_sha256": "4072340dc122dc0cb0ab3ca3916f8fa52cf04288dab9ccca08f74993ab677048",
      "word_count": 13,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part2_c6.wav"
    },
    {
      "id": "full_story_part2_c7",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 15,
      "source_paragraph_indices": [
        15,
        16
      ],
      "text": "Mr. White fell from his chair. A week after the burial, Mrs. White shook her husband awake. Her face was wet with tears.",
      "text_sha256": "d725da27e864f0363cb71d9d99b0e2dc27af7eb30207efba338d059c6a90a6c2",
      "word_count": 23,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part2_c7.wav"
    },
    {
      "id": "full_story_part2_c8",
      "part": 2,
      "voice": "mrs_white",
      "speaker": "mrs_white",
      "voice_role": "dialogue:mrs_white",
      "paragraph_index": 17,
      "source_paragraph_indices": [
        17
      ],
      "text": "\"The paw! We have two wishes left. Wish him alive again!\"",
      "text_sha256": "c1e8c0b1ed1047c0b612023037b46ef4a996a6c171e13d97dfb5a86e0940e220",
      "word_count": 11,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],
      "narration_path": "er026_output/family_z_production_e2e_01/the_monkeys_paw/run_sf_prod_01/b1b/narration/full_story_part2_c8.wav"
    },
    {
      "id": "full_story_part2_c9",
      "part": 2,
      "voice": "narrator",
      "speaker": "narrator",
      "voice_role": "narrator",
      "paragraph_index": 18,
      "source_paragraph_indices": [
        18
      ],
      "text": "He turned away.",
      "text_sha256": "9a9dcedad7108a5bf1946262c8afa471aaa363dd0ceabfea55807193af84b81b",
      "word_count": 3,
      "split_reason": "voice_boundary(分割不可避)",
      "warnings": [],

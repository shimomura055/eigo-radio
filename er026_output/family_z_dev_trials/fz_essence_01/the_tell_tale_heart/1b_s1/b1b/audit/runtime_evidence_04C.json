    {
      "clip_id": "full_story_part3_c1",
      "out_path": "er026_output/family_z_dev_trials/fz_essence_01/the_tell_tale_heart/1b_s1/b1b/narration/full_story_part3_c1.wav",
      "derived_segment_id": "full_story_part3_c1",
      "role": "FULL_STORY",
      "kind": "narrator",
      "voice": "Aoede",
      "model_ids_measured": [
        "gemini-3.8-flash-lite-tts"
      ],
      "style_label": "PD06",
      "style_prefix_sha256": "3a680861e4d9d1bc46ddba4dc1fc91f26c68f9f9c5e5e450a85fcba7fda43c2d",
      "effective_style_prefix_sha256": "3a680861e4d9d1bc46ddba4dc1fc91f26c68f9f9c5e5e450a85fcba7fda43c2d",
      "fallback_used": false,
      "fallback_attempts": [],
      "attempt_count": 1,
      "asr_text": "At four, three police officers knocked. A neighbor had heard a shriek. I welcomed them. The cry was mine, I explained, a bad dream. The old man was away in the country. I showed them every room, then brought chairs into his bedroom. My own chair stood directly above the body. You see how little I feared? They sat chatting. Soon my ears began to ring. Beneath their voices came a low, quick beating. I talked louder. I stood and paced, scraping my chair across the boards. Still it grew louder, louder. The officers went on smiling and talking. Not one seemed to hear. Yet they must hear. They knew. Their easy smiles were mocking me. How could you expect me to sit there and bear it? I did it, I screamed. Tear up the planks. Here, beneath my chair. It is the beating of his hideous heart.",
      "status": "OK",
      "z_adoption": "adopted",
      "local_rewrite_diff": null,
      "cooldown_occurred": false,
      "slowdown_applied": null,
      "slowdown_ratio": null,
      "speed_profile": {

    },
    {
     "clip_id": "full_story_part2_c6",
     "speaker": "mrs_sappleton",
     "voice": "Kore",
     "text": "\"I hope my niece has entertained you. You don't mind the open window? My husband and brothers will be back directly. They've been shooting. Such a mess they'll make of my carpets!\"",

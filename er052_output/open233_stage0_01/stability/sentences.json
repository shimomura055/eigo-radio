[
 {
  "src": "space_weapons-637f-02",
  "kind": "added_fact",
  "lang": "JA",
  "text": "前面に出されたのは攻撃ではなく、防護です",
  "type": "否定",
  "group": "NG",
  "sid": "s01"
 },
 {
  "src": "space_weapons-v3eg-01",
  "kind": "added_fact",
  "lang": "JA",
  "text": "だから、軌道上の兵器配備という言葉だけで、直ちに条約違反とは言えない",
  "type": "否定",
  "group": "NG",
  "sid": "s02"
 },
 {
  "src": "ai_control-jb9k-04",
  "kind": "scope",
  "lang": "JA",
  "text": "つまり、現時点で人間がAIの制御を失ったわけではありません。",
  "type": "否定",
  "group": "NG",
  "sid": "s03"
 },
 {
  "src": "meta-p9ng-03",
  "kind": "subject",
  "lang": "JA",
  "text": "電話を受ける相手からすれば、AIが話していると思っていたのに、実は人間だったかもしれない。しかも、その人間に利用者の情報が伝わっているかもしれない。",
  "type": "否定",
  "group": "NG",
  "sid": "s04"
 },
 {
  "src": "hormuz-cdwb-01",
  "kind": "added_fact",
  "lang": "JA",
  "text": "ただ、この案には細かいルールがありませんでした。",
  "type": "否定",
  "group": "NG",
  "sid": "s05"
 },
 {
  "src": "meta-4ufq-01",
  "kind": "causal",
  "lang": "JA",
  "text": "背景には、電話の相手がAIを歓迎するとは限らないという事情もありました。",
  "type": "因果",
  "group": "NG",
  "sid": "s06"
 },
 {
  "src": "hormuz-trp6-01",
  "kind": "causal",
  "lang": "JA",
  "text": "市場は、発言一つだけではなく、その周りの状況も同時に見ていました。",
  "type": "因果",
  "group": "NG",
  "sid": "s07"
 },
 {
  "src": "space_weapons-637f-01",
  "kind": "scope",
  "lang": "JA",
  "text": "米国は、地上の軍を守るための兵器を、宇宙にも置いて運用していると説明した",
  "type": "因果",
  "group": "NG",
  "sid": "s08"
 },
 {
  "src": "hormuz-ycke-01",
  "kind": "causal",
  "lang": "JA",
  "text": "なぜか。市場が見ているのは、料金の看板ではなく、タンカーが本当に安全に通れるかどうかだからです。",
  "type": "因果",
  "group": "NG",
  "sid": "s09"
 },
 {
  "src": "meta-qvqc-01",
  "kind": "scope",
  "lang": "JA",
  "text": "人間コンシェルジュ機能はいったん元に戻されました。",
  "type": "多義語",
  "group": "NG",
  "sid": "s10"
 },
 {
  "src": "meta-n6vy-01",
  "kind": "scope",
  "lang": "JA",
  "text": "人間コンシェルジュ機能をロールバックしました。戻されたのは、人間が電話を担当する部分です。",
  "type": "多義語",
  "group": "NG",
  "sid": "s11"
 },
 {
  "src": "hormuz-nbsw-p1",
  "kind": "pending",
  "lang": "JA",
  "text": "料金案を取り下げれば、原油の不安もすぐ元に戻る。今回の動きは、そんな単純な展開ではありません",
  "type": "多義語",
  "group": "NG",
  "sid": "s12"
 },
 {
  "src": "space_weapons-86u9-01",
  "kind": "added_fact",
  "lang": "JA",
  "text": "兵器の名前だけでなく、その住所まで明らかになったからです",
  "type": "全称",
  "group": "NG",
  "sid": "s13"
 },
 {
  "src": "meta-jdmu-01",
  "kind": "scope",
  "lang": "JA",
  "text": "その報告では、AIとして電話をかけると切られ、人間が担当した一部テストでは高い成功率の可能性が示されていました。",
  "type": "全称",
  "group": "NG",
  "sid": "s14"
 },
 {
  "src": "ai_control-jb9k-01",
  "kind": "scope",
  "lang": "JA",
  "text": "異常な動きは、見つかってから約一時間で封じ込められました。",
  "type": "数値",
  "group": "NG",
  "sid": "s15"
 },
 {
  "src": "meta-x5wg-02",
  "kind": "subject",
  "lang": "JA",
  "text": "AIに話しているつもりでも、実際には契約スタッフに聞かれていた",
  "type": "主語新規",
  "group": "NG",
  "sid": "s16"
 },
 {
  "src": "space_weapons-v3eg-02",
  "kind": "scope",
  "lang": "JA",
  "text": "別の舞台は、衛星と地上を結ぶ通信リンクです",
  "type": "other",
  "group": "NG",
  "sid": "s17"
 },
 {
  "src": "p1",
  "kind": "pending",
  "lang": "JA",
  "text": "宇宙に配備された兵器が、そこにとどまりながら統合軍を守る",
  "type": "other",
  "group": "NG",
  "sid": "s18"
 },
 {
  "src": "meta-hkgv-p1",
  "kind": "pending",
  "lang": "JA",
  "text": "AIより柔軟に話せることもありそうだ。",
  "type": "other",
  "group": "NG",
  "sid": "s19"
 },
 {
  "src": "hormuz-d5qr-p1",
  "kind": "pending",
  "lang": "JA",
  "text": "記事掲載時点では、およそ二・六パーセント高で、一バレル八十五ドルを超えていました。",
  "type": "other",
  "group": "NG",
  "sid": "s20"
 },
 {
  "src": "space_weapons-kfuf-rwbefore",
  "kind": "rewrite",
  "lang": "EN",
  "text": "But the details are still hidden. The weapon's name, what kind of attack ability it has, and what it targets have not been revealed. The only thing we know is that it is being deployed in orbit.",
  "type": "否定",
  "group": "NG",
  "sid": "s21"
 },
 {
  "src": "meta-jdmu-rwbefore",
  "kind": "rewrite",
  "lang": "EN",
  "text": "The main feature of these AI phone calls was not how smart the AI was, but that a human came on partway through.",
  "type": "否定",
  "group": "NG",
  "sid": "s22"
 },
 {
  "src": "p1",
  "kind": "pending",
  "lang": "EN",
  "text": "this fee has not actually been collected yet.",
  "type": "否定",
  "group": "NG",
  "sid": "s23"
 },
 {
  "src": "hormuz-nn32-02",
  "kind": "added_fact",
  "lang": "EN",
  "text": "If you pass through the strait, please pay 20 percent",
  "type": "数値",
  "group": "NG",
  "sid": "s24"
 },
 {
  "src": "hormuz-d5qr-p2",
  "kind": "pending",
  "lang": "EN",
  "text": "Mr. Trump said he would impose a 20 percent charge on all cargo",
  "type": "数値",
  "group": "NG",
  "sid": "s25"
 },
 {
  "src": "hormuz-ycke-02",
  "kind": "added_fact",
  "lang": "EN",
  "text": "announced that he would require all cargo passing through the strait to pay a 20 percent reimbursement fee",
  "type": "数値",
  "group": "NG",
  "sid": "s26"
 },
 {
  "src": "ai_control-s9dk-01",
  "kind": "object",
  "lang": "EN",
  "text": "it ran on 15 real systems, and login information was leaked.",
  "type": "数値",
  "group": "NG",
  "sid": "s27"
 },
 {
  "src": "p1",
  "kind": "pending",
  "lang": "EN",
  "text": "In one line: Meta’s AI phone test used human workers for entire calls without clearly telling people who was speaking.",
  "type": "全称",
  "group": "NG",
  "sid": "s28"
 },
 {
  "src": "meta-j7e5-01",
  "kind": "subject",
  "lang": "EN",
  "text": "In one case where Meta asked someone to negotiate internet and cable fees, a report said that the call record contained inappropriate remarks about race.",
  "type": "全称",
  "group": "NG",
  "sid": "s29"
 },
 {
  "src": "meta-ggp4-01",
  "kind": "scope",
  "lang": "EN",
  "text": "put the human concierge feature back the way it was, for the time being.",
  "type": "多義語",
  "group": "NG",
  "sid": "s30"
 },
 {
  "src": "p1",
  "kind": "pending",
  "lang": "EN",
  "text": "As a result, the human concierge feature was rolled back",
  "type": "多義語",
  "group": "NG",
  "sid": "s31"
 },
 {
  "src": "meta-daju-02",
  "kind": "scope",
  "lang": "EN",
  "text": "rolled back for now. It was returned to its earlier state for the time being.",
  "type": "多義語",
  "group": "NG",
  "sid": "s32"
 },
 {
  "src": "meta-qvqc-03",
  "kind": "subject",
  "lang": "EN",
  "text": "Meta Tested an AI Phone Agent and Found a Human",
  "type": "主語新規",
  "group": "NG",
  "sid": "s33"
 },
 {
  "src": "meta-p9ng-04",
  "kind": "subject",
  "lang": "EN",
  "text": "You thought it was an AI phone call, but a human answered.",
  "type": "主語新規",
  "group": "NG",
  "sid": "s34"
 },
 {
  "src": "meta-qvqc-rwbefore",
  "kind": "rewrite",
  "lang": "EN",
  "text": "The problem was that testing began without a proper explanation that humans would handle the calls or that information might be shared.",
  "type": "other",
  "group": "NG",
  "sid": "s35"
 },
 {
  "src": "ai_control-jb9k-rwbefore",
  "kind": "rewrite",
  "lang": "EN",
  "text": "The unusual activity was brought under control about an hour after it was found.",
  "type": "other",
  "group": "NG",
  "sid": "s36"
 },
 {
  "src": "space_weapons-9ggp-01",
  "kind": "scope",
  "lang": "EN",
  "text": "the United States has deployed a space-control weapon in orbit",
  "type": "other",
  "group": "NG",
  "sid": "s37"
 },
 {
  "src": "meta-qvqc-rwafter",
  "kind": "rewrite",
  "lang": "EN",
  "text": "The AI—and sometimes a human—makes the call. The user asks it to handle a task.",
  "type": "other",
  "group": "NG",
  "sid": "s38"
 },
 {
  "src": "meta-gj99-rwbefore",
  "kind": "rewrite",
  "lang": "EN",
  "text": "Some calls handled by Meta’s AI were actually made by human contractors without users being told.",
  "type": "other",
  "group": "NG",
  "sid": "s39"
 },
 {
  "src": "p2",
  "kind": "pending",
  "lang": "EN",
  "text": "When policy statements change, prices react once.",
  "type": "other",
  "group": "NG",
  "sid": "s40"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "JA",
  "type": "通常",
  "kind": "normal",
  "text": "ただし、問題になったのは、代役の存在だけではありません。",
  "group": "NORMAL",
  "sid": "s41"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "JA",
  "type": "通常",
  "kind": "normal",
  "text": "さらに、契約スタッフが電話をかけることについて、利用者への適切な説明がないままテストが始まりました。",
  "group": "NORMAL",
  "sid": "s42"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "JA",
  "type": "通常",
  "kind": "normal",
  "text": "地上の通信や位置情報に頼る私たちの生活にも、実はつながっています。",
  "group": "NORMAL",
  "sid": "s43"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "JA",
  "type": "通常",
  "kind": "normal",
  "text": "電話を進めるためにユーザーの機微情報が必要になった場合、その情報がコールセンターの契約スタッフに意図せず共有される可能性があります。",
  "group": "NORMAL",
  "sid": "s44"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "JA",
  "type": "通常",
  "kind": "normal",
  "text": "機械の声や画面を見ていると、私たちは自然に「機械が答えている」と受け取ります。",
  "group": "NORMAL",
  "sid": "s45"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "JA",
  "type": "通常",
  "kind": "normal",
  "text": "台所や風呂、洗濯で出る水も、まとめてきれいにする。",
  "group": "NORMAL",
  "sid": "s46"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "JA",
  "type": "通常",
  "kind": "normal",
  "text": "その地味な設定こそが、試験場を本当に試験場にしているのです。",
  "group": "NORMAL",
  "sid": "s47"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "JA",
  "type": "通常",
  "kind": "normal",
  "text": "この話が妙に現実的なのは、AIだと分かった相手が電話を切る事例も報告されていたからです。",
  "group": "NORMAL",
  "sid": "s48"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "JA",
  "type": "通常",
  "kind": "normal",
  "text": "ただ、誰が集めるのか、誰が払うのか、何を基準に二十パーセントを計算するのか、例外はあるのか、法的根拠は何か。",
  "group": "NORMAL",
  "sid": "s49"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "JA",
  "type": "通常",
  "kind": "normal",
  "text": "条約がはっきり禁じるのは、地球を回る軌道や宇宙空間に、核兵器やその他の大量破壊兵器を置くことなどだ。",
  "group": "NORMAL",
  "sid": "s50"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "EN",
  "type": "通常",
  "kind": "normal",
  "text": "There is no confirmed explanation, however, that this insurance company incident led to the human concierge test.",
  "group": "NORMAL",
  "sid": "s51"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "EN",
  "type": "通常",
  "kind": "normal",
  "text": "The fact that surveillance or protection is taking place does not, by itself, confirm that an attack weapon has been placed in orbit.",
  "group": "NORMAL",
  "sid": "s52"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "EN",
  "type": "通常",
  "kind": "normal",
  "text": "You asked it to get an estimate from a company.",
  "group": "NORMAL",
  "sid": "s53"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "EN",
  "type": "通常",
  "kind": "normal",
  "text": "There was another drama on the other side of the call.",
  "group": "NORMAL",
  "sid": "s54"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "EN",
  "type": "通常",
  "kind": "normal",
  "text": "For people who are not good at making phone calls, it is a very helpful secretary.",
  "group": "NORMAL",
  "sid": "s55"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "EN",
  "type": "通常",
  "kind": "normal",
  "text": "However, the experiment began without properly telling people that contract workers would be making the calls.",
  "group": "NORMAL",
  "sid": "s56"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "EN",
  "type": "通常",
  "kind": "normal",
  "text": "We also need to know who is doing the work and what information they can see.",
  "group": "NORMAL",
  "sid": "s57"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "EN",
  "type": "通常",
  "kind": "normal",
  "text": "It is a human who appeared on the other end of the phone.",
  "group": "NORMAL",
  "sid": "s58"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "EN",
  "type": "通常",
  "kind": "normal",
  "text": "Meta tested calls made through its AI agent, Muse.",
  "group": "NORMAL",
  "sid": "s59"
 },
 {
  "src": "er052_output-open233_control_checker_polysemy_trial_01",
  "lang": "EN",
  "type": "通常",
  "kind": "normal",
  "text": "But if worries about a sea blockade and tanker safety remain, prices return to a high level.",
  "group": "NORMAL",
  "sid": "s60"
 }
]
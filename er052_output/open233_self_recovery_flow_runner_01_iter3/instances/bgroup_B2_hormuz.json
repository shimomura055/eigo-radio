        {
          "claim_text": "“It looked like a very large fee would appear every time a ship passed through the strait.”",
          "origin": null,
          "related_fact_id": "HF-002, HF-003",
          "dev": {
            "claim_in_article": "“It looked like a very large fee would appear every time a ship passed through the strait.”",
            "origin": null,
            "related_fact_id": "HF-002, HF-003",
            "severity": "MAJOR",
            "changed_actor": false,

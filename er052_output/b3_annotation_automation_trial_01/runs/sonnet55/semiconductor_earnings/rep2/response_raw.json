   "text": "=== ANNOTATED_BRIEF_BEGIN ===\n# Selected Fact Brief\n\n## Storyline\nBroadcomの2026年度【周辺数値】第3四半期【周辺数値】決算では連結売上高が295億9,100万ドル【中核数値】、AI半導体売上高が167億ドル【中核数値】となり、CEOはAI関連需要が非常に強いと述べ、次四半期の連結売上高を約348億ドル【中核数値】と見込んだ。ただし、この発表が「最も最近」かはLedger上確定できない。\n\n## Selected Facts\n- 【事実1】Broadcomは2026年9月2日【周辺数値】に、2026年8月2日【周辺数値】終了の2026年度【周辺数値】第3四半期【周辺数値】決算を発表した。連結純売上高は295億9,100万ドル【中核数値】。AI半導体売上高は167億ドル【中核数値】で、CEOは前年同期比221％【周辺数値】増、前四半期比54％【周辺数値】増と説明した。次の四半期の連結売上高について、会社は約348億ドル【中核数値】を見込んだ。CEOはカスタムAIアクセラレーターとネットワーキングへの需要が引き続き非常に強いと述べた。これらの需要評価と業績・見通しの間に、Ledgerで確認されていない因果関係を付け加えないこと。また、Ledgerは「最も最近」の発表という選定条件を確定できないとしているため、Broadcomをその条件を満たす企業と断定しないこと。\n=== ANNOTATED_BRIEF_END ===\n=== SIDECAR_JSON_BEGIN ===\n{\n  \"slug\": \"semiconductor_earnings\",\n  \"annotator\": \"A\",\n  \"spec_sha256\": \"8d145c3d7cb3953ef2d344056e2e9979698fff7d1f60aec7a6b6d922e7cf1e57\",\n  \"brief_sha256\": \"12638264343d0c336dcc99a98f3c164dc57e5f0cfdf87f941789c234cdbc0a13\",\n  \"facts\": [\n    {\"n\": 1, \"ledger_ids\": [\"F1\", \"F2\", \"F3\", \"F4\", \"F6\"]}\n  ],\n  \"numbers\": [\n    {\"surface\": \"2026年度\", \"kind\": \"year\", \"concept\": \"C_fy\", \"ledger_ids\": [\"F1\", \"F2\", \"F3\", \"F4\", \"F5\"], \"class\": \"peripheral\", \"role\": \"会計年度(年だけ)\"},\n    {\"surface\": \"第3四半期\", \"kind\": \"ordinal\", \"concept\": \"C_q3\", \"ledger_ids\": [\"F1\", \"F2\", \"F3\"], \"class\": \"peripheral\", \"role\": \"四半期の序数(識別子)\"},\n    {\"surface\": \"295億9,100万ドル\", \"kind\": \"magnitude\", \"concept\": \"C_rev\", \"ledger_ids\": [\"F2\"], \"class\": \"core\", \"role\": \"第3四半期の連結純売上高\"},\n    {\"surface\": \"167億ドル\", \"kind\": \"magnitude\", \"concept\": \"C_ai\", \"ledger_ids\": [\"F3\"], \"class\": \"core\", \"role\": \"AI半導体売上高\"},\n    {\"surface\": \"約348億ドル\", \"kind\": \"magnitude\", \"concept\": \"C_guide\", \"ledger_ids\": [\"F4\"], \"class\": \"core\", \"role\": \"次四半期の連結売上高見通し\"},\n    {\"surface\": \"2026年9月2日\", \"kind\": \"date_time\", \"concept\": \"C_date\", \"ledger_ids\": [\"F1\", \"F4\", \"F6\"], \"class\": \"peripheral\", \"role\": \"決算発表日\"},\n    {\"surface\": \"2026年8月2日\", \"kind\": \"date_time\", \"concept\": \"C_date\", \"ledger_ids\": [\"F1\", \"F2\", \"F3\"], \"class\": \"peripheral\", \"role\": \"第3四半期の終了日\"},\n    {\"surface\": \"221％\", \"kind\": \"magnitude\", \"concept\": \"C_yoy\", \"ledger_ids\": [\"F3\"], \"class\": \"peripheral\", \"role\": \"AI半導体売上高の前年同期比増加率\"},\n    {\"surface\": \"54％\", \"kind\": \"magnitude\", \"concept\": \"C_qoq\", \"ledger_ids\": [\"F3\"], \"class\": \"peripheral\", \"role\": \"AI半導体売上高の前四半期比増加率\"}\n  ],\n  \"unmapped_claims\": [\n    {\"text\": \"CEOはAI関連需要が非常に強いと述べ(Storyline)\", \"type\": \"generalization\"},\n    {\"text\": \"これらの需要評価と業績・見通しの間に、Ledgerで確認されていない因果関係を付け加えないこと。\", \"type\": \"qualifier\"}\n  ],\n  \"annotation_notes\": [\n    {\"where\": \"Selected Facts 節の1項目(段落)全体\", \"question\": \"文ごとの根拠はF1・F2・F3・F4・F6の5つで、分けると4つ以上になる。分けるか\", \"options\": [\"F1/F2/F3/F4/F6に5分割\", \"分けない(1事実)\"], \"chosen\": \"分けない(1事実)。ledger_idsはF1,F2,F3,F4,F6を併記\", \"rule\": \"§2 / §5-1\"},\n    {\"where\": \"事実1 末尾の限定する2文(因果を付け加えない/最も最近の条件を断定しない)\", \"question\": \"別の台帳ID(F1)に由来する限定文を別事実にするか\", \"options\": [\"別事実にする\", \"直前の事実に含めF1を追加\"], \"chosen\": \"別事実にせず同じ事実に含め、F1をledger_idsに含める\", \"rule\": \"§2\"},\n    {\"where\": \"「2026年度第3四半期」(Storyline・本文)\", \"question\": \"1つの表記か、年と序数に分けるか。種類は何か\", \"options\": [\"2026年度第3四半期を1表記\", \"2026年度(year)と第3四半期(ordinal)に分ける\"], \"chosen\": \"2026年度(year)と第3四半期(ordinal)に分け、どちらも周辺\", \"rule\": \"§3-2 / §5-6\"},\n    {\"where\": \"概念 C_date(2026年9月2日・2026年8月2日)\", \"question\": \"台帳ID(F1)が共通で主数字(2)が同じなので同一概念にするか\", \"options\": [\"別概念にする\", \"同一概念にする\"], \"chosen\": \"同一概念C_dateにまとめ、kindはdate_timeでそろえる\", \"rule\": \"§3-3\"},\n    {\"where\": \"2026年8月2日の適格性\", \"question\": \"date_or_period欄の先頭の日付表現が2026年度第3四半期(2026年8月2日終了)なのか、F1では2026年9月2日なのか、確認しきれない\", \"options\": [\"適格\", \"不適格・周辺\"], \"chosen\": \"周辺。同一概念C_dateは2026年9月2日が適格だが上限の外でもある\", \"rule\": \"§5-2\"},\n    {\"where\": \"概念 C_dateの上限\", \"question\": \"2026年9月2日は適格だが、上限3は中核の量3つ(Storylineの量)で埋まる\", \"options\": [\"中核\", \"周辺\"], \"chosen\": \"周辺\", \"rule\": \"§3-5-6 cap超過で周辺化\"},\n    {\"where\": \"概念 C_yoy(221％)・C_qoq(54％)\", \"question\": \"numeric_valueに含まれ適格だが、優先順位が3位以下で上限3の外\", \"options\": [\"中核\", \"周辺\"], \"chosen\": \"周辺\", \"rule\": \"§3-5-6 cap超過で周辺化\"},\n    {\"where\": \"295億9,100万ドルの主数字\", \"question\": \"末尾の数字の並びは9,100。F2のnumeric_valueの括弧内に「295億9,100万ドル」があり、29,591とも併記されている\", \"options\": [\"適格\", \"周辺\"], \"chosen\": \"適格として扱う。Storylineの量で上限3の内側なので中核\", \"rule\": \"§3-5\"},\n    {\"where\": \"n=7(量5: 295億9,100万ドル・167億ドル・221％・54％・約348億ドル、日付概念1: C_date、ほか2026年度・第3四半期は数えない)\", \"question\": \"上限の計算\", \"options\": [\"上限3\"], \"chosen\": \"n=6、上限3。中核はStorylineの量3つ(295億9,100万ドル・167億ドル・約348億ドル)\", \"rule\": \"§3-5\"},\n    {\"where\": \"Storyline「AI関連需要」\", \"question\": \"台帳F6はカスタムAIアクセラレーターとネットワーキングへの需要。「AI関連需要」はそれより広い表現\", \"options\": [\"generalizationとして記録、STOPにしない\", \"STOP\"], \"chosen\": \"generalizationとして記録。Storylineの中心主張と数字は台帳にあるのでSTOPにしない\", \"rule\": \"§4\"}\n  ]\n}\n=== SIDECAR_JSON_END ==="

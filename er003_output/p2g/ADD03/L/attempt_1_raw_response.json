          "annotations": [],
          "text": "{\"items\":[{\"rank\":1,\"display_phrase\":\"blockade\",\"source_span\":\"blockade\",\"source_sentence\":\"Because the toll was gone, but the blockade targeting ships linked to Iran was still in place.\",\"ja_gloss\":\"海上封鎖\",\"phrase_type\":\"word\",\"normalization_type\":\"none\",\"normalization_note\":\"本文の単数名詞をそのまま採用。\",\"selection_reason\":\"料金案の撤回後も市場が安心できなかった最大の理由を表す中心語。\",\"listening_difficulty_reason\":\"語形から意味を推測しにくく、聞き逃すと船が直面する危険を理解できない。\",\"inference_transparency\":\"LOW\",\"topic_exposure_dependency\":\"MEDIUM\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"HIGH\",\"portfolio_category\":\"domain_expression\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":2,\"display_phrase\":\"toll\",\"source_span\":\"tolls\",\"source_sentence\":\"Ships passing through the Strait of Hormuz should not be charged tolls or transit fees.\",\"ja_gloss\":\"通行料\",\"phrase_type\":\"word\",\"normalization_type\":\"noun_canonical\",\"normalization_note\":\"複数形 tolls を単数の見出し形 toll にした。\",\"selection_reason\":\"政策案、法的問題、市場の反応を結ぶ記事全体の中心語。\",\"listening_difficulty_reason\":\"道路以外の文脈で使われると即座に意味を取りにくく、発音も短いため聞き落としやすい。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"LOW\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"LOW\",\"portfolio_category\":\"domain_expression\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":3,\"display_phrase\":\"be in place\",\"source_span\":\"was still in place\",\"source_sentence\":\"Because the toll was gone, but the blockade targeting ships linked to Iran was still in place.\",\"ja_gloss\":\"実施中である\",\"phrase_type\":\"collocation\",\"normalization_type\":\"collocation_core\",\"normalization_note\":\"時制を基本形に戻し、文脈上の副詞 still を外して核となる表現を抽出。\",\"selection_reason\":\"料金は消えた一方で封鎖は継続しているという重要な対比を支える。\",\"listening_difficulty_reason\":\"文字どおりの「場所にある」と処理すると、措置が有効なままだという意味を逃しやすい。\",\"inference_transparency\":\"LOW\",\"topic_exposure_dependency\":\"LOW\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"MEDIUM\",\"spoiler_risk\":\"MEDIUM\",\"portfolio_category\":\"causal_contrast\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":4,\"display_phrase\":\"freedom of navigation\",\"source_span\":\"freedom of navigation\",\"source_sentence\":\"It also collided head-on with the basic principle of freedom of navigation.\",\"ja_gloss\":\"航行の自由\",\"phrase_type\":\"technical_term\",\"normalization_type\":\"none\",\"normalization_note\":\"国際法上の定着した用語をそのまま採用。\",\"selection_reason\":\"提案が市場だけでなく国際法上も問題だったことを理解するための重要語。\",\"listening_difficulty_reason\":\"各単語は平易でも、まとまりとして法的原則を指すことは題材知識なしでは判断しにくい。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"HIGH\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"MEDIUM\",\"portfolio_category\":\"domain_expression\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":5,\"display_phrase\":\"breathe a sigh of relief\",\"source_span\":\"breathe a sigh of relief\",\"source_sentence\":\"So, did the markets breathe a sigh of relief?\",\"ja_gloss\":\"ほっと胸をなで下ろす\",\"phrase_type\":\"idiom\",\"normalization_type\":\"idiom_core\",\"normalization_note\":\"疑問文中に基本形で現れる慣用句を、そのまま見出し化。\",\"selection_reason\":\"政策撤回に対する市場の反応を問う、記事の転換点となる表現。\",\"listening_difficulty_reason\":\"5語が連続して弱く発音されやすく、個々の語から市場心理を瞬時にまとめにくい。\",\"inference_transparency\":\"LOW\",\"topic_exposure_dependency\":\"LOW\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"HIGH\",\"spoiler_risk\":\"LOW\",\"portfolio_category\":\"figurative_emotional\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":6,\"display_phrase\":\"hardly surprising\",\"source_span\":\"hardly surprising\",\"source_sentence\":\"So, it is hardly surprising that the industry reacted with both shock and doubt.\",\"ja_gloss\":\"ほとんど驚くことではない\",\"phrase_type\":\"collocation\",\"normalization_type\":\"none\",\"normalization_note\":\"評価表現の核となる2語を抽出。\",\"selection_reason\":\"海運業界の反応が当然だったという話者の評価を正しく取るために重要。\",\"listening_difficulty_reason\":\"hardly を「非常に」のように誤処理すると、文全体の肯否を逆に理解する恐れがある。\",\"inference_transparency\":\"LOW\",\"topic_exposure_dependency\":\"LOW\",\"comprehension_impact\":\"MEDIUM\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"LOW\",\"portfolio_category\":\"compact_listening_pattern\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":7,\"display_phrase\":\"intraday high\",\"source_span\":\"intraday high\",\"source_sentence\":\"After the plan was dropped, prices fell from an intraday high above 87 dollars a barrel.\",\"ja_gloss\":\"日中高値\",\"phrase_type\":\"technical_term\",\"normalization_type\":\"none\",\"normalization_note\":\"金融市場で使われる複合名詞をそのまま採用。\",\"selection_reason\":\"原油価格がどの水準から下落したかを正確に理解するための市場用語。\",\"listening_difficulty_reason\":\"intraday が音声では一語として速く流れ、high を単なる形容詞と誤認しやすい。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"HIGH\",\"comprehension_impact\":\"MEDIUM\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"LOW\",\"portfolio_category\":\"domain_expression\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":8,\"display_phrase\":\"Very Large Crude Carrier\",\"source_span\":\"Very Large Crude Carrier\",\"source_sentence\":\"For a fully loaded Very Large Crude Carrier, the proposed fee could have reached about 30 million dollars.\",\"ja_gloss\":\"大型原油タンカー\",\"phrase_type\":\"technical_term\",\"normalization_type\":\"none\",\"normalization_note\":\"船舶の正式な分類名を4語のまま採用。\",\"selection_reason\":\"1隻で約3,000万ドルという料金規模を理解するうえで必要な船種名。\",\"listening_difficulty_reason\":\"一般語が連続する専門名称で、crude を「粗い」と解釈すると原油タンカーだと分からない。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"HIGH\",\"comprehension_impact\":\"MEDIUM\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"LOW\",\"portfolio_category\":\"domain_expression\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":9,\"display_phrase\":\"collide head-on with\",\"source_span\":\"collided head-on with\",\"source_sentence\":\"It also collided head-on with the basic principle of freedom of navigation.\",\"ja_gloss\":\"～と真っ向から衝突する\",\"phrase_type\":\"collocation\",\"normalization_type\":\"verb_base\",\"normalization_note\":\"過去形 collided を基本形 collide に戻した。\",\"selection_reason\":\"提案と国際法上の原則が強く対立したことを印象的に示す。\",\"listening_difficulty_reason\":\"物理的な衝突ではなく抽象的な対立を表す比喩用法で、head-on も連結して聞こえやすい。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"LOW\",\"comprehension_impact\":\"MEDIUM\",\"figurative_or_emotional_value\":\"HIGH\",\"spoiler_risk\":\"MEDIUM\",\"portfolio_category\":\"figurative_emotional\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":10,\"display_phrase\":\"hang over\",\"source_span\":\"hangs over\",\"source_sentence\":\"The tollbooth sign is gone—but the smell of gunpowder still hangs over the strait.\",\"ja_gloss\":\"不安の影を落とす\",\"phrase_type\":\"phrasal_verb\",\"normalization_type\":\"verb_base\",\"normalization_note\":\"三人称単数形 hangs を基本形 hang に戻した。\",\"selection_reason\":\"政策変更後も軍事的な脅威が残るという結論の感情的な核を表す。\",\"listening_difficulty_reason\":\"物が上に掛かるという字義ではなく、脅威や不安が残り続ける比喩として処理する必要がある。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"LOW\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"HIGH\",\"spoiler_risk\":\"MEDIUM\",\"portfolio_category\":\"figurative_emotional\",\"portfolio_substitution\":true,\"portfolio_substitution_reason\":\"同程度の専門語候補よりも、締めくくりの比喩と感情を理解できる表現を優先した。\"}]}",

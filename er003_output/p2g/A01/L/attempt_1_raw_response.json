          "text": "{\"items\":[{\"rank\":1,\"display_phrase\":\"stoppage time\",\"source_span\":\"stoppage time\",\"source_sentence\":\"Then came stoppage time.\",\"ja_gloss\":\"アディショナルタイム\",\"phrase_type\":\"technical_term\",\"normalization_type\":\"none\",\"normalization_note\":\"本文どおりのサッカー用語。\",\"selection_reason\":\"試合終盤の逆転劇が始まる時間帯を示す、展開上不可欠な語。\",\"listening_difficulty_reason\":\"一般語の意味からサッカー特有の時間帯を推測しにくい。\",\"inference_transparency\":\"LOW\",\"topic_exposure_dependency\":\"HIGH\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"LOW\",\"portfolio_category\":\"domain_expression\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"題材理解への直接的な支援価値により選定。\"},{\"rank\":2,\"display_phrase\":\"send in a cross\",\"source_span\":\"sent in a cross\",\"source_sentence\":\"Then, in the 55th minute, Rogers sent in a cross.\",\"ja_gloss\":\"クロスを入れる\",\"phrase_type\":\"collocation\",\"normalization_type\":\"verb_base\",\"normalization_note\":\"sentを基本形sendに変更。本文中で二度使われる。\",\"selection_reason\":\"両チームの得点場面に繰り返し現れ、攻撃の流れを理解する鍵になる。\",\"listening_difficulty_reason\":\"crossのサッカーでの名詞用法と、弱く発音されやすいinを同時に処理する必要がある。\",\"inference_transparency\":\"LOW\",\"topic_exposure_dependency\":\"HIGH\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"MEDIUM\",\"portfolio_category\":\"domain_expression\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"反復される中心的な得点表現として選定。\"},{\"rank\":3,\"display_phrase\":\"shot on target\",\"source_span\":\"a single shot on target\",\"source_sentence\":\"Neither team managed a single shot on target before the break.\",\"ja_gloss\":\"枠内シュート\",\"phrase_type\":\"technical_term\",\"normalization_type\":\"collocation_core\",\"normalization_note\":\"数量表現a singleを外し、用語の核を抽出。\",\"selection_reason\":\"静かな前半の内容を端的に示す重要なサッカー表現。\",\"listening_difficulty_reason\":\"on targetを単に「目標の上」と逐語的に取ると、枠内シュートという意味に届きにくい。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"HIGH\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"LOW\",\"portfolio_category\":\"domain_expression\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"前半の試合状況を理解するための直接的な選定。\"},{\"rank\":4,\"display_phrase\":\"power a header\",\"source_span\":\"powered a header into the net\",\"source_sentence\":\"Substitute Lautaro Martínez powered a header into the net.\",\"ja_gloss\":\"強烈なヘディングを放つ\",\"phrase_type\":\"collocation\",\"normalization_type\":\"verb_base\",\"normalization_note\":\"poweredを基本形powerにし、場所表現を除いて核を抽出。\",\"selection_reason\":\"決勝点がどのように決まったかを表す、情報密度の高い表現。\",\"listening_difficulty_reason\":\"powerの他動詞用法とheaderのサッカー用法を瞬時に結び付ける必要がある。\",\"inference_transparency\":\"LOW\",\"topic_exposure_dependency\":\"HIGH\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"MEDIUM\",\"spoiler_risk\":\"HIGH\",\"portfolio_category\":\"domain_expression\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"決定的な得点描写の理解に直結するため選定。\"},{\"rank\":5,\"display_phrase\":\"provide an assist\",\"source_span\":\"provided two assists\",\"source_sentence\":\"At 39, the captain provided two assists that night.\",\"ja_gloss\":\"アシストを記録する\",\"phrase_type\":\"collocation\",\"normalization_type\":\"collocation_core\",\"normalization_note\":\"providedを基本形provideにし、複数形を単数の見出し形に変更。\",\"selection_reason\":\"Messiが得点者ではなく創造役だったという分析の中心表現。\",\"listening_difficulty_reason\":\"assists末尾の子音連続が聞き取りにくく、一般的なassistの意味とも区別が必要。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"HIGH\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"HIGH\",\"portfolio_category\":\"domain_expression\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"記事の第一の分析ポイントを支えるため選定。\"},{\"rank\":6,\"display_phrase\":\"take players off\",\"source_span\":\"took off players\",\"source_sentence\":\"England took off players including Rice and strengthened their defense, hoping to protect their lead.\",\"ja_gloss\":\"選手を交代で下げる\",\"phrase_type\":\"phrasal_verb\",\"normalization_type\":\"other\",\"normalization_note\":\"tookをtakeに戻し、学習見出しとして自然な分離形take players offに整理。\",\"selection_reason\":\"イングランドの守備的な交代策を理解するのに必要な句動詞。\",\"listening_difficulty_reason\":\"take offの「脱ぐ・離陸する」という既知の意味が干渉しやすく、offも弱く発音される。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"MEDIUM\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"MEDIUM\",\"portfolio_category\":\"compact_listening_pattern\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"戦術上の因果関係を理解するための直接的な選定。\"},{\"rank\":7,\"display_phrase\":\"go the other way\",\"source_span\":\"went the other way\",\"source_sentence\":\"Argentina went the other way.\",\"ja_gloss\":\"反対の方針を取る\",\"phrase_type\":\"idiom\",\"normalization_type\":\"verb_base\",\"normalization_note\":\"wentを基本形goに変更。\",\"selection_reason\":\"両チームの交代策の対比を短く示し、その後の結果を理解させる表現。\",\"listening_difficulty_reason\":\"方向移動の文字どおりの意味に聞こえるため、「逆の戦術を選ぶ」という文脈義を逃しやすい。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"LOW\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"MEDIUM\",\"spoiler_risk\":\"MEDIUM\",\"portfolio_category\":\"causal_contrast\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"戦術的対比を圧縮した重要表現として選定。\"},{\"rank\":8,\"display_phrase\":\"trade places\",\"source_span\":\"celebration and despair had traded places\",\"source_sentence\":\"In just seven minutes, celebration and despair had traded places.\",\"ja_gloss\":\"立場が入れ替わる\",\"phrase_type\":\"idiom\",\"normalization_type\":\"verb_base\",\"normalization_note\":\"had tradedを基本形tradeに変更。\",\"selection_reason\":\"七分間で両チームの感情と立場が逆転したことを印象的に表す。\",\"listening_difficulty_reason\":\"抽象名詞が主語になる比喩的用法で、文字どおりの場所交換ではない。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"LOW\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"HIGH\",\"spoiler_risk\":\"HIGH\",\"portfolio_category\":\"figurative_emotional\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"試合の感情的な核心を理解するため選定。\"},{\"rank\":9,\"display_phrase\":\"back-to-back titles\",\"source_span\":\"back-to-back titles\",\"source_sentence\":\"Argentina now advance to face Spain, with back-to-back titles on the line.\",\"ja_gloss\":\"大会連覇\",\"phrase_type\":\"noun_phrase\",\"normalization_type\":\"none\",\"normalization_note\":\"本文どおりの定型的な名詞句。\",\"selection_reason\":\"次の決勝でアルゼンチンが目指す歴史的成果を示す。\",\"listening_difficulty_reason\":\"back-to-backを身体や位置の意味で処理すると、「二大会連続」の意味を即座に取れない。\",\"inference_transparency\":\"LOW\",\"topic_exposure_dependency\":\"MEDIUM\",\"comprehension_impact\":\"MEDIUM\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"MEDIUM\",\"portfolio_category\":\"compact_listening_pattern\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"結末後の大会状況を理解するための直接的な選定。\"},{\"rank\":10,\"display_phrase\":\"on the line\",\"source_span\":\"on the line\",\"source_sentence\":\"Argentina now advance to face Spain, with back-to-back titles on the line.\",\"ja_gloss\":\"懸かっている\",\"phrase_type\":\"prepositional_phrase\",\"normalization_type\":\"none\",\"normalization_note\":\"本文どおりの慣用的な前置詞句。\",\"selection_reason\":\"次戦でタイトルが懸かるという重要性を短く表す汎用表現。\",\"listening_difficulty_reason\":\"lineの具体的な意味から、結果が決まる・危機にさらされるという慣用義を推測しにくい。\",\"inference_transparency\":\"LOW\",\"topic_exposure_dependency\":\"LOW\",\"comprehension_impact\":\"MEDIUM\",\"figurative_or_emotional_value\":\"MEDIUM\",\"spoiler_risk\":\"MEDIUM\",\"portfolio_category\":\"compact_listening_pattern\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"試合の懸かり物を示す慣用句として選定。\"}]}",

          "annotations": [],
          "text": "{\"items\":[{\"rank\":1,\"display_phrase\":\"by default\",\"source_span\":\"by default\",\"source_sentence\":\"During those hours, apps covered by the plan would be unavailable by default.\",\"ja_gloss\":\"初期設定では\",\"phrase_type\":\"prepositional_phrase\",\"normalization_type\":\"none\",\"normalization_note\":\"本文と同形。\",\"selection_reason\":\"夜間利用が全面禁止ではなく、初期設定として制限されるという計画の核心を示す。\",\"listening_difficulty_reason\":\"短く弱く発音されやすいうえ、単なる「通常は」ではなく設定上の意味を瞬時に取る必要がある。\",\"inference_transparency\":\"LOW\",\"topic_exposure_dependency\":\"MEDIUM\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"LOW\",\"portfolio_category\":\"causal_contrast\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":2,\"display_phrase\":\"opt out\",\"source_span\":\"opt out\",\"source_sentence\":\"Teenagers aged 16 and 17 would still be able to change the settings and opt out.\",\"ja_gloss\":\"適用を断る、離脱する\",\"phrase_type\":\"phrasal_verb\",\"normalization_type\":\"verb_base\",\"normalization_note\":\"本文も基本形。\",\"selection_reason\":\"利用者が制限を解除できることを表し、強制的な禁止との違いを理解するために不可欠。\",\"listening_difficulty_reason\":\"短い句動詞で、outが弱く聞こえると「設定を変更する」という重要な意味を失いやすい。\",\"inference_transparency\":\"LOW\",\"topic_exposure_dependency\":\"LOW\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"MEDIUM\",\"portfolio_category\":\"general_unknown_word\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":3,\"display_phrase\":\"digital switch-off period\",\"source_span\":\"digital switch-off period\",\"source_sentence\":\"On July 15, the British government announced plans for a digital switch-off period for 16- and 17-year-olds.\",\"ja_gloss\":\"デジタル利用停止時間帯\",\"phrase_type\":\"technical_term\",\"normalization_type\":\"none\",\"normalization_note\":\"本文と同形。\",\"selection_reason\":\"英国の計画そのものを指す中心的な名称で、後続する時間帯や設定の説明の土台になる。\",\"listening_difficulty_reason\":\"switch-offが名詞として使われる複合語で、音声では三語のまとまりを作りにくい。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"HIGH\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"LOW\",\"portfolio_category\":\"domain_expression\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":4,\"display_phrase\":\"speed bump\",\"source_span\":\"speed bump\",\"source_sentence\":\"In other words, the plan puts a small speed bump before the automatic urge to watch “just one more.”\",\"ja_gloss\":\"小さな障害、ひと手間\",\"phrase_type\":\"noun_phrase\",\"normalization_type\":\"none\",\"normalization_note\":\"本文と同形。ここでは比喩的用法。\",\"selection_reason\":\"設定が完全な壁ではなく、無意識の視聴を一度止める仕掛けだという狙いを凝縮している。\",\"listening_difficulty_reason\":\"文字どおりの「減速帯」を思い浮かべると、デジタル行動への比喩へ即座に切り替えにくい。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"LOW\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"HIGH\",\"spoiler_risk\":\"MEDIUM\",\"portfolio_category\":\"figurative_emotional\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":5,\"display_phrase\":\"hands-off approach\",\"source_span\":\"hands-off approach\",\"source_sentence\":\"This midnight speed bump sits somewhere between a strict ban and a complete hands-off approach.\",\"ja_gloss\":\"介入しない方針\",\"phrase_type\":\"collocation\",\"normalization_type\":\"none\",\"normalization_note\":\"本文からcompleteを除き、学習すべき核に縮約。\",\"selection_reason\":\"計画が「全面禁止」と「完全放任」の中間にあるという最終的な位置づけを理解させる。\",\"listening_difficulty_reason\":\"hands offの字義から政策上の「不介入」へ変換する必要があり、ハイフンも音声では手掛かりにならない。\",\"inference_transparency\":\"LOW\",\"topic_exposure_dependency\":\"LOW\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"MEDIUM\",\"spoiler_risk\":\"MEDIUM\",\"portfolio_category\":\"causal_contrast\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":6,\"display_phrase\":\"personalized recommendation feed\",\"source_span\":\"Personalized recommendation feeds\",\"source_sentence\":\"Personalized recommendation feeds would also be turned off.\",\"ja_gloss\":\"個人向けおすすめ欄\",\"phrase_type\":\"technical_term\",\"normalization_type\":\"noun_canonical\",\"normalization_note\":\"本文の複数形feedsを単数の見出し形feedに変更。\",\"selection_reason\":\"夜間に停止される主要機能の一つで、延々とスクロールする仕組みの説明につながる。\",\"listening_difficulty_reason\":\"長い名詞連続で語の境界を取りにくく、feedのSNS上の専門的意味も題材経験に左右される。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"HIGH\",\"comprehension_impact\":\"MEDIUM\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"LOW\",\"portfolio_category\":\"domain_expression\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":7,\"display_phrase\":\"take effect\",\"source_span\":\"take effect\",\"source_sentence\":\"The new measures are expected to take effect in the spring of 2027.\",\"ja_gloss\":\"施行される、効力を持つ\",\"phrase_type\":\"collocation\",\"normalization_type\":\"verb_base\",\"normalization_note\":\"本文もtoに続く基本形。\",\"selection_reason\":\"計画の実施時期を伝える重要な政策コロケーション。\",\"listening_difficulty_reason\":\"takeの一般的な意味から推測しにくく、be expected toの後で素早く一まとまりとして処理する必要がある。\",\"inference_transparency\":\"LOW\",\"topic_exposure_dependency\":\"MEDIUM\",\"comprehension_impact\":\"MEDIUM\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"MEDIUM\",\"portfolio_category\":\"general_unknown_word\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":8,\"display_phrase\":\"seven in ten\",\"source_span\":\"seven in ten\",\"source_sentence\":\"In a separate experiment by Ofcom, around seven in ten children kept a safety setting when it was selected by default.\",\"ja_gloss\":\"10人中7人\",\"phrase_type\":\"collocation\",\"normalization_type\":\"none\",\"normalization_note\":\"本文と同形。\",\"selection_reason\":\"初期設定の効果を裏づける研究結果の主要な数値を表す。\",\"listening_difficulty_reason\":\"数字と短い機能語が連続し、70%という割合へ即座に変換できないと比較結果を追いにくい。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"LOW\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"LOW\",\"spoiler_risk\":\"HIGH\",\"portfolio_category\":\"compact_listening_pattern\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":9,\"display_phrase\":\"leave it untouched\",\"source_span\":\"leave it untouched\",\"source_sentence\":\"It will depend on how many more nights they leave it untouched—and simply go to sleep.\",\"ja_gloss\":\"それを変更せずにおく\",\"phrase_type\":\"collocation\",\"normalization_type\":\"verb_base\",\"normalization_note\":\"本文の動詞形がすでに基本形と同形。目的語itを含む最小パターンとして保持。\",\"selection_reason\":\"成功の基準が、設定を解除せずそのままにする夜の増加だという結論を表す。\",\"listening_difficulty_reason\":\"itの指示対象を設定だと補いながら、untouchedを「触っていない」ではなく「変更していない」と解釈する必要がある。\",\"inference_transparency\":\"MEDIUM\",\"topic_exposure_dependency\":\"LOW\",\"comprehension_impact\":\"HIGH\",\"figurative_or_emotional_value\":\"MEDIUM\",\"spoiler_risk\":\"HIGH\",\"portfolio_category\":\"compact_listening_pattern\",\"portfolio_substitution\":false,\"portfolio_substitution_reason\":\"\"},{\"rank\":10,\"display_phrase\":\"endless current of scrolling\",\"source_span\":\"endless current of scrolling\",\"source_sentence\":\"“What the UK is trying to switch off is not the glow of the smartphone, but the endless current of scrolling that carries teenagers right up to bedtime.”\",\"ja_gloss\":\"延々と続くスクロールの流れ\",\"phrase_type\":\"noun_phrase\",\"normalization_type\":\"none\",\"normalization_note\":\"本文と同形。currentは比喩的に「流れ」を表す。\",\"selection_reason\":\"スマートフォン自体ではなく、止まらない利用の流れを抑えるという記事の感情的な要点を表す。\",\"listening_difficulty_reason\":\"currentを「電流」や「現在の」と処理しやすく、scrollingを人を運ぶ流れに見立てた比喩も即時には捉えにくい。\",\"inference_transparency\":\"LOW\",\"topic_exposure_dependency\":\"MEDIUM\",\"comprehension_impact\":\"MEDIUM\",\"figurative_or_emotional_value\":\"HIGH\",\"spoiler_risk\":\"MEDIUM\",\"portfolio_category\":\"figurative_emotional\",\"portfolio_substitution\":true,\"portfolio_substitution_reason\":\"より透明な事実表現よりも、記事の印象的な比喩と感情的要点を初回音声で捉える支援を優先した。\"}]}",
